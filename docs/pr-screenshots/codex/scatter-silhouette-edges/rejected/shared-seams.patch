+"""Execute the shared scatter edge-classification helpers from GLSL and Metal.
+
+The host adapter checks projected facing and coplanar lattice neighbors; native
+raster coverage remains the render harness's responsibility.
+"""
+
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from test_render_per_axis_caster_position import COMPILER, ROOT, cpp, functions
+
+PREAMBLE = r"""
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <initializer_list>
+using std::cos;
+using std::sin;
+constexpr int kFaceXNeg=0,kFaceXPos=1,kFaceYNeg=2,kFaceYPos=3,kFaceZNeg=4,kFaceZPos=5;
+struct vec3 {
+    float x,y,z;
+    vec3(float a,float b,float c):x(a),y(b),z(c){}
+};
+struct ivec4 {
+    int values[4];
+    ivec4(int a,int b,int c,int d):values{a,b,c,d}{}
+    int operator[](int i)const{return values[i];}
+};
+"""
+
+
+CHECKS = r"""
+struct Screen {double x,y;};
+Screen project(double x,double y,double z,double yaw) {
+    const double c=std::cos(yaw),s=std::sin(yaw);
+    const double viewX=x*c+y*s,viewY=-x*s+y*c;
+    return {-viewX+viewY,-viewX-viewY+2.0*z};
+}
+double projectedArea(int axis,double yaw) {
+    const Screen x=project(1,0,0,yaw),y=project(0,1,0,yaw),z=project(0,0,1,yaw);
+    const Screen u=axis==0?y:x,v=axis==2?y:z;
+    return u.x*v.y-u.y*v.x;
+}
+int expectedPolarity(int axis,ivec4 triplet,float yaw) {
+    for(int slot=0;slot<3;++slot) {
+        const int face=triplet[slot];
+        if(face/2!=axis)continue;
+        const int polarity=(face&1)?1:-1;
+        // The Y basis (X,Z) reverses orientation relative to X/Z bases.
+        const double outwardArea=projectedArea(axis,double(yaw))*
+            double(polarity*(axis==1?-1:1));
+        return outwardArea < -2e-6 ? polarity : 0;
+    }
+    return 0;
+}
+int main() {
+    const float pi=float(std::acos(-1.0));
+    const std::array<float,17> yaws={
+        0.f,pi/4.f,pi/4.f-1e-7f,pi/4.f+1e-7f,pi/4.f+1e-4f,
+        pi/2.f,3.f*pi/4.f,3.f*pi/4.f-1e-7f,3.f*pi/4.f+1e-7f,
+        3.f*pi/4.f+1e-4f,pi,5.f*pi/4.f,3.f*pi/2.f,7.f*pi/4.f,
+        .13f,1.94f,5.61f
+    };
+    int cases=0,front=0,back=0,edgeOn=0;
+    std::array<int,3> axes={0,1,2};
+    do {
+        for(int signs=0;signs<8;++signs) {
+            const ivec4 triplet(2*axes[0]+((signs>>axes[0])&1),
+                                2*axes[1]+((signs>>axes[1])&1),
+                                2*axes[2]+((signs>>axes[2])&1),5);
+            for(float yaw:yaws)for(int axis=0;axis<3;++axis) {
+                const int expected=expectedPolarity(axis,triplet,yaw);
+                const int actual=scatterVisiblePolarityForAxis(axis,triplet,yaw);
+                const int face=2*axis+((signs>>axis)&1);
+                const double area=projectedArea(axis,double(yaw));
+                if(std::abs(area)<2e-6)++edgeOn;
+                else if(expected)++front;
+                else ++back;
+                if(actual!=expected) {
+                    std::fprintf(stderr,"polarity mismatch axis=%d face=%d yaw=%.9g "
+                        "area=%.9g actual=%d expected=%d\n",
+                        axis,face,yaw,area,actual,expected);
+                    return 1;
+                }
+                ++cases;
+            }
+        }
+    } while(std::next_permutation(axes.begin(),axes.end()));
+    // The fourth lane is padding, never a face in the visible triplet.
+    const ivec4 absentTriplets[]={
+        ivec4(2,3,4,0),ivec4(0,1,4,2),ivec4(0,1,2,4)
+    };
+    for(int axis=0;axis<3;++axis) {
+        if(scatterVisiblePolarityForAxis(axis,absentTriplets[axis],.13f)!=0) {
+            std::fprintf(stderr,"absent axis accepted: %d\n",axis);
+            return 2;
+        }
+    }
+    if(cases!=2448 || !front || !back || !edgeOn)return 3;
+    std::printf("polarity cases=%d front=%d back=%d edge-on=%d\n",
+        cases,front,back,edgeOn);
+}
+"""
+
+
+COPLANAR_CHECKS = r"""
+int pack(int depth,int slot,int flip,int u,int v,int w) {
+    return depth*32768+w*2048+flip*1024+u*64+v*4+slot;
+}
+bool check(int owner,int neighbor,int step,bool expected,const char* label) {
+    const bool actual=perAxisCoplanarNeighbor(owner,neighbor,step);
+    if(actual!=expected) {
+        std::fprintf(stderr,"coplanar mismatch %s owner=%d neighbor=%d step=%d "
+            "actual=%d expected=%d\n",label,owner,neighbor,step,actual,expected);
+        return false;
+    }
+    return true;
+}
+int main() {
+    const int positions[][3]={{0,0,0},{-17,4,2},{7,-31,5},{9,8,12},{-5,-9,-3}};
+    int cases=0;
+    for(const auto& p:positions)for(int axis=0;axis<3;++axis)
+    for(int direction=0;direction<2;++direction)for(int step:{-1,1})
+    for(int slot=0;slot<4;++slot)for(int flip=0;flip<2;++flip)
+    for(int u:{0,8,15})for(int v:{0,8,15})for(int w:{0,8,15}) {
+        const int depth=p[0]+p[1]+p[2];
+        int adjacent[3]={p[0],p[1],p[2]};
+        const int inPlaneAxis=direction==0?(axis==0?1:0):(axis==2?1:2);
+        adjacent[inPlaneAxis]+=step;
+        const int adjacentDepth=adjacent[0]+adjacent[1]+adjacent[2];
+        if(adjacentDepth!=depth+step)return 2;
+        const int owner=pack(depth,slot,flip,u,v,w);
+        const int neighbor=pack(adjacentDepth,slot,flip,u,v,w);
+        if(!check(owner,neighbor,step,true,"world lattice") ||
+           !check(owner,neighbor,-step,false,"opposite step") ||
+           !check(owner,pack(adjacentDepth+2,slot,flip,u,v,w),step,false,"depth") ||
+           !check(owner,pack(adjacentDepth,(slot+1)%4,flip,u,v,w),step,false,"slot") ||
+           !check(owner,pack(adjacentDepth,slot,flip^1,u,v,w),step,false,"flip") ||
+           !check(owner,pack(adjacentDepth,slot,flip,(u+1)%16,v,w),step,false,"u") ||
+           !check(owner,pack(adjacentDepth,slot,flip,u,(v+1)%16,w),step,false,"v") ||
+           !check(owner,pack(adjacentDepth,slot,flip,u,v,(w+1)%16),step,false,"w"))
+            return 1;
+        ++cases;
+    }
+    if(cases!=12960)return 3;
+    std::printf("coplanar lattice cases=%d\n",cases);
+}
+"""
+
+
+ROUTE_PREAMBLE = r"""
+struct Pixel {
+    int x,y;
+    Pixel(int a=0,int b=0):x(a),y(b){}
+    Pixel operator+(Pixel other)const{return {x+other.x,y+other.y};}
+    Pixel operator-(Pixel other)const{return {x-other.x,y-other.y};}
+};
+struct Grid3 {
+    int x,y,z;
+    explicit Grid3(vec3 p):x(int(p.x)),y(int(p.y)),z(int(p.z)){}
+};
+struct Edges {
+    float value[4];
+    explicit Edges(float a=0):value{a,a,a,a}{}
+    Edges(float a,float b,float c,float d):value{a,b,c,d}{}
+    float operator[](int i)const{return value[i];}
+};
+struct FrameData {ivec4 visibleFaceIds;float visualYaw;int overflowMode;};
+struct VertexOut {Edges edgeInterior;};
+int neighborQueries=0;
+Pixel pos3DtoPos2DIso(Grid3 p){return {-p.x+p.y,-p.x-p.y+2*p.z};}
+float coplanarNeighbor(Pixel,Pixel,int,int){++neighborQueries;return 0.0f;}
+float coplanarNeighbor(int,int,Pixel,Pixel,int,int){++neighborQueries;return 0.0f;}
+"""
+
+
+ROUTE_CHECKS = r"""
+struct Screen {double x,y;};
+Screen project(double x,double y,double z,double yaw) {
+    const double c=std::cos(yaw),s=std::sin(yaw);
+    const double viewX=x*c+y*s,viewY=-x*s+y*c;
+    return {-viewX+viewY,-viewX-viewY+2.0*z};
+}
+double projectedArea(int axis,double yaw) {
+    const Screen x=project(1,0,0,yaw),y=project(0,1,0,yaw),z=project(0,0,1,yaw);
+    const Screen u=axis==0?y:x,v=axis==2?y:z;
+    return u.x*v.y-u.y*v.x;
+}
+int expectedPolarity(int axis,ivec4 triplet,float yaw) {
+    for(int slot=0;slot<3;++slot) {
+        const int face=triplet[slot];
+        if(face/2!=axis)continue;
+        const int polarity=(face&1)?1:-1;
+        const double outwardArea=projectedArea(axis,double(yaw))*
+            double(polarity*(axis==1?-1:1));
+        return outwardArea < -2e-6 ? polarity : 0;
+    }
+    return 0;
+}
+bool checkRoute(int faceAxis,ivec4 triplet,float yaw,int overflowMode) {
+    const vec3 basis[3]={vec3(1,0,0),vec3(0,1,0),vec3(0,0,1)};
+    const int uAxis=faceAxis==0?1:0;
+    const int vAxis=faceAxis==2?1:2;
+    neighborQueries=0;
+    const Edges actual=routeEdges(overflowMode,basis[uAxis],basis[vAxis],triplet,yaw);
+    const int u=expectedPolarity(uAxis,triplet,yaw);
+    const int v=expectedPolarity(vAxis,triplet,yaw);
+    const float expected[4]={float(u<0),float(u>0),float(v<0),float(v>0)};
+    const int expectedQueries=overflowMode?0:4-int(u!=0)-int(v!=0);
+    for(int edge=0;edge<4;++edge)if(actual[edge]!=expected[edge]) {
+        std::fprintf(stderr,"overflow route mismatch axis=%d yaw=%.9g mode=%d "
+            "edge=%d actual=%.0f expected=%.0f\n",faceAxis,yaw,overflowMode,
+            edge,actual[edge],expected[edge]);
+        return false;
+    }
+    if(neighborQueries!=expectedQueries) {
+        std::fprintf(stderr,"overflow route queried foreign axis: mode=%d "
+            "actual=%d expected=%d\n",overflowMode,neighborQueries,expectedQueries);
+        return false;
+    }
+    return true;
+}
+int main() {
+    const float pi=float(std::acos(-1.0));
+    const ivec4 qTriplet(2,1,4,0); // Y-, X+, Z- at the captured 60-degree yaw
+    if(!checkRoute(2,qTriplet,pi/3.f,1) || !checkRoute(0,qTriplet,pi/3.f,1))return 1;
+    const Edges qZ=routeEdges(1,vec3(1,0,0),vec3(0,1,0),qTriplet,pi/3.f);
+    const Edges qX=routeEdges(1,vec3(0,1,0),vec3(0,0,1),qTriplet,pi/3.f);
+    if(qZ[1]!=1.0f || qX[2]!=1.0f) {
+        std::fprintf(stderr,"overflow shared convex seam missing at 60 degrees\n");
+        return 2;
+    }
+    const std::array<float,20> yaws={
+        0.f,pi/4.f-1e-4f,pi/4.f,pi/4.f+1e-4f,
+        pi/2.f,3*pi/4.f-1e-4f,3*pi/4.f,3*pi/4.f+1e-4f,
+        pi,5*pi/4.f-1e-4f,5*pi/4.f,5*pi/4.f+1e-4f,
+        3*pi/2.f,7*pi/4.f-1e-4f,7*pi/4.f,7*pi/4.f+1e-4f,
+        pi/3.f,.13f,1.94f,5.61f
+    };
+    int cases=0;
+    std::array<int,3> axes={0,1,2};
+    do {
+        for(int signs=0;signs<8;++signs) {
+            const ivec4 triplet(2*axes[0]+((signs>>axes[0])&1),
+                                2*axes[1]+((signs>>axes[1])&1),
+                                2*axes[2]+((signs>>axes[2])&1),5);
+            for(float yaw:yaws)for(int axis=0;axis<3;++axis)
+            for(int mode=0;mode<2;++mode) {
+                if(!checkRoute(axis,triplet,yaw,mode))return 3;
+                ++cases;
+            }
+        }
+    } while(std::next_permutation(axes.begin(),axes.end()));
+    if(cases!=5760)return 4;
+    std::printf("scatter edge route cases=%d\n",cases);
+}
+"""
+
+
+def helper_source(suffix, directory, mutation=None):
+    common = (ROOT / "engine/render/src/shaders" / directory /
+              f"ir_iso_common.{suffix}").read_text()
+    names = ("faceOutwardNormal6", "yawedIsoDistance", "scatterVisiblePolarityForAxis")
+    source = cpp("\n".join(functions(common, name) for name in names))
+    source = re.sub(r"\bint4\b", "ivec4", source)
+    if mutation:
+        guard = "facing < -1e-6"
+        if source.count(guard) != 1:
+            raise ValueError("missing projected-facing guard")
+        source = source.replace(guard, mutation)
+    return source
+
+
+def coplanar_source(suffix, directory, mutation=None):
+    common = (ROOT / "engine/render/src/shaders" / directory /
+              f"ir_iso_common.{suffix}").read_text()
+    names = ("decodeDepthPerAxis", "decodeSlot", "decodeFlipPerAxis",
+             "decodeUFrac4PerAxis", "decodeVFrac4PerAxis", "decodeWFrac4PerAxis",
+             "perAxisCoplanarNeighbor")
+    source = cpp("\n".join(functions(common, name) for name in names))
+    if mutation:
+        comparison = (f"decode{mutation}(neighbor) == "
+                      f"decode{mutation}(owner)" +
+                      (" + depthStep" if mutation == "DepthPerAxis" else ""))
+        if source.count(comparison) != 1:
+            raise ValueError(f"missing {mutation} comparison")
+        source = source.replace(comparison, "true")
+    return source
+
+
+def route_source(suffix, directory, mutation=False):
+    shader_name = "v_peraxis_scatter.glsl" if suffix == "glsl" else "peraxis_scatter.metal"
+    shader = (ROOT / "engine/render/src/shaders" / directory / shader_name).read_text()
+    start = shader.index("    const int euAxis =")
+    end_marker = re.search(r"^    const (?:vec2|float2) cornerSel =", shader[start:], re.MULTILINE)
+    if end_marker is None:
+        raise ValueError("missing post-classification face corner")
+    end = start + end_marker.start()
+    block = cpp(shader[start:end])
+    for shader_type, host_type in (("ivec2", "Pixel"), ("ivec3", "Grid3"),
+                                   ("vec4", "Edges")):
+        block = re.sub(r"\b" + shader_type + r"\b", host_type, block)
+    block = block.replace("out.edgeInterior", "edges").replace("vEdgeInterior", "edges")
+    if suffix == "metal":
+        block = block.replace("frameData.visibleFaceIds", "triplet")
+        block = block.replace("frameData.visualYaw", "yaw")
+        block = block.replace("frameData.overflowMode", "overflowMode")
+    else:
+        block = block.replace("visibleFaceIds", "triplet")
+        block = block.replace("visualYaw", "yaw")
+    if mutation:
+        block += "    if (overflowMode != 0) edges = Edges(0.0f);\n"
+    return ("Edges routeEdges(int overflowMode,vec3 eu,vec3 ev,ivec4 triplet,float yaw) {\n"
+            "    Edges edges; Pixel ij(0,0),canvasSize(16,16); int rawDist=0;\n"
+            "    int triangleColors=0,triangleDistances=0;\n" + block +
+            "    return edges;\n}\n")
+
+
+@unittest.skipUnless(COMPILER, "scatter edge polarity requires a C++ compiler")
+class ScatterEdgePolarityTest(unittest.TestCase):
+    def test_overflow_and_cell_edge_routing_for_both_shader_backends(self):
+        for suffix, directory in (("glsl", ""), ("metal", "metal/")):
+            for mutation in (False, True):
+                with self.subTest(backend=suffix, old_overflow_boundary=mutation):
+                    with tempfile.TemporaryDirectory() as temporary:
+                        path = Path(temporary)
+                        source = path / "edge_routes.cpp"
+                        executable = path / "edge_routes"
+                        source.write_text(PREAMBLE + ROUTE_PREAMBLE + helper_source(
+                            suffix, directory) + route_source(suffix, directory, mutation) +
+                            ROUTE_CHECKS)
+                        build = subprocess.run(
+                            [COMPILER, "-std=c++17", str(source), "-o", str(executable)],
+                            capture_output=True, text=True)
+                        self.assertEqual(build.returncode, 0, build.stderr)
+                        result = subprocess.run([str(executable)], capture_output=True,
+                                                text=True)
+                        if mutation:
+                            self.assertNotEqual(result.returncode, 0)
+                            self.assertIn("overflow route mismatch", result.stderr)
+                        else:
+                            self.assertEqual(result.returncode, 0, result.stderr)
+                            self.assertIn("scatter edge route cases=5760", result.stdout)
+
+    def test_projected_facing_for_both_shader_backends(self):
+        for suffix, directory in (("glsl", ""), ("metal", "metal/")):
