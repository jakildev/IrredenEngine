+                        else:
+                            self.assertEqual(result.returncode, 0, result.stderr)
+                            self.assertIn("polarity cases=2448", result.stdout)
+
+    def test_coplanar_neighbors_for_both_shader_backends(self):
+        fields = (None, "DepthPerAxis", "Slot", "FlipPerAxis", "UFrac4PerAxis",
+                  "VFrac4PerAxis", "WFrac4PerAxis")
