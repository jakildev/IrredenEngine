  "patch": "diff --git a/engine/render/src/shaders/c_compute_sun_shadow_body.glsl b/engine/render/src/shaders/c_compute_sun_shadow_body.glsl\nindex 3e4837f30..0368b0302 100644\n--- a/engine/render/src/shaders/c_compute_sun_shadow_body.glsl\n+++ b/engine/render/src/shaders/c_compute_sun_shadow_body.glsl\n@@ -78,6 +78,7 @@ layout(std430, binding = 26) readonly buffer PerAxisCellIndirect {\n \n #if IR_SHAPE_RECEIVER\n #include \"ir_selected_shape_receiver.glsl\"\n+#include \"ir_shape_shadow_receiver.glsl\"\n \n #endif\n \n@@ -188,6 +189,16 @@ void main() {\n     // correction applies only to reconstructed sample position so a corrected\n     // receiver keeps the cascade ownership assigned by its stored pixel.\n     // The cascade PCF lookup is shared with the detached world-receive path.\n-    float factor = shadowsEnabled == 0 ? 1.0 : worldSunShadowFactor(pos3D, normal, float(rawDepth));\n+    float factor = 1.0;\n+    if (shadowsEnabled != 0) {\n+#if IR_SHAPE_RECEIVER\n+        vec3 shadowPosition;\n+        if (selectedShapeSphereShadowReceiver(pixel, size.x, shadowPosition))\n+            factor = worldSurfaceSunShadowFactor(shadowPosition, normal,\n+                float(rawDepth), sunCasterViewToWorld);\n+        else\n+#endif\n+            factor = worldSunShadowFactor(pos3D, normal, float(rawDepth));\n+    }\n     imageStore(canvasSunShadow, pixel, vec4(factor, 0.0, 0.0, receiverFace));\n }\ndiff --git a/engine/render/src/shaders/ir_shape_receiver.glsl b/engine/render/src/shaders/ir_shape_receiver.glsl\nindex 6f49429cb..6989aff75 100644\n--- a/engine/render/src/shaders/ir_shape_receiver.glsl\n+++ b/engine/render/src/shaders/ir_shape_receiver.glsl\n@@ -19,6 +19,15 @@ vec3 shapeRenderedCenter(vec3 worldPosition, ShapeProjectionData projection) {\n     return vec3(yaw.x * view.x - yaw.y * view.y, yaw.y * view.x + yaw.x * view.y, view.z);\n }\n \n+ivec2 shapeRenderedOriginIso(vec3 center, ShapeProjectionData projection, int density) {\n+    vec2 yaw = shapeYawCosSin(projection);\n+    return projection.smoothYawEnabled != 0\n+        ? roundHalfUp(pos3DtoPos2DIsoYawed(center * float(density), projection.visualYaw))\n+        : pos3DtoPos2DIso(roundHalfUp(vec3(yaw.x * center.x + yaw.y * center.y,\n+                                             -yaw.y * center.x + yaw.x * center.y,\n+                                             center.z)) * density);\n+}\n+\n // Canvas cell receivers select their sun cascade by the canvas depth: the\n // view-frame x+y+z at the canvas's subdivided resolution. A finite fragment that\n // stands in for a canvas cell must select the same cascade as its neighbours.\n@@ -46,11 +55,7 @@ bool shapeBoxReceiver(ShapeDescriptor shape, ShapeProjectionData projection,\n     vec3 center = shapeRenderedCenter(shape.worldPosition.xyz, projection);\n     // Cardinal yaw: center is a lattice cell rotated by an exact cos/sin pair,\n     // so rotating it back recovers the integer view cell exactly.\n-    ivec2 originIso = smoothYaw\n-        ? roundHalfUp(pos3DtoPos2DIsoYawed(center * float(density), projection.visualYaw))\n-        : pos3DtoPos2DIso(roundHalfUp(vec3(yaw.x * center.x + yaw.y * center.y,\n-                                             -yaw.y * center.x + yaw.x * center.y,\n-                                             center.z)) * density);\n+    ivec2 originIso = shapeRenderedOriginIso(center, projection, density);\n     ivec2 frameOffset = trixelFrameOffset(projection.trixelCanvasOffsetZ1,\n         projection.frameCanvasOffset, projection.voxelRenderOptions);\n     vec2 relativeIso = canvasPixel - vec2(frameOffset + originIso);\ndiff --git a/engine/render/src/shaders/metal/c_compute_sun_shadow_body.metal b/engine/render/src/shaders/metal/c_compute_sun_shadow_body.metal\nindex f56f0e580..3ee326bb2 100644\n--- a/engine/render/src/shaders/metal/c_compute_sun_shadow_body.metal\n+++ b/engine/render/src/shaders/metal/c_compute_sun_shadow_body.metal\n@@ -13,6 +13,9 @@\n // world-receive path.\n #include \"ir_sun_shadow_sample.metal\"\n #include \"ir_per_axis_shadow.metal\"\n+#if IR_SHAPE_RECEIVER\n+#include \"ir_shape_shadow_receiver.metal\"\n+#endif\n \n // Mirrors shaders/c_compute_sun_shadow.glsl.\n \n@@ -166,6 +169,18 @@ kernel void IR_SUN_SHADOW_KERNEL_NAME(\n     // correction applies only to reconstructed sample position so a corrected\n     // receiver keeps the cascade ownership assigned by its stored pixel.\n     // The cascade PCF lookup is shared with the detached world-receive path.\n-    float factor = sunFrameData.shadowsEnabled == 0 ? 1.0 : worldSunShadowFactor(pos3D, normal, float(rawDepth), sunFrameData, sunDepthBuf);\n+    float factor = 1.0;\n+    if (sunFrameData.shadowsEnabled != 0) {\n+#if IR_SHAPE_RECEIVER\n+        float3 shadowPosition;\n+        if (selectedShapeSphereShadowReceiver(pixel, size.x,\n+                receiverFrame, receiverShapes, receiverOwners, receiverTiles,\n+                shadowPosition))\n+            factor = worldSurfaceSunShadowFactor(shadowPosition, normal,\n+                float(rawDepth), sunFrameData.sunCasterViewToWorld, sunFrameData, sunDepthBuf);\n+        else\n+#endif\n+            factor = worldSunShadowFactor(pos3D, normal, float(rawDepth), sunFrameData, sunDepthBuf);\n+    }\n     canvasSunShadow.write(float4(factor, 0.0, 0.0, receiverFace), uint2(pixel));\n }\ndiff --git a/engine/render/src/shaders/metal/ir_shape_receiver.metal b/engine/render/src/shaders/metal/ir_shape_receiver.metal\nindex 790b2a6b6..bef1ab96e 100644\n--- a/engine/render/src/shaders/metal/ir_shape_receiver.metal\n+++ b/engine/render/src/shaders/metal/ir_shape_receiver.metal\n@@ -19,6 +19,15 @@ inline float3 shapeRenderedCenter(float3 worldPosition, ShapeProjectionData proj\n     return float3(yaw.x * view.x - yaw.y * view.y, yaw.y * view.x + yaw.x * view.y, view.z);\n }\n \n+inline int2 shapeRenderedOriginIso(float3 center, ShapeProjectionData projection, int density) {\n+    float2 yaw = shapeYawCosSin(projection);\n+    return projection.smoothYawEnabled != 0\n+        ? roundHalfUp(pos3DtoPos2DIsoYawed(center * float(density), projection.visualYaw))\n+        : pos3DtoPos2DIso(roundHalfUp(float3(yaw.x * center.x + yaw.y * center.y,\n+                                             -yaw.y * center.x + yaw.x * center.y,\n+                                             center.z)) * density);\n+}\n+\n // Canvas cell receivers select their sun cascade by the canvas depth: the\n // view-frame x+y+z at the canvas's subdivided resolution. A finite fragment that\n // stands in for a canvas cell must select the same cascade as its neighbours.\n@@ -46,11 +55,7 @@ inline bool shapeBoxReceiver(ShapeDescriptor shape, ShapeProjectionData projecti\n     float3 center = shapeRenderedCenter(shape.worldPosition.xyz, projection);\n     // Cardinal yaw: center is a lattice cell rotated by an exact cos/sin pair,\n     // so rotating it back recovers the integer view cell exactly.\n-    int2 originIso = smoothYaw\n-        ? roundHalfUp(pos3DtoPos2DIsoYawed(center * float(density), projection.visualYaw))\n-        : pos3DtoPos2DIso(roundHalfUp(float3(yaw.x * center.x + yaw.y * center.y,\n-                                             -yaw.y * center.x + yaw.x * center.y,\n-                                             center.z)) * density);\n+    int2 originIso = shapeRenderedOriginIso(center, projection, density);\n     int2 frameOffset = trixelFrameOffset(projection.trixelCanvasOffsetZ1,\n         projection.frameCanvasOffset, projection.voxelRenderOptions);\n     float2 relativeIso = canvasPixel - float2(frameOffset + originIso);\n",
