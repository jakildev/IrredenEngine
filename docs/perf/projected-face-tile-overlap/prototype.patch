diff --git a/scripts/tests/test_render_projected_face_tiles.py b/scripts/tests/test_render_projected_face_tiles.py
new file mode 100644
index 000000000..1c68206fd
--- /dev/null
+++ b/scripts/tests/test_render_projected_face_tiles.py
@@ -0,0 +1,110 @@
+"""Check conservative projected-face tile rejection against polygon clipping."""
+
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from test_render_source_face_index import COMPILER, PREAMBLE, ROOT
+
+CASES = r"""
+struct Point {double x,y;};
+bool oracle(vec2 c,vec2 u,vec2 v,vec2 low,vec2 high){
+ std::vector<Point> polygon={{c.x,c.y},{double(c.x)+u.x,double(c.y)+u.y},
+  {double(c.x)+u.x+v.x,double(c.y)+u.y+v.y},{double(c.x)+v.x,double(c.y)+v.y}};
+ for(int side=0;side<4;++side){
+  std::vector<Point> result;
+  if(polygon.empty())return false;
+  const bool x=side<2,lower=side%2==0;
+  const double bound=x?(lower?low.x:high.x):(lower?low.y:high.y);
+  auto distance=[&](Point p){return ((x?p.x:p.y)-bound)*(lower?1:-1);};
+  Point previous=polygon.back();double pd=distance(previous);
+  for(Point current:polygon){
+   double cd=distance(current);
+   if((pd<0)!=(cd<0)){
+    double t=pd/(pd-cd);
+    result.push_back({previous.x+t*(current.x-previous.x),
+                      previous.y+t*(current.y-previous.y)});
+   }
+   if(cd>=0)result.push_back(current);
+   previous=current;pd=cd;
+  }
+  polygon=result;
+ }
+ return !polygon.empty();
+}
+int main(){
+ if(!projectedFaceTileMayOverlap({0,0},{4,4},{-4,4},{1,1},{2,2}))return 1;
+ if(projectedFaceTileMayOverlap({0,0},{4,4},{-4,4},{3,0},{4,1}))return 2;
+ if(projectedFaceTileMayOverlap({0,0},{4,4},{-4,4},{-4,0},{-3,1}))return 3;
+ unsigned long candidates=0,hits=0,rejected=0,extra=0;
+ for(int grid=0;grid<2;++grid)
+ for(float normalScale:{1.f,.0001f})
+ for(float offset:{-1000000.f,0.f,1000000.f})
+ for(int pose=0;pose<16;++pose)
+ for(float width:{1.f,8.f,64.f,256.f})
+ for(float height:{1.f,16.f,128.f})
+ for(float sign:{-1.f,1.f}){
+  const double angle=pose*3.141592653589793/8;
+  vec2 c{offset+7.25f,offset-3.5f};
+  vec2 u{float(std::cos(angle)*width),float(std::sin(angle)*width)};
+  vec2 v{float((-std::sin(angle)*normalScale+.3*std::cos(angle))*height*sign),
+         float((std::cos(angle)*normalScale+.3*std::sin(angle))*height*sign)};
+  const vec2 low=min(min(c,c+u),min(c+v,c+u+v));
+  const vec2 high=max(max(c,c+u),max(c+v,c+u+v));
+  const float cell=grid?7.25f:8.f;
+  const vec2 origin=grid?vec2{-.375f,.625f}:vec2{0,0};
+  for(int y=int(std::floor((low.y-origin.y)/cell));
+      y<=int(std::floor((high.y-origin.y)/cell));++y)
+  for(int x=int(std::floor((low.x-origin.x)/cell));
+      x<=int(std::floor((high.x-origin.x)/cell));++x){
+   const vec2 tileLow{origin.x+float(x)*cell,origin.y+float(y)*cell};
+   const vec2 tileHigh=tileLow+vec2{cell,cell};
+   const bool expected=oracle(c,u,v,tileLow,tileHigh);
+   const bool actual=projectedFaceTileMayOverlap(c,u,v,tileLow,tileHigh);
+   if(expected&&!actual){std::cerr<<"lost overlap at "<<offset<<" pose "<<pose<<"\n";return 4;}
+   ++candidates;hits+=expected;rejected+=!actual;extra+=actual&&!expected;
+  }
+ }
+ if(rejected<1000)return 5;
+ std::cout<<"candidates="<<candidates<<" intersections="<<hits
+          <<" rejected="<<rejected<<" conservative_extra="<<extra<<"\n";
+}
+"""
+
+
+@unittest.skipUnless(COMPILER, "projected tile controls require a C++ compiler")
+class ProjectedFaceTileTest(unittest.TestCase):
+    def test_production_and_mutations(self):
+        for suffix, folder in (("glsl", ""), ("metal", "metal/")):
+            source = (ROOT / f"engine/render/src/shaders/{folder}"
+                      f"ir_projected_face.{suffix}").read_text().replace("float2", "vec2")
+            variants = {
+                "production": source,
+                "missing_axis": source.replace("axis < 2", "axis < 1"),
+                "shrunken_face": source.replace("edgeV)) * 0.5", "edgeV)) * 0.25"),
+                "open_edges": source.replace("radius + roundoff", "radius")
+                .replace("> radius", ">= radius"),
+                "no_rejection": source.replace("return false", "return true"),
+            }
+            for name, shader in variants.items():
+                with (self.subTest(backend=suffix, mutation=name),
+                      tempfile.TemporaryDirectory() as tmp):
+                    if name != "production":
+                        self.assertNotEqual(shader, source)
+                    path = Path(tmp)
+                    (path / "tiles.cpp").write_text(PREAMBLE + shader + CASES)
+                    build = subprocess.run([COMPILER, "-std=c++17", "-O2",
+                                            str(path / "tiles.cpp"), "-o", str(path / "tiles")],
+                                           capture_output=True, text=True)
+                    self.assertEqual(build.returncode, 0, build.stderr)
+                    run = subprocess.run([str(path / "tiles")], capture_output=True, text=True)
+                    if name == "production":
+                        self.assertEqual(run.returncode, 0, run.stderr)
+                        print(suffix, run.stdout.strip())
+                    else:
+                        self.assertNotEqual(run.returncode, 0, "mutation escaped")
+
+
+if __name__ == "__main__":
+    unittest.main()
