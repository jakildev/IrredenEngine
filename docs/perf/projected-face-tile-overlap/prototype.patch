@@ -12,4 +12,23 @@ vec2 projectedFaceCoordinates(vec2 delta, vec2 edgeU, vec2 edgeV, float determin
                 (edgeU.x * delta.y - edgeU.y * delta.x) / determinant);
 }

+// The tile already overlaps the face AABB. Strict separation keeps shared edges;
+// the roundoff allowance makes uncertain floating-point cases conservative.
+bool projectedFaceTileMayOverlap(vec2 corner, vec2 edgeU, vec2 edgeV, vec2 tileLow, vec2 tileHigh) {
+    const vec2 tileCenter = (tileLow + tileHigh) * 0.5;
+    const vec2 tileHalf = (tileHigh - tileLow) * 0.5;
+    const vec2 faceCenter = corner + (edgeU + edgeV) * 0.5;
+    const vec2 delta = tileCenter - faceCenter;
+    const float faceRadius = abs(projectedFaceDeterminant(edgeU, edgeV)) * 0.5;
+    for (int axis = 0; axis < 2; ++axis) {
+        const vec2 edge = axis == 0 ? edgeU : edgeV;
+        const float radius = faceRadius + abs(edge.y) * tileHalf.x + abs(edge.x) * tileHalf.y;
+        const float magnitudeX = abs(tileCenter.x) + abs(corner.x) + (abs(edgeU.x) + abs(edgeV.x)) * 0.5;
+        const float magnitudeY = abs(tileCenter.y) + abs(corner.y) + (abs(edgeU.y) + abs(edgeV.y)) * 0.5;
+        const float roundoff = 0.000002 * (abs(edge.y) * magnitudeX + abs(edge.x) * magnitudeY + radius);
+        if (abs(projectedFaceDeterminant(delta, edge)) > radius + roundoff) return false;
+    }
+    return true;
+}
+
 #endif
