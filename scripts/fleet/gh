#!/usr/bin/env bash
# gh — enforce a selected pane identity and refresh daemon installation tokens.
#
# FLEET_GH_IDENTITY=user removes inherited GitHub tokens so gh uses its own
# credential store. Unselected callers retain their environment; a ghs_ token
# is refreshed through fleet-gh-token unless FLEET_GH_SHIM=0. The minter uses
# curl, never gh, so refreshing cannot recurse. No token is printed here.
#
# An unselected ghs_ token is assumed to belong to the fleet App; do not share
# this shim with a self-hosted Actions runner or another installation token.

_resolve() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1" 2>/dev/null && return 0
    fi
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null | tr -d '\r'
}

if [[ "${FLEET_GH_IDENTITY:-}" == user ]]; then
    unset GH_TOKEN GITHUB_TOKEN
elif [[ "${FLEET_GH_SHIM:-1}" != "0" && "${GH_TOKEN:-}" == ghs_* ]]; then
    _fresh="$(fleet-gh-token 2>/dev/null || true)"
    [[ -n "$_fresh" ]] && export GH_TOKEN="$_fresh"
fi

# The real gh is the first `gh` on PATH that is neither this file nor the
# accounting launcher. Compare resolved paths: the shim is reached as ~/bin/gh
# (a symlink), as scripts/fleet/gh, and under PATH spellings (~/bin, $HOME/bin,
# $HOME/bin/) that differ textually.
#
# The launcher (gh-accounting-bin/gh) is the other fleet wrapper: fleet-up puts
# it first on a daemon's PATH and pins this shim as the gh it exec's. Choosing
# it here hands the call straight back, and the two exec each other until the
# caller's timeout. Both spellings are skipped — the one fleet-up exported and
# the sibling of this file — so a shim copied out of the repo is covered too.
_self="$(_resolve "${BASH_SOURCE[0]}")"
_launcher_env=""
_launcher_sibling=""
[[ -n "${FLEET_GH_LAUNCHER:-}" ]] && _launcher_env="$(_resolve "$FLEET_GH_LAUNCHER")"
[[ -e "${_self%/*}/gh-accounting-bin/gh" ]] \
    && _launcher_sibling="$(_resolve "${_self%/*}/gh-accounting-bin/gh")"
_real=""
while IFS= read -r _cand; do
    _cand_resolved="$(_resolve "$_cand")"
    [[ "$_cand_resolved" == "$_self" ]] && continue
    [[ -n "$_launcher_env" && "$_cand_resolved" == "$_launcher_env" ]] && continue
    [[ -n "$_launcher_sibling" && "$_cand_resolved" == "$_launcher_sibling" ]] && continue
    _real="$_cand"
    break
done < <(type -ap gh 2>/dev/null)

if [[ -z "$_real" ]]; then
    echo "gh (fleet shim): no real gh found on PATH" >&2
    exit 127
fi
exec "$_real" "$@"
