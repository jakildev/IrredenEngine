#!/usr/bin/env bash
# fleet-gate-status — read-only view of dispatcher gating state.
#
# Visualises whether fleet-dispatcher is currently throttling new work
# and, if so, when it will resume. Two sources:
#
#   1. Fleet-wide usage gate — based on rate_limit_event observations
#      latched by fleet-claude-stream into ~/.fleet/state/usage/*.json.
#      Mirrors fleet-dispatcher's usage_gate_status(): same threshold
#      lookup, same staleness check, same past-(resetsAt+grace) prune.
#      If those rules change there, mirror the change here.
#      (`fleet-dispatcher --gate-status` exposes a one-line variant of
#      the same evaluation.)
#
#   2. Per-pane cooldowns — fleet-dispatch-wrap writes a Unix epoch to
#      ~/.fleet/state/rate-limit/<pane_key>.ts when its launch died at
#      the usage wall (the stream's rejected flag, or the legacy exit
#      code 2). The pane stays out of dispatch for LIMIT_DELAY seconds
#      (default 900).
#
# Pure read-only: no mutations, no daemon contact. The dispatcher itself
# auto-resumes when each rate-limit window's `resetsAt + grace` passes
# (grace = FLEET_DISPATCHER_RESET_GRACE_SECONDS, default 600s; see
# --help) — this command does NOT trigger resume; it just shows the
# current state.

set -euo pipefail

# The inline python imports fleet_github from this script's real directory.
_fleet_gate_status_self="${BASH_SOURCE[0]}"
while [[ -L "$_fleet_gate_status_self" ]]; do _fleet_gate_status_self="$(readlink "$_fleet_gate_status_self")"; done
FLEET_LIB_DIR="$(cd "$(dirname "$_fleet_gate_status_self")" && pwd)"
export FLEET_LIB_DIR
unset _fleet_gate_status_self

STATE_DIR="${FLEET_STATE_DIR:-$HOME/.fleet/state}"
USAGE_DIR="$STATE_DIR/usage"
RATE_LIMIT_DIR="$STATE_DIR/rate-limit"

# Source the conf the dispatcher sources, the same way (a plain `source`
# after the env is set, so a conf assignment wins as it does there): a
# gate threshold or scope override set only in fleet-up.conf must read
# the same here as in the dispatch decision.
FLEET_CONF="${FLEET_CONF:-$HOME/.fleet/fleet-up.conf}"
if [[ -f "$FLEET_CONF" ]]; then
    # shellcheck disable=SC1090
    source "$FLEET_CONF"
fi

# Same env vars and defaults as fleet-dispatcher, so output cannot
# disagree with what the dispatcher actually evaluates.
USAGE_STALE_SECONDS="${FLEET_DISPATCHER_USAGE_STALE_SECONDS:-3600}"
RESET_GRACE_SECONDS="${FLEET_DISPATCHER_RESET_GRACE_SECONDS:-600}"
LIMIT_DELAY="${FLEET_DISPATCHER_LIMIT_DELAY:-900}"
POLL_INTERVAL_SECONDS="${FLEET_DISPATCHER_INTERVAL:-10}"

JSON=0
case "${1:-}" in
    -h|--help)
        cat <<'EOF'
fleet-gate-status — read-only view of fleet-dispatcher gating.

  fleet-gate-status            human-readable summary
  fleet-gate-status --json     machine-readable JSON
  fleet-gate-status -h|--help  this help

Reports:
  • benchmark quiet window and host-wide switch
  • fleet-wide usage gate (5h / 7d / etc. rate-limit thresholds)
  • GitHub API quota (core / graphql / search pools, gated at 90%; search is
    surface-only and never gates); each latched sample carries the identity
    (user = personal pool, app = GitHub App pool) the scout read it under;
    compatible GraphQL samples include points spent since the prior scout tick
  • when the GitHub App is configured (FLEET_GH_APP_*): both identities' live
    /rate_limit readings side by side (the probe spends no quota)
  • per-pane cooldowns (15-min default after a pane's launch died at the wall)

Auto-resume is automatic: the dispatcher re-opens the gate on its next
poll (~10s) once `resetsAt + FLEET_DISPATCHER_RESET_GRACE_SECONDS` has
passed (default grace is 600s, so by default ~10 min after the actual
reset). This command only visualises state — it does NOT trigger resume.

State sources (read-only):
  ~/.fleet/state/usage/*.json         (Anthropic: fleet-claude-stream;
                                        GitHub: fleet-state-scout, plus
                                        github-graphql.rejected.json from any
                                        refused GraphQL call)
  ~/.fleet/state/rate-limit/*.ts      (written by fleet-dispatch-wrap)

A window that meters one model family (the Fable-only weekly limit,
seven_day_opus, ...) never closes the fleet-wide gate: it is listed under
"Model-scoped usage gate" and defers only launches on that family's models.

Tunables (env or $FLEET_CONF, default ~/.fleet/fleet-up.conf; shared with
fleet-dispatcher, which reads them the same way):
  FLEET_DISPATCHER_USAGE_GATE_<TYPE>  per-type threshold (e.g. _FIVE_HOUR=0.7)
  FLEET_DISPATCHER_USAGE_GATE         global threshold override
  FLEET_DISPATCHER_USAGE_SCOPE_<TYPE> fable|opus|sonnet|haiku|account
  FLEET_DISPATCHER_USAGE_STALE_SECONDS  default 3600
  FLEET_DISPATCHER_RESET_GRACE_SECONDS  default 600
  FLEET_DISPATCHER_LIMIT_DELAY        default 900
  FLEET_DISPATCHER_INTERVAL           default 10
EOF
        exit 0
        ;;
    --json)
        JSON=1
        ;;
    "")
        ;;
    *)
        echo "fleet-gate-status: unknown arg '$1' (try --help)" >&2
        exit 2
        ;;
esac

# GitHub App configured: the live probe below needs an installation token to
# read the App pool beside the personal one. Same three-knob predicate and
# same minter as every fleet caller (fleet-gh-token prints nothing when any
# knob is unset); PATH first so an installed copy wins, the sibling second.
GATE_APP_CONFIGURED=0
GATE_APP_TOKEN=""
if [[ -n "${FLEET_GH_APP_ID:-}" && -n "${FLEET_GH_APP_INSTALLATION_ID:-}" \
      && -n "${FLEET_GH_APP_KEY_PATH:-}" ]]; then
    GATE_APP_CONFIGURED=1
    if command -v fleet-gh-token >/dev/null 2>&1; then
        GATE_APP_TOKEN="$(fleet-gh-token 2>/dev/null || true)"
    elif [[ -x "$(dirname "$0")/fleet-gh-token" ]]; then
        GATE_APP_TOKEN="$("$(dirname "$0")/fleet-gh-token" 2>/dev/null || true)"
    fi
fi

export USAGE_DIR RATE_LIMIT_DIR USAGE_STALE_SECONDS RESET_GRACE_SECONDS \
       LIMIT_DELAY POLL_INTERVAL_SECONDS JSON GATE_APP_CONFIGURED GATE_APP_TOKEN

QUIET_WINDOW_JSON='{"state":"off","leases":[],"busy":0,"parked":0}'
if command -v ir-acquire >/dev/null 2>&1; then
    QUIET_WINDOW_JSON=$(ir-acquire --quiet-status --json 2>/dev/null || true)
fi
export QUIET_WINDOW_JSON

# Pass through any per-type / global override env vars that fleet-dispatcher
# reads, so threshold lookup matches the dispatcher's view.
if [[ -n "${FLEET_DISPATCHER_USAGE_GATE:-}" ]]; then
    export FLEET_DISPATCHER_USAGE_GATE
fi
for _gate_var in $(compgen -A variable | grep -E '^FLEET_DISPATCHER_USAGE_(GATE|SCOPE)_' || true); do
    export "$_gate_var"
done

python3 - <<'PY'
import json
import os
import pathlib
import subprocess
import sys
import time
from datetime import datetime, timezone

sys.path.insert(0, os.environ["FLEET_LIB_DIR"])
import fleet_github

usage_dir = pathlib.Path(os.environ["USAGE_DIR"])
ratelimit_dir = pathlib.Path(os.environ["RATE_LIMIT_DIR"])
stale_s = int(os.environ.get("USAGE_STALE_SECONDS", "3600"))
reset_grace_s = int(os.environ.get("RESET_GRACE_SECONDS", "600"))
limit_delay = int(os.environ.get("LIMIT_DELAY", "900"))
poll_s = int(os.environ.get("POLL_INTERVAL_SECONDS", "10"))
emit_json = os.environ.get("JSON") == "1"
try:
    quiet_window = json.loads(os.environ.get("QUIET_WINDOW_JSON", ""))
except (TypeError, ValueError):
    quiet_window = {"state": "off", "leases": [], "busy": 0, "parked": 0}

# Mirrors fleet-dispatcher's usage_gate_status() tables: threshold_for(),
# BUILTIN_PER_TYPE_DEFAULTS, BUILTIN_MODEL_SCOPES, scope_of(). Keep in sync —
# same semantics, same defaults.
BUILTIN_PER_TYPE_DEFAULTS = {
    "seven_day": 0.95,
    "five_hour": 0.80,
    "github_core": 0.90,
    "github_graphql": 0.90,
    "github_search": 1.01,
}
BUILTIN_FALLBACK = 0.80
MODEL_FAMILIES = ("fable", "opus", "sonnet", "haiku")
BUILTIN_MODEL_SCOPES = {
    "seven_day_overage_included": "fable",
}


def env_suffix(rate_limit_type):
    return "".join(c.upper() if c.isalnum() else "_" for c in (rate_limit_type or ""))


def scope_of(rate_limit_type):
    t = rate_limit_type or ""
    if t.startswith("github"):
        return "account"
    override = os.environ.get(f"FLEET_DISPATCHER_USAGE_SCOPE_{env_suffix(t)}", "")
    override = override.strip().lower()
    if override == "account" or override in MODEL_FAMILIES:
        return override
    if t in BUILTIN_MODEL_SCOPES:
        return BUILTIN_MODEL_SCOPES[t]
    suffix = t[len("seven_day_"):] if t.startswith("seven_day_") else ""
    return suffix if suffix in MODEL_FAMILIES else "account"


def threshold_source(rate_limit_type):
    """(threshold, from_fallback) — see the dispatcher's threshold_for()."""
    safe = env_suffix(rate_limit_type)
    if safe:
        var = f"FLEET_DISPATCHER_USAGE_GATE_{safe}"
        if var in os.environ and os.environ[var]:
            try:
                return float(os.environ[var]), False
            except ValueError:
                pass
    glob = os.environ.get("FLEET_DISPATCHER_USAGE_GATE", "")
    if glob:
        try:
            return float(glob), False
        except ValueError:
            pass
    t = rate_limit_type or ""
    if t in BUILTIN_PER_TYPE_DEFAULTS:
        return BUILTIN_PER_TYPE_DEFAULTS[t], False
    if t.startswith("seven_day"):
        return threshold_source("seven_day")[0], False
    return BUILTIN_FALLBACK, True


def threshold_for(rate_limit_type):
    return threshold_source(rate_limit_type)[0]


def parse_resets(value):
    """Return a tz-aware datetime for the observation's resetsAt.

    The CLI has shipped resetsAt in two shapes — ISO-8601 string with Z
    suffix, and Unix epoch int/float. Accept both so the gate evaluation
    matches the dispatcher's usage_gate_status().
    """
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return None
    if isinstance(value, (int, float)):
        try:
            return datetime.fromtimestamp(value, tz=timezone.utc)
        except (OverflowError, OSError, ValueError):
            return None
    return None


def fmt_duration(seconds):
    if seconds is None:
        return "?"
    if seconds < 0:
        return "expired"
    if seconds < 60:
        return f"{seconds}s"
    m, s = divmod(seconds, 60)
    if m < 60:
        return f"{m}m {s}s" if s else f"{m}m"
    h, m = divmod(m, 60)
    return f"{h}h {m}m" if m else f"{h}h"


now = int(time.time())

# --- Usage gate -----------------------------------------------------------

observations = []
breaches = []

if usage_dir.is_dir():
    for path in sorted(usage_dir.glob("*.json")):
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        util = data.get("utilization")
        if not isinstance(util, (int, float)):
            continue
        observed_at = data.get("observed_at")
        resets_raw = data.get("resetsAt")
        resets_dt = parse_resets(resets_raw)
        # Mirrors usage_gate_status(): a parsed resetsAt is authoritative and
        # the observed_at cutoff applies only when it is absent — a latched
        # weekly rejection is hours old and still binding.
        is_stale = (
            resets_dt is None
            and isinstance(observed_at, (int, float))
            and now - int(observed_at) > stale_s
        )
        # ISO-8601 for display so int-epoch payloads don't render as raw numbers.
        resets_at_str = (
            resets_dt.strftime("%Y-%m-%dT%H:%M:%SZ")
            if resets_dt is not None
            else (resets_raw if isinstance(resets_raw, str) else None)
        )
        is_past = resets_dt is not None and resets_dt.timestamp() + reset_grace_s <= now
        eta_s = (
            int(resets_dt.timestamp() - now) if resets_dt is not None else None
        )

        util_f = float(util)
        # Defensive: API returns [0,1] today; tolerate a future [0,100].
        if util_f > 1.5:
            util_f = util_f / 100.0
        rl_type = data.get("rateLimitType", path.stem)
        thr, thr_fallback = threshold_source(rl_type)

        active = not is_stale and not is_past
        breaching = active and util_f >= thr

        obs = {
            "rateLimitType": rl_type,
            # "rejected" when fleet-claude-stream latched the wall itself.
            "status": data.get("status"),
            "utilization": round(util_f, 4),
            "threshold": thr,
            "threshold_fallback": thr_fallback,
            # "account", or the model family the window meters.
            "scope": scope_of(rl_type),
            # The model of the session that latched it (fleet-claude-stream).
            "model": data.get("model"),
            "resetsAt": resets_at_str,
            "etaSeconds": eta_s,
            "observed_at": observed_at,
            "stale": is_stale,
            # past_reset = past `resetsAt + reset_grace_s`. Field name kept
            # for back-compat with `--json` consumers; the meaning shifted
            # when the grace pad was introduced.
            "past_reset": is_past,
            "breaching": breaching,
            # GitHub pools only (fleet-state-scout's sample_github_rate_limit);
            # Anthropic observations never carry these. None lets the display
            # code fall back to a percent-only rendering if they're absent.
            "limit": data.get("limit"),
            "remaining": data.get("remaining"),
            # "user" | "app": the pool the sampler read under (GitHub only;
            # absent on a latch written before the field existed).
            "identity": data.get("identity"),
            # Consecutive compatible GraphQL samples only. These stay absent
            # across identities, reset windows, rejections and regressions.
            "interval_points": data.get("interval_points"),
            "interval_seconds": data.get("interval_seconds"),
            "interval_points_per_minute": data.get("interval_points_per_minute"),
        }
        observations.append(obs)
        if breaching:
            breaches.append(obs)

# A model-scoped breach defers only launches on its family's models, so it
# never closes the fleet-wide verdict.
scoped_breaches = [o for o in breaches if o["scope"] != "account"]
breaches = [o for o in breaches if o["scope"] == "account"]
gate_state = "closed" if breaches else "open"

# GitHub pools are surfaced in their own section (below) rather than mixed
# into the Anthropic "Fleet-wide usage gate" list — different unit (request
# pools vs model-usage windows), different operator audience. A github
# breach still flips gate_state above; it's the same shared dispatcher gate.
github_obs = [o for o in observations if o["rateLimitType"].startswith("github_")]
anthropic_obs = [o for o in observations if not o["rateLimitType"].startswith("github_")]

# --- GitHub identities (live) ---------------------------------------------

app_configured = os.environ.get("GATE_APP_CONFIGURED") == "1"
app_token = os.environ.get("GATE_APP_TOKEN", "")


def probe_identity(token):
    """Live /rate_limit core+graphql for one identity, or None on any failure.

    `token` None probes the personal pool (GH_TOKEN dropped so gh falls back
    to its own credentials); a string probes the App pool. /rate_limit does
    not count against the quota it reports.
    """
    env = dict(os.environ)
    env.pop("GITHUB_TOKEN", None)
    if token is None:
        env.pop("GH_TOKEN", None)
    else:
        env["GH_TOKEN"] = token
    try:
        proc = subprocess.run(
            fleet_github.argv(["api", "/rate_limit"], env=env),
            capture_output=True, text=True, timeout=15, env=env,
        )
        resources = json.loads(proc.stdout).get("resources", {})
    except (subprocess.TimeoutExpired, OSError, ValueError, AttributeError):
        return None
    if proc.returncode != 0:
        return None
    pools = {}
    for pool in ("core", "graphql"):
        info = resources.get(pool)
        if isinstance(info, dict) and info.get("limit"):
            pools[pool] = {
                "limit": info["limit"],
                "remaining": info.get("remaining", info["limit"] - info.get("used", 0)),
                "resetsAt": info.get("reset"),
            }
    return pools or None


# Only when the App is configured: with a single identity the latched samples
# already say everything, and an unconfigured host must not make a live call.
identities = {}
if app_configured:
    identities["user"] = probe_identity(None)
    identities["app"] = probe_identity(app_token) if app_token else None

# --- Per-pane cooldowns ---------------------------------------------------

cooldowns = []
if ratelimit_dir.is_dir():
    for path in sorted(ratelimit_dir.glob("*.ts")):
        try:
            ts = int(path.read_text().strip())
        except (OSError, ValueError):
            continue
        elapsed = now - ts
        remaining = limit_delay - elapsed
        cooldowns.append({
            "pane": path.stem,
            "hit_at": ts,
            "remaining": max(0, remaining),
            "expired": remaining <= 0,
        })

active_cooldowns = [c for c in cooldowns if not c["expired"]]

# --- Output ---------------------------------------------------------------

if emit_json:
    out = {
        "gate": gate_state,
        "quiet_window": quiet_window,
        "breaching": breaches,
        "scoped_breaching": scoped_breaches,
        "observations": observations,
        "github": github_obs,
        "github_identities": identities,
        "cooldowns": cooldowns,
        "thresholds_in_effect": {
            "five_hour": threshold_for("five_hour"),
            "seven_day": threshold_for("seven_day"),
            "github_core": threshold_for("github_core"),
            "github_graphql": threshold_for("github_graphql"),
            "github_search": threshold_for("github_search"),
        },
        "limit_delay_seconds": limit_delay,
        "usage_stale_seconds": stale_s,
        "reset_grace_seconds": reset_grace_s,
        "poll_interval_seconds": poll_s,
        "now": now,
    }
    print(json.dumps(out, indent=2, sort_keys=True))
    sys.exit(0)

print("fleet-gate-status — read-only view of dispatcher gating")
print()

quiet_state = quiet_window.get("state", "off")
quiet_record = quiet_window.get("record") or {}
quiet_switch = quiet_window.get("switch") or {}
quiet_detail = ""
if quiet_record:
    quiet_detail = (
        f" holder={quiet_record.get('pid')} owner={quiet_record.get('owner') or '-'}"
        f" busy={quiet_window.get('busy', 0)} parked={quiet_window.get('parked', 0)}"
    )
elif quiet_switch:
    quiet_detail = f" reason={quiet_switch.get('reason', '-')}"
print(f"Quiet window: {quiet_state}{quiet_detail}")
print()

label = "CLOSED" if gate_state == "closed" else "OPEN"
print(f"Fleet-wide usage gate: {label}")
if not anthropic_obs:
    print("  no claude observations yet (no rate_limit_event seen since fleet started)")
else:

    def fmt_obs(o, prefix, threshold_text, suffix=""):
        pct = int(round(o["utilization"] * 100))
        eta = (
            f" (in {fmt_duration(o['etaSeconds'])})"
            if o["etaSeconds"] is not None and o["etaSeconds"] > 0
            else ""
        )
        resets_part = f" resets={o['resetsAt']}" if o.get("resetsAt") else ""
        status_part = " REJECTED" if o.get("status") == "rejected" else ""
        scope_part = f" scope={o['scope']}" if o["scope"] != "account" else ""
        model_part = f" seen-by={o['model']}" if o.get("model") else ""
        return (
            f"  {prefix:<10} {o['rateLimitType']}{status_part} "
            f"util={pct}% {threshold_text}{suffix}{scope_part}{model_part}"
            f"{resets_part}{eta}"
        )

    def thr_text(o, cmp):
        thr_pct = int(round(o["threshold"] * 100))
        fallback = ", unlisted type, fallback threshold" if o["threshold_fallback"] else ""
        return f"({cmp} {thr_pct}%{fallback})"

    def print_group(group):
        for o in sorted((o for o in group if o["breaching"]),
                        key=lambda x: x["utilization"], reverse=True):
            print(fmt_obs(o, "breaching:", thr_text(o, ">=")))
        for o in group:
            if o["breaching"] or o["stale"] or o["past_reset"]:
                continue
            print(fmt_obs(o, "other:", thr_text(o, "<")))
        for o in group:
            if not (o["stale"] or o["past_reset"]):
                continue
            past_label = "past-reset" if reset_grace_s == 0 else "past-reset+grace"
            reasons = "/".join(
                r for r, on in (("stale", o["stale"]), (past_label, o["past_reset"])) if on
            )
            print(fmt_obs(o, "pruned:", f"[{reasons}]"))

    print_group([o for o in anthropic_obs if o["scope"] == "account"])
    scoped_obs = [o for o in anthropic_obs if o["scope"] != "account"]
    if scoped_obs:
        walled = sorted({o["scope"] for o in scoped_breaches})
        state = (f"CLOSED for {', '.join(walled)} (launches on those models deferred; "
                 "other models unaffected)") if walled else "OPEN"
        print(f"Model-scoped usage gate: {state}")
        print_group(scoped_obs)

print()

# --- GitHub API quota -------------------------------------------------------
# Separate section: different unit (request pools, not model-usage windows)
# and a different operator question ("how close is the fleet to a GitHub
# rate-limit wall" vs "is the Anthropic usage gate open"). A github breach
# still flips the shared `gate_state` above to CLOSED — same dispatcher gate,
# just displayed apart from the Anthropic observations.
if not github_obs:
    print("GitHub API quota: no observations yet (scout hasn't sampled GitHub quota)")
else:
    def fmt_github_obs(o):
        pct = int(round(o["utilization"] * 100))
        thr_pct = int(round(o["threshold"] * 100))
        cmp_text = f"(>= {thr_pct}%)" if o["breaching"] else f"(< {thr_pct}%)"
        prefix = "breaching:" if o["breaching"] else "other:"
        pool = o["rateLimitType"].removeprefix("github_")
        if o.get("identity"):
            pool = f"{pool}[{o['identity']}]"
        # "rejected": the limiter refused the scout's sample (github-graphql.json)
        # or a real GraphQL call (github-graphql.rejected.json).
        status_part = " REJECTED" if o.get("status") == "rejected" else ""
        remaining, limit = o.get("remaining"), o.get("limit")
        quota_text = f"remaining={remaining}/{limit}" if limit else f"util={pct}%"
        interval_text = ""
        if o.get("interval_points") is not None:
            interval_text = (
                f" interval={o['interval_points']} points/{o['interval_seconds']}s"
                f" ({o['interval_points_per_minute']:.2f}/min)"
            )
        eta = (
            f" (in {fmt_duration(o['etaSeconds'])})"
            if o["etaSeconds"] is not None and o["etaSeconds"] > 0
            else ""
        )
        resets_part = f" resets={o['resetsAt']}" if o.get("resetsAt") else ""
        stale_part = ""
        if o["stale"] or o["past_reset"]:
            past_label = "past-reset" if reset_grace_s == 0 else "past-reset+grace"
            reasons = "/".join(
                r for r, on in (("stale", o["stale"]), (past_label, o["past_reset"])) if on
            )
            stale_part = f" [{reasons}]"
        return (
            f"  {prefix:<10} {pool:<13} {quota_text}{interval_text}{status_part} "
            f"{cmp_text}{resets_part}{eta}{stale_part}"
        )

    print("GitHub API quota:")
    for o in sorted(github_obs, key=lambda x: x["rateLimitType"]):
        print(fmt_github_obs(o))

print()
if identities:
    print("GitHub identities (live /rate_limit, App configured):")
    for name in ("user", "app"):
        pools = identities.get(name)
        if not pools:
            why = ("fleet-gh-token minted no token" if name == "app" and not app_token
                   else "probe failed")
            print(f"  {name:<5} unavailable ({why})")
            continue
        parts = []
        for pool in ("core", "graphql"):
            if pool in pools:
                info = pools[pool]
                parts.append(f"{pool} remaining={info['remaining']}/{info['limit']}")
        print(f"  {name:<5} {', '.join(parts)}")
    print()

if active_cooldowns:
    print(f"Per-pane cooldowns: {len(active_cooldowns)} active")
    for c in active_cooldowns:
        hit_iso = datetime.fromtimestamp(c["hit_at"], tz=timezone.utc) \
            .strftime("%Y-%m-%dT%H:%M:%SZ")
        print(
            f"  {c['pane']:<10} {fmt_duration(c['remaining'])} remaining "
            f"(cooldown {limit_delay}s, hit {hit_iso})"
        )
else:
    print("Per-pane cooldowns: none active")

print()
if reset_grace_s > 0:
    print(
        f"Note: dispatcher polls every {poll_s}s; resume happens within "
        f"~{poll_s}s of (reset + {reset_grace_s}s grace)."
    )
else:
    print(f"Note: dispatcher polls every {poll_s}s; resume happens within ~{poll_s}s of reset.")
