#!/usr/bin/env bash
# fleet-positive-control — run a test suite against a pre-fix ref to prove the
# suite actually detects the fix (i.e. that it is not vacuous).
#
# Why this exists
# ---------------
# scripts/fleet/ has no CI coverage, so a new suite's worth rests on a positive
# control: stage the old code, run the new suite against it, and confirm the
# fix-specific assertions fail there. Hand-staging that gets it wrong silently.
#
# The wrappers here dispatch to the fleet_*.py modules beside them, so staging
# only the script under test makes every invocation abort on its own lib-dir
# preflight with rc=1 and empty stdout — which the suite records as ordinary
# assertion failures and reports as a normal-looking tally. A mis-stage read
# 2 passed / 21 failed where the truth was 14 / 9, inflating the fix's apparent
# coverage with nothing to signal the number was bogus (#2713).
#
# Staging the whole directory with `git archive` puts that failure mode out of
# reach. `require_fleet_lib_dir` in tests/lib_assert.sh is the backstop for
# controls still run by hand.
#
# Usage
# -----
#   fleet-positive-control <test-file> <ref> [--include <pathspec>]...
#
#   <test-file>  the suite to run — your working-tree copy, which is the
#                version under development and the thing being validated
#   <ref>        the pre-fix baseline (e.g. origin/master, or the sha the
#                fix landed on top of)
#   --include    stage an extra pathspec beside scripts/fleet (repeatable),
#                for a suite that reads outside this directory
#
# Suite types mirror tests/run_all.sh, the authority on how a suite is run:
# test_*.sh under bash, tallied from lib_assert.sh's `summarize` line, and
# test_*.py under python3, tallied from unittest's own summary. Any other
# extension is refused by name rather than guessed at. The interpreter is
# always supplied explicitly rather than exec-ing the staged file, because the
# .py suites carry no shebang — run_all.sh supplies python3 — so exec-ing one
# hands it to the shell, whose syntax errors then read as a staging failure,
# the one part that was correct (#2848).
#
# One caveat is specific to .py suites: unittest imports the whole module before
# running anything, so a suite that imports a symbol the fix *adds* raises
# ImportError against the pre-fix ref and aborts with no tally at all rather
# than scoring its fix-specific assertions as failures. Import such a symbol
# inside the test body when you want a per-assertion control out of it.
#
# Output ends with a copy-pasteable line for the PR body's test plan, with the
# arithmetic already checked — the #2708 nit was a miscounted fail count.
#
# Exit status:
#   0  control is meaningful — at least one assertion failed on the old code
#   1  control is VACUOUS — the suite passes unchanged against the old code,
#      so it does not test the fix
#   2  usage error, bad ref, unsupported suite type, or the suite aborted as
#      a setup failure

set -euo pipefail

die() { echo "fleet-positive-control: $*" >&2; exit 2; }

TEST_FILE=""
REF=""
INCLUDES=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --include)
            [[ -n "${2:-}" ]] || die "--include needs a pathspec"
            INCLUDES+=("$2"); shift 2 ;;
        --include=*)
            spec="${1#--include=}"
            [[ -n "$spec" ]] || die "--include= needs a pathspec"
            INCLUDES+=("$spec"); shift ;;
        -h|--help)
            # The whole header comment, minus the shebang — a line range would
            # silently truncate the moment the header grows.
            awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"
            exit 0 ;;
        -*)
            die "unknown option: $1" ;;
        *)
            if   [[ -z "$TEST_FILE" ]]; then TEST_FILE="$1"
            elif [[ -z "$REF" ]];       then REF="$1"
            else die "unexpected argument: $1"
            fi
            shift ;;
    esac
done

[[ -n "$TEST_FILE" && -n "$REF" ]] || die "usage: fleet-positive-control <test-file> <ref> [--include <pathspec>]..."
[[ -f "$TEST_FILE" ]] || die "test file not found: $TEST_FILE"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git working tree"
git -C "$REPO_ROOT" rev-parse --verify --quiet "$REF^{commit}" >/dev/null \
    || die "not a commit-ish: $REF"
REF_SHA=$(git -C "$REPO_ROOT" rev-parse --short "$REF^{commit}")
# A symbolic ref is worth pinning to its sha; a ref the caller already gave as a
# sha would just print itself twice.
REF_LABEL="$REF"
[[ "$REF_SHA" == "$REF"* ]] || REF_LABEL="$REF ($REF_SHA)"

# Absolute, so the copy below is immune to the cd into the staged tree.
TEST_ABS=$(cd "$(dirname "$TEST_FILE")" && pwd)/$(basename "$TEST_FILE")
# Where the suite sits relative to the repo, so it lands in the same spot in
# the staged tree and its own $(dirname $0)/.. resolution still works.
TEST_REL=${TEST_ABS#"$REPO_ROOT"/}
[[ "$TEST_REL" != "$TEST_ABS" ]] || die "test file is outside the repo: $TEST_FILE"

# Interpreter by extension, as run_all.sh does. run_all.sh can afford a
# catch-all to bash because its glob only ever hands it test_*.{sh,py}; this
# tool takes a caller-supplied path, so the unknown case is named rather than
# guessed — a wrong interpreter surfaces as a syntax error downstream and reads
# as a staging failure (#2848).
case "$TEST_REL" in
    *.py) SUITE_KIND=py; INTERP=(python3) ;;
    *.sh) SUITE_KIND=sh; INTERP=(bash) ;;
    *)    die "unsupported suite type: $(basename "$TEST_FILE") — this tool runs test_*.sh (bash) and test_*.py (python3), matching tests/run_all.sh" ;;
esac

STAGE=$(mktemp -d)
cleanup() { [[ -n "${STAGE:-}" && -d "$STAGE" ]] && rm -rf "$STAGE"; }
trap cleanup EXIT

# Whole directory, never a hand-picked subset — that is the entire point.
git -C "$REPO_ROOT" archive "$REF" scripts/fleet "${INCLUDES[@]+"${INCLUDES[@]}"}" \
    | tar -x -C "$STAGE" || die "failed to stage scripts/fleet from $REF"

# Drop the working-tree suite over the old tree: new test, old code. The staged
# copy needs no exec bit — the interpreter is supplied above, which is why the
# .py suites carry neither it nor a shebang.
mkdir -p "$STAGE/$(dirname "$TEST_REL")"
cp "$TEST_ABS" "$STAGE/$TEST_REL"

echo "positive control: $(basename "$TEST_FILE") vs $REF_LABEL"
echo "  staged scripts/fleet${INCLUDES[*]+ + ${INCLUDES[*]}} into $STAGE"
echo "  running the suite under ${INTERP[*]}"
echo ""

set +e
"${INTERP[@]}" "$STAGE/$TEST_REL" > "$STAGE/.stdout" 2> "$STAGE/.stderr"
RC=$?
set -e
# One stream for the operator, as before — but captured as two for the parse
# below, because each suite type summarizes on a different one: `summarize`
# writes to stdout, unittest to stderr. Merged, a block-buffered stdout line
# flushed at exit can land after stderr's summary, and a `tail -1` looking for
# the verdict would read that line instead — a wrong-but-plausible tally, the
# one thing this tool exists to never print.
cat "$STAGE/.stdout" "$STAGE/.stderr"

# The suite's own summary is the authority on the counts — parsing it keeps
# this wrapper honest about what the suite actually reported. Each suite type
# prints its own format, so the parse is dispatched the same way the
# interpreter is. The `|| true` matters: no match is the no-tally case handled
# below, and under `set -o pipefail` it would otherwise kill the script here
# with rc=1, which reads as "vacuous".
no_tally() {
    echo ""
    echo "fleet-positive-control: the suite printed no tally (exit $RC)." >&2
    echo "  It aborted before $1 — treat this as a setup failure, not a result." >&2
    exit 2
}

# One `key=N` count out of unittest's summary parenthetical; 0 when absent.
field() {
    [[ "$1" =~ (^|[^a-z])$2=([0-9]+) ]] && echo "${BASH_REMATCH[2]}" || echo 0
}

SKIPPED=0
if [[ "$SUITE_KIND" == sh ]]; then
    TALLY=$(grep -E '^(passed: [0-9]+  failed: [0-9]+|.*: [0-9]+ passed, [0-9]+ failed)$' "$STAGE/.stdout" | tail -1 || true)
    [[ -n "$TALLY" ]] || no_tally "summarize"

    if [[ "$TALLY" =~ ^passed:\ ([0-9]+)\ \ failed:\ ([0-9]+)$ ]]; then
        P=${BASH_REMATCH[1]}; F=${BASH_REMATCH[2]}
    else
        [[ "$TALLY" =~ ([0-9]+)\ passed,\ ([0-9]+)\ failed$ ]] || die "could not parse tally: $TALLY"
        P=${BASH_REMATCH[1]}; F=${BASH_REMATCH[2]}
    fi
    TOTAL=$((P + F))
else
    # unittest splits its summary across two lines — `Ran N test(s)` and a
    # separate OK / FAILED(...) verdict — both on stderr. Neither is optional:
    # the count without the verdict cannot say how many failed.
    RAN=$(grep -E '^Ran [0-9]+ tests? in ' "$STAGE/.stderr" | tail -1 || true)
    VERDICT=$(grep -E '^(OK|FAILED)( \(.*\))?$' "$STAGE/.stderr" | tail -1 || true)
    [[ -n "$RAN" && -n "$VERDICT" ]] || no_tally "unittest's summary"

    # Held in a variable: a regex literal ending in an escaped space swallows
    # the closing `]]` into the same word.
    RAN_RE='^Ran ([0-9]+) tests? in '
    [[ "$RAN" =~ $RAN_RE ]] || die "could not parse tally: $RAN"
    TOTAL=${BASH_REMATCH[1]}

    # The parenthetical is a comma-separated `key=N` list whose keys can carry
    # spaces. Rename the two that embed another key's name before matching, or
    # `failures=` reads "expected failures=1" — a test that failed *as
    # designed*, i.e. a pass — as a failure. Unexpected successes go the other
    # way and do count: wasSuccessful() is false when any are present.
    FIELDS=""
    if [[ "$VERDICT" == *\(* ]]; then FIELDS=${VERDICT#*\(}; FIELDS=${FIELDS%\)}; fi
    FIELDS=${FIELDS//expected failures=/xfail=}
    FIELDS=${FIELDS//unexpected successes=/unexpectedok=}

    F=$(( $(field "$FIELDS" failures) + $(field "$FIELDS" errors) + $(field "$FIELDS" unexpectedok) ))
    SKIPPED=$(field "$FIELDS" skipped)
    P=$((TOTAL - F - SKIPPED))
    # Rather than print a tally that cannot be true, which is the whole failure
    # class this tool exists to close (#2713).
    (( P >= 0 )) || die "inconsistent unittest summary: '$RAN' / '$VERDICT'"
fi

echo ""
echo "--- positive control result ---"

# A skipped test cannot fail, so it carries no control signal and must not be
# folded into the passing count — that would report a suite as broader than it
# ran. In a staged tree a skip is usually a guard tripping on a path outside
# scripts/fleet, which is the case --include exists for.
SKIP_NOTE=""
PASS_DESC="all $TOTAL assertions"
if [[ "$SKIPPED" -gt 0 ]]; then
    SKIP_NOTE=" ($SKIPPED skipped — a skipped test proves nothing about the ref;"
    SKIP_NOTE+=" if it guards on a path outside scripts/fleet, re-run with --include)"
    PASS_DESC="all $P assertions that ran"
fi

if [[ "$F" -eq 0 ]]; then
    echo "VACUOUS: $PASS_DESC pass against $REF_LABEL.$SKIP_NOTE"
    echo "The suite does not distinguish the fix from the code it replaces."
    exit 1
fi

echo "MEANINGFUL: $F of $TOTAL assertions fail against $REF_LABEL.$SKIP_NOTE"
echo ""
echo "For the PR body's test plan:"
echo "- [x] **Positive control**: the suite run against the pre-fix \`$REF\` (\`$REF_SHA\`)"
echo "      fails **$F** assertions; the **$P** that still pass are the non-regression"
if [[ "$SKIPPED" -gt 0 ]]; then
    echo "      assertions, and **$SKIPPED** were skipped. ($P + $F + $SKIPPED = $TOTAL, the full suite.)"
else
    echo "      assertions. ($P + $F = $TOTAL, the full suite.)"
fi
