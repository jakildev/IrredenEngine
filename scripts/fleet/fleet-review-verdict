#!/usr/bin/env bash
# fleet-review-verdict — apply a reviewer VERDICT transition to a PR, but
# only if this agent actually holds the reviewing claim on that PR and a
# submitted review body exists for the PR's current head.
#
# This is a thin guard in FRONT of fleet-transition. fleet-transition is
# the sole state-machine mechanism (it computes the effective label delta
# and applies it idempotently); this wrapper adds two preconditions to the
# reviewer-verdict lane: refuse to stamp a verdict onto a PR the agent
# never claimed for review, or whose review body did not land.
#
# The reviewer takes an atomic fleet:reviewing-<host>-<agent> claim on the
#   PR it reviews; a raw `fleet-transition verdict-*` ties nothing to that
#   claim, so a verdict for one PR can land on a DIFFERENT PR when the
#   reviewer crosses PR numbers mid-iteration — an internally contradictory
#   result (approve body + needs-fix label) that elects the wrong PR into the
#   worker lane. This wrapper rejects a verdict on an unclaimed PR, surfacing
#   the misroute at the source.
#
# Scope: the FOUR reviewer verdict edges only —
#   verdict-approve, verdict-approve-nits, verdict-needs-fix,
#   verdict-needs-opus-recheck.
#   Any other transition name is rejected ("use fleet-transition"): this
#   wrapper guards the review-verdict lane, not the whole state machine.
#
# Usage:
#   fleet-review-verdict <verdict-transition> <pr-number> \
#       [--agent <name>] [--repo engine|game|<owner/name>] [--no-review-check] [--dry-run]
#   fleet-review-verdict --replay <pr-number> --agent <name> [--repo engine|game|<owner/name>] [--dry-run]
#
# Replay (`verdict-replay` dispatch targets): the PR's newest submitted review
#   on the current head is a fleet review whose edge never landed. The edge is
#   read from that body (fleet_review_replay.verdict_edge: `**Verdict:**
#   needs-fix` -> verdict-needs-fix; `approve` -> verdict-needs-opus-recheck
#   when a line starts `Opus recheck required:`, else verdict-approve-nits
#   with a substantive `### Nits`, else verdict-approve), the head is re-read
#   just before the swap, and nothing is ever posted. The claim is required.
#
# Swept claim: with --agent and no claim label, the wrapper re-takes the claim
#   once instead of refusing, but only when no other reviewing claim stands
#   and the head review is this login's own fleet review carrying the
#   `<!-- fleet-review dispatch=<FLEET_DISPATCH_ID> agent=<name> -->`
#   provenance of this very dispatch. Anything else is the misroute refusal.
#
# Options:
#   --agent <name>  The reviewing agent (worktree basename passed to
#                   `fleet-claim review-claim <N> <agent>`). When present,
#                   the wrapper REQUIRES fleet:reviewing-<host>-<name> on
#                   the PR before applying the verdict — this is the guard.
#                   When OMITTED, the claim check is skipped and the verdict
#                   applies directly: the dual-use carve-out for a human
#                   running review-pr interactively (who holds no claim).
#                   The fleet reviewer/smoke loops ALWAYS pass --agent, so an
#                   agent following its role doc always gets the guard. The
#                   carve-out is the ABSENCE of --agent, deliberately not a
#                   --force flag an agent could add to defeat the guard.
#   --repo <repo>   Target repo: engine, game, or owner/name. Namespaces use
#                   the shared fleet resolver before reaching GitHub or
#                   fleet-transition. Default: the current git remote.
#   --no-review-check
#                   Skip the current-head review-body check. Reserved for the
#                   label-fixup lane fenced by REVIEWER-PROTOCOL.md; ordinary
#                   reviewer verdicts must never pass this flag.
#   --replay        Replay mode (above): takes <pr-number> and no transition.
#   --dry-run       Print what would happen; make no changes. Passed through
#                   to fleet-transition. The claim check still runs; a claim
#                   re-take is reported, not written.
#   -h, --help      Show this help.
#
# Exit status:
#   0  verdict applied, or already satisfied (fleet-transition no-op)
#   1  a gh call failed, or fleet-transition did not converge
#   2  usage / validation error (unknown/non-verdict transition, bad number,
#      missing --agent value) — no writes performed
#   4  MISROUTE GUARD: --agent given but this agent does not hold the
#      reviewing claim on the PR — no writes performed
#   5  REVIEW-BODY GUARD: no submitted review pins the PR's current head —
#      no writes performed
#   6  REPLAY GUARD: --replay found no fleet review on the current head, its
#      body names no unambiguous verdict, or the head moved — no writes
#
# Source of truth: scripts/fleet/fleet-review-verdict in the engine repo.
# Installed to ~/bin/ by scripts/fleet/install.sh.

set -euo pipefail

PROG="fleet-review-verdict"

# fleet-net.sh bounds every gh call and re-runs a GraphQL-refused
# `gh pr view` over REST. A missing lib degrades to unguarded calls.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do _self="$(readlink "$_self")"; done
_lib_dir="$(cd "$(dirname "$_self")" && pwd)"
runtime_dir="$_lib_dir"
if [[ -f "$_lib_dir/fleet-net.sh" ]]; then
    # shellcheck source=/dev/null
    source "$_lib_dir/fleet-net.sh"
fi
unset _self _lib_dir

# The reviewer verdict edges this wrapper guards. Anything else belongs to
# fleet-transition directly.
VERDICT_TRANSITIONS="verdict-approve verdict-approve-nits verdict-needs-fix verdict-needs-opus-recheck"

# ----------------------------------------------------------------------
# Parse args (same positional order as fleet-transition: <edge> <number>)
# ----------------------------------------------------------------------
transition=""
number=""
agent=""
repo_slug=""
dry_run=0
review_check=1
replay=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --agent)
            if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
                echo "$PROG: --agent requires a value" >&2; exit 2
            fi
            agent="$2"; shift 2 ;;
        --agent=*)
            agent="${1#--agent=}"
            # An empty --agent= must be rejected exactly like the space-form's
            # missing value. Otherwise agent="" flows to the guard's
            # `[[ -n "$agent" ]]` check, which reads an empty string as --agent
            # OMITTED and silently takes the interactive-human carve-out —
            # applying the verdict with NO claim check. That defeats the
            # misroute guard on a plausible failure (an unset --agent=$VAR at a
            # templated call site), not just an adversarial one.
            if [[ -z "$agent" ]]; then
                echo "$PROG: --agent requires a value" >&2; exit 2
            fi
            shift ;;
        --repo)
            if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
                echo "$PROG: --repo requires engine, game, or owner/repo" >&2; exit 2
            fi
            repo_slug="$2"; shift 2 ;;
        --repo=*)
            repo_slug="${1#--repo=}"
            if [[ -z "$repo_slug" ]]; then
                echo "$PROG: --repo requires engine, game, or owner/repo" >&2; exit 2
            fi
            shift ;;
        --no-review-check) review_check=0; shift ;;
        --replay) replay=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        -h|--help)
            awk 'NR==1 {next} /^#/ {print; next} {exit}' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        --) shift; break ;;
        -*)
            echo "$PROG: unknown option '$1'" >&2; exit 2 ;;
        *)
            if [[ -z "$transition" ]]; then transition="$1"
            elif [[ -z "$number" ]]; then number="$1"
            else echo "$PROG: unexpected arg '$1'" >&2; exit 2
            fi
            shift ;;
    esac
done

if [[ "$replay" -eq 1 ]]; then
    # The edge comes from the review body; the one positional is the PR.
    if [[ -n "$number" ]]; then
        echo "$PROG: --replay takes a PR number and no transition" >&2; exit 2
    fi
    number="$transition"; transition=""
    if [[ -z "$agent" || "$review_check" -eq 0 ]]; then
        echo "$PROG: --replay requires --agent and the review-body check" >&2; exit 2
    fi
fi
if [[ ( -z "$transition" && "$replay" -eq 0 ) || -z "$number" ]]; then
    echo "$PROG: usage: $PROG <verdict-transition> <pr-number> [--agent <name>] [--repo <slug>] [--no-review-check] [--dry-run]" >&2
    echo "$PROG:        $PROG --replay <pr-number> --agent <name> [--repo <slug>] [--dry-run]" >&2
    exit 2
fi
if ! [[ "$number" =~ ^[0-9]+$ ]]; then
    echo "$PROG: <pr-number> must be a PR number, got '$number'" >&2
    exit 2
fi

# Guard the lane: only the reviewer verdict edges pass through here.
if [[ "$replay" -eq 0 && " $VERDICT_TRANSITIONS " != *" $transition "* ]]; then
    echo "$PROG: '$transition' is not a verdict transition — use fleet-transition." >&2
    echo "$PROG: verdict transitions: $VERDICT_TRANSITIONS" >&2
    exit 2
fi

for dep in gh fleet-transition; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        echo "$PROG: $dep not found." >&2; exit 1
    fi
done

if [[ -n "$repo_slug" ]]; then
    repo_resolve_status=0
    repo_slug="$(PYTHONPATH="$runtime_dir${PYTHONPATH:+:$PYTHONPATH}" python3 -c '
import sys
import fleet_runtime

try:
    print(fleet_runtime.resolve_repo(sys.argv[1]))
except ValueError as exc:
    print(f"fleet-review-verdict: {exc}", file=sys.stderr)
    raise SystemExit(2)
' "$repo_slug")" || repo_resolve_status=$?
    if [[ "$repo_resolve_status" -ne 0 ]]; then
        exit "$repo_resolve_status"
    fi
fi

repo_args=()
[[ -n "$repo_slug" ]] && repo_args=(--repo "$repo_slug")
reviews_path="repos/{owner}/{repo}/pulls/${number}/reviews"
[[ -n "$repo_slug" ]] && reviews_path="repos/${repo_slug}/pulls/${number}/reviews"

# read_head_review — describe the newest submitted review on the current head
# (fleet_review_replay.py inspect). Sets HR_HEAD, HR_AUTHOR, HR_FLEET (0|1),
# HR_EDGE and HR_REASON, HR_DISPATCH and HR_AGENT ("-" when absent).
# Returns 1 on a gh/parse failure, 3 when no submitted review pins the head.
read_head_review() {
    local reviews_file rc=0 line
    HR_HEAD="" HR_AUTHOR="" HR_FLEET=0 HR_EDGE="-" HR_REASON="" HR_DISPATCH="-" HR_AGENT="-"
    if ! HR_HEAD="$(gh pr view "$number" ${repo_args[@]+"${repo_args[@]}"} --json headRefOid --jq '.headRefOid' 2>/dev/null)" || [[ -z "$HR_HEAD" ]]; then
        echo "$PROG: could not read the current head for PR #$number." >&2
        return 1
    fi
    reviews_file="$(mktemp "${TMPDIR:-/tmp}/fleet-review-verdict.XXXXXX")" || return 1
    if ! gh api "$reviews_path" --paginate >"$reviews_file" 2>/dev/null; then
        rm -f "$reviews_file"
        echo "$PROG: could not read the reviews of PR #$number." >&2
        return 1
    fi
    line="$(python3 "$runtime_dir/fleet_review_replay.py" inspect \
        --reviews "$reviews_file" --head "$HR_HEAD" | tr -d '\r')" || rc=$?
    rm -f "$reviews_file"
    if [[ "$rc" -eq 1 ]]; then return 3; fi
    if [[ "$rc" -ne 0 || -z "$line" ]]; then return 1; fi
    IFS=$'\t' read -r HR_AUTHOR HR_FLEET HR_EDGE HR_REASON HR_DISPATCH HR_AGENT <<<"$line"
    return 0
}

# retake_swept_claim — the claim this dispatch took was swept while its review
# was being written. Re-take it only for the review this dispatch posted:
# a different reviewer's body, a different dispatch or agent, or a claim
# another reviewer now holds is the misroute the guard exists to refuse.
retake_swept_claim() {
    local dispatch="${FLEET_DISPATCH_ID:-}" login slug
    local -a claim_ns=()
    [[ -n "$dispatch" && "$dispatch" != preclaim ]] || return 1
    if printf '%s\n' "$live_labels" | grep -q '^fleet:reviewing-'; then
        echo "$PROG: another reviewing claim stands on #$number; not re-taking." >&2
        return 1
    fi
    read_head_review || return 1
    if [[ "$HR_FLEET" != 1 || "$HR_DISPATCH" != "$dispatch" || "$HR_AGENT" != "$agent" ]]; then
        echo "$PROG: the current-head review on #$number is not this dispatch's own; not re-taking." >&2
        return 1
    fi
    login="$(gh api user --jq '.login' 2>/dev/null | tr -d '\r')" || return 1
    if [[ -z "$login" || "$HR_AUTHOR" != "$login" ]]; then
        echo "$PROG: the current-head review on #$number is by '$HR_AUTHOR', not '$login'; not re-taking." >&2
        return 1
    fi
    slug="$repo_slug"
    if [[ -z "$slug" ]]; then
        slug="$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null | tr -d '\r')" || return 1
    fi
    case "$slug" in game|jakildev/irreden) claim_ns=(--repo game) ;; esac
    if [[ "$dry_run" -eq 1 ]]; then
        echo "$PROG: (dry-run) would re-take '$claim_label' on #$number." >&2
        return 0
    fi
    fleet-claim ${claim_ns[@]+"${claim_ns[@]}"} review-claim "$number" "$agent" >/dev/null || return 1
    echo "$PROG: re-took the swept '$claim_label' on #$number for this dispatch's own review." >&2
}

# ----------------------------------------------------------------------
# The guard: with --agent, require this agent's reviewing claim on the PR.
# Omitting --agent is the interactive-human carve-out (no claim to hold).
# ----------------------------------------------------------------------
if [[ -n "$agent" ]]; then
    # Worktree-scope guard: an --agent verdict must be applied from THAT
    # agent's own worktree — wrong-tree state stamps a verdict / posts a review
    # body on the wrong PR. Assert cwd is the agent's worktree before
    # any label write. The no-agent human carve-out never reaches here, so it
    # still runs from anywhere. Fail open if the helper isn't linked yet — the
    # claim check below remains the primary misroute guard.
    _wtguard="${BASH_SOURCE[0]}"
    while [[ -L "$_wtguard" ]]; do _wtguard="$(readlink "$_wtguard")"; done
    _wtguard="$(cd "$(dirname "$_wtguard")" && pwd)/fleet-assert-worktree"
    if [[ -x "$_wtguard" ]]; then
        "$_wtguard" "$agent" || exit 1
    fi
    if ! command -v fleet-claim >/dev/null 2>&1; then
        echo "$PROG: fleet-claim not found (needed to derive the host key)." >&2
        exit 1
    fi
    # Reuse the canonical host key (mac|linux|windows) — the exact token
    # behind every fleet:reviewing-* label. Do NOT re-derive the uname map.
    host="$(fleet-claim host)"
    if [[ -z "$host" ]]; then
        echo "$PROG: could not derive host key from fleet-claim host." >&2
        exit 1
    fi
    claim_label="fleet:reviewing-${host}-${agent}"

    if ! live_labels="$(gh pr view "$number" ${repo_args[@]+"${repo_args[@]}"} --json labels --jq '.labels[].name' 2>/dev/null)"; then
        echo "$PROG: could not read labels for PR #$number (not found, or gh/auth error)." >&2
        exit 1
    fi
    if ! printf '%s\n' "$live_labels" | grep -Fxq -- "$claim_label" \
            && { [[ "$replay" -eq 1 ]] || ! retake_swept_claim; }; then
        echo "$PROG: refusing verdict '${transition:-replay}' on #$number: this agent does not hold '$claim_label'." >&2
        echo "$PROG: (misroute guard) apply the verdict only to the PR you took the reviewing claim on." >&2
        exit 4
    fi
fi

# ----------------------------------------------------------------------
# Replay: the edge is the one the existing current-head fleet review names.
# Its head is re-read immediately before the swap, so a push between the
# projection and here voids the replay instead of stamping an unreviewed head.
# ----------------------------------------------------------------------
if [[ "$replay" -eq 1 ]]; then
    hr_rc=0
    read_head_review || hr_rc=$?
    if [[ "$hr_rc" -eq 1 ]]; then exit 1; fi
    if [[ "$hr_rc" -eq 3 ]]; then
        echo "$PROG: refusing replay on #$number: no submitted review pins the current head." >&2
        exit 6
    fi
    if [[ "$HR_FLEET" != 1 || "$HR_EDGE" == "-" ]]; then
        echo "$PROG: refusing replay on #$number: ${HR_REASON:-no replayable review}." >&2
        exit 6
    fi
    transition="$HR_EDGE"
    replayed_head="$HR_HEAD"
    if ! head_now="$(gh pr view "$number" ${repo_args[@]+"${repo_args[@]}"} --json headRefOid --jq '.headRefOid' 2>/dev/null)" || [[ -z "$head_now" ]]; then
        echo "$PROG: could not re-read the current head for PR #$number." >&2
        exit 1
    fi
    if [[ "$head_now" != "$replayed_head" ]]; then
        echo "$PROG: refusing replay on #$number: the head moved from $replayed_head to $head_now." >&2
        exit 6
    fi
    echo "$PROG: replaying '$transition' on #$number from the review on $replayed_head ($HR_REASON)." >&2
    review_check=0
fi

# ----------------------------------------------------------------------
# Require a submitted review on the exact head being stamped. A timestamp
# comparison is insufficient: old-authored commits and clock skew can both
# make chronology disagree with code coverage. GitHub records the reviewed
# commit directly in reviews[].commit_id, so match that identity instead.
# ----------------------------------------------------------------------
if [[ "$review_check" -eq 1 ]]; then
    if ! head_oid="$(gh pr view "$number" ${repo_args[@]+"${repo_args[@]}"} --json headRefOid --jq '.headRefOid' 2>/dev/null)" || [[ -z "$head_oid" ]]; then
        echo "$PROG: could not read the current head for PR #$number (not found, or gh/auth error)." >&2
        exit 1
    fi

    submitted_commits=""
    for attempt in 1 2; do
        if ! submitted_commits="$(gh api "$reviews_path" --paginate --jq '.[] | select(.state != "PENDING") | .commit_id' 2>/dev/null)"; then
            echo "$PROG: could not verify submitted reviews for PR #$number (gh/auth error)." >&2
            exit 1
        fi
        if printf '%s\n' "$submitted_commits" | grep -Fxq -- "$head_oid"; then
            break
        fi
        if [[ "$attempt" -eq 1 ]]; then
            sleep 2
        fi
    done

    if ! printf '%s\n' "$submitted_commits" | grep -Fxq -- "$head_oid"; then
        echo "$PROG: refusing verdict '$transition' on #$number: no submitted review pins current head $head_oid." >&2
        echo "$PROG: (review-body guard) post the review body for the current head, then retry the verdict." >&2
        exit 5
    fi
fi

# ----------------------------------------------------------------------
# Guard passed (or carved out): delegate to the state-machine mechanism.
# fleet-transition owns idempotency + verify + the effective delta. A fleet
# reviewer records the successful stamp for review-release --require-verdict;
# the next review-claim clears this marker, so stale labels cannot satisfy it.
# ----------------------------------------------------------------------
delegate_args=("$transition" "$number")
[[ -n "$repo_slug" ]] && delegate_args+=(--repo "$repo_slug")
[[ "$dry_run" -eq 1 ]] && delegate_args+=(--dry-run)

fleet-transition "${delegate_args[@]}"

if [[ -n "$agent" && "$dry_run" -eq 0 ]]; then
    claims_dir="${FLEET_CLAIMS_DIR:-$HOME/.fleet/claims}"
    mkdir -p "$claims_dir"
    if ! printf '%s\n' "$number" >"$claims_dir/_review-verdict-${agent}"; then
        echo "$PROG: verdict applied, but could not record the guarded release marker." >&2
        exit 1
    fi
fi
