#!/usr/bin/env bash
# fleet-decisions — everything currently waiting on the human, in one read.
#
# Consolidates the fleet's human-pull surfaces into a single decision-first
# report: the merge queue (verdict labels + CI holds; smoke debt as notes), parked decisions
# (fleet:needs-human, fleet:gated, fleet:design-blocked, fleet:steward-proposal,
# fleet:state-drift), backlog cues
# (fleet:coding-improvement, untriaged issues), and unread feedback-channel
# entries. Backlog cues flip to OVERDUE past their drain thresholds
# (coding-improvement count, untriaged count, feedback-marker age) — the
# informational cue alone let the coding-improvement backlog reach 54 before
# its first drain.
#
# Each approved PR also gets a CI gate reading, keyed on (head sha, workflow
# path): a `hold:` line for every gate with no completed run on the head, and
# for every workflow whose latest run on the head failed. A gate is a workflow
# on the default branch whose pull_request trigger fires on every head push
# (no paths / branches filter, and no types list narrower than GitHub's
# default), derived from the workflow files at read time: a hand list goes
# stale exactly when a new gate lands, which is when a PR reviewed before it
# merges on its old checks. Nothing fleet-side can block a merge, so the hold
# line is the reading the human merges against. An unreadable coverage answer
# prints its own hold; it is never a clean one.
#
# A red that master already carries is told apart from the PR's own. When the
# head and master both failed a workflow whose jobs annotate their failed
# suites (run_all.sh's `fleet-tests failed suites` annotation, one
# `<suite>@<identity>` per failed suite), the two sets are compared: a suite
# failing on the head with no identical failure on master is the hold, and a
# head failing exactly as master does is a `note:`, not a hold. The identity
# is a checksum of the suite's failure blocks — each failure header with its
# assertion detail — so a second failure, or the same assertion failing on a
# different value, in a suite master already fails is still the PR's own; an
# unitemized identity (`?`)
# never matches. A head whose run passed before master's later run of the same
# workflow failed is held to re-run: its green predates the break, and a
# merge on it can land a second red behind the first. GitHub's own merge-box
# state rides along from `gh pr list`: BEHIND is an Update-branch hold, and
# UNSTABLE with no failed run above accounts for it is held as unread.
#
# A job GitHub refused to start (a billing or spending-limit refusal: `failure`,
# no steps, a failure-level annotation) is no reading of the PR's code. A run
# whose every job is one is not a `failed on head` hold, master's is not a later
# failure, and once any such run is seen in a repo its missing-run holds go too
# (Update branch cannot start CI that cannot start). The repo prints one
# `actions not starting on <repo> since <ts>: "<annotation>"` line above the
# merge queue instead, uncounted; a run that cannot be read fully stays an
# ordinary failure.
#
# Read-only on GitHub: changes no labels. The one state it writes is its own
# seen marker for graduated triage stamps (~/.fleet/triage/.decisions-seen),
# so each fleet:agent-approved stamp in ~/.fleet/triage/log.jsonl renders in
# exactly one digest.
#
# Usage:
#   fleet-decisions                  # engine + game
#   fleet-decisions --repo engine    # one repo only
#   fleet-decisions --repo game
#
# Source of truth: scripts/fleet/fleet-decisions in the engine repo.
# Installed to ~/bin/fleet-decisions by scripts/fleet/install.sh.

set -euo pipefail

# The inline python imports fleet_github from this script's real directory.
_fleet_decisions_self="${BASH_SOURCE[0]}"
while [[ -L "$_fleet_decisions_self" ]]; do _fleet_decisions_self="$(readlink "$_fleet_decisions_self")"; done
FLEET_LIB_DIR="$(cd "$(dirname "$_fleet_decisions_self")" && pwd)"
export FLEET_LIB_DIR
unset _fleet_decisions_self

FLEET_HOME="${FLEET_HOME:-$HOME/.fleet}"
REPOS=("jakildev/IrredenEngine" "jakildev/irreden")

resolve_repo() {
    case "$1" in
        engine) REPOS=("jakildev/IrredenEngine") ;;
        game)   REPOS=("jakildev/irreden") ;;
        "")     echo "fleet-decisions: --repo needs a value" >&2; exit 1 ;;
        *)      REPOS=("$1") ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            shift
            resolve_repo "${1:-}"
            shift
            ;;
        --repo=*)
            resolve_repo "${1#--repo=}"
            shift
            ;;
        *)
            echo "Usage: fleet-decisions [--repo engine|game|<owner/name>]" >&2
            exit 1
            ;;
    esac
done

workdir=$(mktemp -d "${TMPDIR:-/tmp}/fleet-decisions.XXXXXX")
trap 'rm -rf "$workdir"' EXIT

manifest="$workdir/manifest.tsv"
: > "$manifest"
idx=0
for repo in "${REPOS[@]}"; do
    prs_f="$workdir/$idx-prs.json"
    issues_f="$workdir/$idx-issues.json"
    if gh pr list --repo "$repo" --state open \
            --json number,title,labels,url,headRefOid,mergeStateStatus,body,updatedAt,headRefName,baseRefName,isDraft --limit 200 > "$prs_f" 2>/dev/null \
        && gh issue list --repo "$repo" --state open \
            --json number,title,labels,url,body,createdAt,updatedAt --limit 200 > "$issues_f" 2>/dev/null; then
        # Only the repo slug and artifact index go in the manifest — never a
        # host absolute path. MSYS translates a POSIX path handed to a native
        # Windows python3 process at the argv/env boundary, never inside data
        # the process reads from a file mid-run, so the artifact paths are
        # derived in Python from $workdir (passed as argv) plus this index.
        printf '%s\t%s\n' "$repo" "$idx" >> "$manifest"
    else
        echo "fleet-decisions: skipping $repo (query failed)" >&2
    fi
    idx=$((idx + 1))
done

if [[ ! -s "$manifest" ]]; then
    echo "fleet-decisions: no repo could be queried" >&2
    exit 1
fi

survey_f="$workdir/survey.json"
survey_args=(--state "$FLEET_HOME/state/state.json" --json --require-fresh)
while IFS=$'\t' read -r repo idx; do
    repo_key=engine
    [[ "$repo" == "jakildev/irreden" ]] && repo_key=game
    survey_args+=(--issues "$repo_key=$workdir/$idx-issues.json" \
                  --prs "$repo_key=$workdir/$idx-prs.json")
done < "$manifest"
if ! "$FLEET_LIB_DIR/fleet-survey" "${survey_args[@]}" > "$survey_f"; then
    echo "fleet-decisions: warning: close-out enrichment unavailable; showing existing digest" >&2
    printf '{}' > "$survey_f"
fi

# Feedback channel: role files newer than the .last-reviewed marker (the
# marker review-fleet-feedback bumps). Marker absent => everything is unread.
feedback_f="$workdir/feedback.txt"
: > "$feedback_f"
fb_dir="$FLEET_HOME/feedback"
marker="$fb_dir/.last-reviewed"
if [[ -d "$fb_dir" ]]; then
    for f in "$fb_dir"/*.md; do
        [[ -e "$f" ]] || continue
        if [[ ! -f "$marker" || "$f" -nt "$marker" ]]; then
            basename "$f" .md >> "$feedback_f"
        fi
    done
fi

# Marker age in whole days ("none" when the channel was never reviewed).
# The marker is a touch-file whose whole meaning is its mtime — the
# state.json generated_at rule doesn't apply here.
marker_age_days="none"
if [[ -f "$marker" ]]; then
    # GNU-first is load-bearing, not cosmetic: GNU's `-f` is --file-system and
    # reads its argument as a path, so `stat -f %m` prints a filesystem block
    # to *stdout* (which 2>/dev/null cannot suppress) before failing, and the
    # captured garbage aborts the arithmetic below under `set -e`. BSD stat
    # rejects `-c` on stderr only, so this order is safe on both hosts.
    marker_mtime=$(stat -c %Y "$marker" 2>/dev/null || stat -f %m "$marker" 2>/dev/null)
    if [[ -n "$marker_mtime" ]]; then
        marker_age_days=$(( ($(date +%s) - marker_mtime) / 86400 ))
    fi
fi

# PYTHONIOENCODING forces UTF-8 stdout for native-Windows consoles (cp1252
# default raises on the report's em-dash / middle-dot glyphs).
PYTHONIOENCODING=utf-8 python3 - "$manifest" "$workdir" "$feedback_f" "$marker_age_days" "$survey_f" "$FLEET_HOME/triage" \
    "$FLEET_HOME/logs/automerge-audit.log" "$FLEET_HOME/digest/automerge-cursor" "${FLEET_AUTOMERGE_LEDGER_END:-}" << 'PYEOF'
import base64
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.environ["FLEET_LIB_DIR"])
import fleet_github  # noqa: E402
import fleet_not_started  # noqa: E402

SHORT = {"jakildev/IrredenEngine": "engine", "jakildev/irreden": "game"}

# An approved PR's title still carrying [WIP] with no fleet:wip label is a
# desync the fleet's own labels never catch: GitHub squash-merge uses the
# title as the commit subject, so this ships [WIP] into master's permanent
# history unless a human strips it before merging.
WIP_TITLE_RE = re.compile(r"\[WIP\]")

# Drain thresholds: past these, a backlog cue flips to OVERDUE. Batches past
# ~a dozen tickets cost a full architect session, and rules sit unabsorbed
# while their mistakes recur.
CI_DRAIN_THRESHOLD = 12
UNTRIAGED_DRAIN_THRESHOLD = 12
FEEDBACK_STALE_DAYS = 14

# label -> human-readable decision tag; presence on an open PR/issue means
# a human (or human-cued architect) action is the only way it moves again.
DECISION_TAGS = {
    "fleet:needs-human": "needs human",
    "fleet:gated": "gated self-config edit",
    "fleet:human-deferred": "deferred to human",
    "fleet:design-blocked": "design answer needed",
    "fleet:steward-proposal": "steward proposal to answer",
    "fleet:state-drift": "state drift to reconcile",
    "fleet:triage-recommend": "triage verdict to review",
}
OWNER_VERDICT_LABELS = {
    "human:needs-fix", "human:blocker", "fleet:needs-fix", "fleet:has-nits",
    "fleet:semantic-conflict",
}

# pull_request filters that keep a workflow off some head pushes. A `types`
# list is a filter only when it drops one of GitHub's defaults.
PR_FILTER_KEYS = {"paths", "paths-ignore", "branches", "branches-ignore"}
DEFAULT_PR_TYPES = {"opened", "synchronize", "reopened"}
FAILED = {"failure", "timed_out", "startup_failure"}
WORKFLOW_DIR = ".github/workflows"
# The annotation title run_all.sh emits on a failed fleet-test run; its
# message is the failed suites, space-separated, each `<name>@<identity>`.
SUITES_ANNOTATION_TITLE = "fleet-tests failed suites"
UNITEMIZED = "?"

class Unreadable(Exception):
    pass


def gh_api(path):
    """The JSON at REST `path`; None on a 404."""
    try:
        run = fleet_github.run(["api", path], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Unreadable(f"gh api {path.split('?')[0]}: {e}") from e
    if run.returncode != 0:
        if "HTTP 404" in run.stderr:
            return None
        last = run.stderr.strip().splitlines()[-1:] or [f"exit {run.returncode}"]
        raise Unreadable(f"gh api {path.split('?')[0]}: {last[0]}")
    try:
        return json.loads(run.stdout)
    except ValueError as e:
        raise Unreadable(f"gh api {path.split('?')[0]}: not JSON") from e


def gh_api_list(path, key=None, per_page=100, max_pages=3):
    """Every item of the REST list at `path`, `key` naming the list inside an
    object response. A 404 is an empty list. A list still full at
    `max_pages` is Unreadable: its tail was never read."""
    items = []
    sep = "&" if "?" in path else "?"
    for page in range(1, max_pages + 1):
        query = f"{sep}per_page={per_page}" + (f"&page={page}" if page > 1 else "")
        body = gh_api(path + query)
        page_items = ((body or {}).get(key) if key else body) or []
        items.extend(page_items)
        if len(page_items) < per_page:
            return items
    raise Unreadable(f"gh api {path}: more than {per_page * max_pages} items")


def _flow_items(value):
    """The words of a flow sequence or scalar: `[a, 'b']` or `a`."""
    return re.findall(r"[A-Za-z_][\w-]*", value)


def _block(lines, start):
    """The lines after `lines[start]` indented deeper than it, and the index
    past them. Blank lines ride along."""
    indent = len(lines[start]) - len(lines[start].lstrip())
    end = start + 1
    while end < len(lines) and (not lines[end].strip()
                                or len(lines[end]) - len(lines[end].lstrip()) > indent):
        end += 1
    return lines[start + 1:end], end


def _mapping(lines):
    """`{key: (inline value, child lines)}` for the shallowest keys of a block,
    or None when the block is a sequence."""
    body = [line for line in lines if line.strip()]
    if not body:
        return {}
    if body[0].lstrip().startswith("- "):
        return None
    indent = min(len(line) - len(line.lstrip()) for line in body)
    keys, i = {}, 0
    while i < len(lines):
        line = lines[i]
        if line.strip() and len(line) - len(line.lstrip()) == indent:
            key, _, value = line.strip().partition(":")
            children, i = _block(lines, i)
            keys[key.strip().strip("'\"")] = (value.strip(), children)
        else:
            i += 1
    return keys


def pr_gate(text):
    """True when the workflow's pull_request trigger fires on every head push.
    Parsed without a YAML library: `on:` has a scalar, a list, and a mapping
    form, and the mapping's pull_request entry may carry filter keys."""
    lines = [re.sub(r"(^|\s)#.*", "", line).rstrip() for line in text.splitlines()]
    at = next((i for i, line in enumerate(lines)
               if re.match(r"""^["']?on["']?\s*:""", line)), None)
    if at is None:
        return False
    inline = lines[at].split(":", 1)[1].strip()
    if inline:
        return "pull_request" in _flow_items(inline)
    block, _ = _block(lines, at)
    events = _mapping(block)
    if events is None:
        return "pull_request" in [line.strip()[2:].strip().strip("'\"")
                                  for line in block if line.strip().startswith("- ")]
    if "pull_request" not in events:
        return False
    value, children = events["pull_request"]
    if value.startswith("{"):
        filters = {k.strip(): v for k, _, v in
                   (part.partition(":") for part in re.split(r",\s*(?![^\[]*\])",
                                                             value.strip("{}")))}
    elif value and value not in ("~", "null"):
        return False
    else:
        filters = {k: v if v else " ".join(c.strip() for c in ch)
                   for k, (v, ch) in (_mapping(children) or {}).items()}
    if PR_FILTER_KEYS & set(filters):
        return False
    return "types" not in filters or DEFAULT_PR_TYPES <= set(_flow_items(filters["types"]))


class GateReader:
    """One repo's gate set and each workflow's latest master conclusion, read
    once and shared by every approved PR in that repo."""

    def __init__(self, slug):
        self.slug = slug
        self.branch = None
        self.gates = None
        self.master = {}
        self.suites = {}
        self.started = {}
        self.not_started = {}

    def load(self):
        if self.gates is not None:
            return
        info = gh_api(f"repos/{self.slug}")
        if info is None:
            raise Unreadable(f"repos/{self.slug} not found")
        self.branch = info["default_branch"]
        listing = gh_api(f"repos/{self.slug}/contents/{WORKFLOW_DIR}?ref={self.branch}") or []
        gates = []
        for entry in listing:
            if entry.get("type") != "file" or not entry["name"].endswith((".yml", ".yaml")):
                continue
            blob = gh_api(f"repos/{self.slug}/contents/{entry['path']}?ref={self.branch}")
            if blob is None:
                raise Unreadable(f"{entry['path']} vanished mid-read")
            if pr_gate(base64.b64decode(blob["content"]).decode("utf-8", "replace")):
                gates.append(entry["path"])
        self.gates = sorted(gates)

    def master_run(self, path):
        """Master's latest completed run of the workflow at `path`, as GitHub
        returns it, or None when it never ran."""
        if path not in self.master:
            name = path.rsplit("/", 1)[-1]
            runs = gh_api(f"repos/{self.slug}/actions/workflows/{name}/runs"
                          f"?branch={self.branch}&status=completed&per_page=1")
            latest = (runs or {}).get("workflow_runs") or []
            self.master[path] = latest[0] if latest else None
        return self.master[path]

    def master_conclusion(self, path):
        run = self.master_run(path)
        if run and self.never_started(run):
            return "not started"
        return run["conclusion"] if run else "none"

    def never_started(self, run):
        """True when GitHub refused to start every job of `run` (fleet_not_started),
        recording the run in `not_started`. A run whose jobs or annotations
        cannot be read is an ordinary failure, never a suppressed one."""
        if run["conclusion"] != "failure":
            return False
        run_id = run["id"]
        if run_id not in self.started:
            try:
                jobs = gh_api_list(f"repos/{self.slug}/actions/runs/{run_id}/jobs", key="jobs")
                text = fleet_not_started.run_not_started_text(jobs, self.job_annotations)
            except Unreadable:
                text = None
            self.started[run_id] = text
            if text is not None:
                self.not_started[run_id] = (run.get("created_at") or "", text)
        return self.started[run_id] is not None

    def job_annotations(self, job_id):
        try:
            return gh_api_list(f"repos/{self.slug}/check-runs/{job_id}/annotations")
        except Unreadable:
            return None

    def not_starting_since(self):
        """`(first created_at, annotation)` of the earliest never-started run
        observed so far, or None."""
        if not self.not_started:
            return None
        run_id = min(self.not_started, key=lambda r: (self.not_started[r][0], r))
        return self.not_started[run_id]

    def failed_suites(self, run_id):
        """The `(suite, identity)` pairs a run's jobs annotated as failed, or
        None when no job left the annotation — an older run, or a workflow
        that does not emit it. A bare suite name reads as unitemized. A job's
        id is its check-run id."""
        if run_id in self.suites:
            return self.suites[run_id]
        found = None
        for job in gh_api_list(f"repos/{self.slug}/actions/runs/{run_id}/jobs", key="jobs"):
            for annotation in gh_api_list(f"repos/{self.slug}/check-runs/{job['id']}/annotations"):
                if annotation.get("title") == SUITES_ANNOTATION_TITLE:
                    found = found or set()
                    for token in (annotation.get("message") or "").split():
                        suite, _, identity = token.partition("@")
                        found.add((suite, identity or UNITEMIZED))
        self.suites[run_id] = found
        return found

    def own_failures(self, head_run, master_run):
        """The suites failing on the head run with no identical failure on
        master's, or None when either run carries no suite annotation."""
        head = self.failed_suites(head_run["id"])
        master = self.failed_suites(master_run["id"])
        if head is None or master is None:
            return None
        return {suite for suite, identity in head
                if identity == UNITEMIZED or (suite, identity) not in master}

    def holds(self, sha):
        """`(holds, notes, awaiting, head_not_started)` for head `sha`. A run is
        read by head sha, never by branch: a branch with any green run reads
        green even when its latest push triggered none. A cancelled run is no
        reading. `awaiting` is the no-completed-run holds, kept apart because
        they are moot once the repo shows its jobs never start;
        `head_not_started` says a failed head run was one of those."""
        self.load()
        runs = gh_api_list(f"repos/{self.slug}/actions/runs?head_sha={sha}", key="workflow_runs")
        latest = {}
        for run in runs:
            if run.get("status") != "completed" or run.get("conclusion") == "cancelled":
                continue
            path = run.get("path", "").split("@", 1)[0]
            if path not in latest or (run["created_at"], run["id"]) > (
                    latest[path]["created_at"], latest[path]["id"]):
                latest[path] = run
        short = sha[:9]
        awaiting = [f"{path} has no completed run on head {short} — Update branch to trigger it"
                    for path in self.gates if path not in latest]
        for path in self.gates:
            if path not in latest:
                master = self.master_run(path)
                if master is not None:
                    self.never_started(master)
        holds = []
        notes = []
        head_not_started = False
        for path, run in sorted(latest.items()):
            master = self.master_run(path)
            master_failed = (master is not None and master.get("conclusion") in FAILED
                             and not self.never_started(master))
            if run["conclusion"] in FAILED:
                if self.never_started(run):
                    head_not_started = True
                    continue
                line = f"{path} failed on head {short} (master: {self.master_conclusion(path)})"
                own = self.own_failures(run, master) if master_failed else None
                if own is not None and not own:
                    notes.append(f"{path} failed on head {short} with the same failures as "
                                 "master — inherited, not this PR's to fix")
                    continue
                if own:
                    line += (f" — {len(own)} suite(s) not failing this way on master: "
                             f"{' '.join(sorted(own))}")
                holds.append(line)
            elif master_failed and (master.get("created_at") or "") > (run.get("created_at") or ""):
                holds.append(f"{path} passed on head {short} at {run.get('created_at')}, but "
                             f"master's later run ({master.get('created_at')}) failed — "
                             "Update branch to re-run before merging")
        return holds, notes, awaiting, head_not_started


def gate_holds(reader, pr):
    """`(holds, notes, awaiting, head_not_started)` for `pr`; an unreadable
    answer is a hold of its own."""
    sha = pr.get("headRefOid")
    if not sha:
        return ["gate coverage unreadable (no head sha)"], [], [], False
    try:
        return reader.holds(sha)
    except (Unreadable, KeyError, TypeError, ValueError) as e:
        return [f"gate coverage unreadable ({e})"], [], [], False


def merge_box_holds(pr, holds, notes, refused):
    """Holds from GitHub's own merge-box state that the run reading above did
    not already account for."""
    state = pr.get("mergeStateStatus")
    if state == "BEHIND":
        return ["behind master — Update branch (the branch rule requires it)"]
    accounted = (notes or refused
                 or any(" failed on head " in h or "unreadable" in h for h in holds))
    if state == "UNSTABLE" and not accounted:
        return ["GitHub reports a check on the head that has not passed (mergeStateStatus "
                "UNSTABLE: failed or still running) that no completed run above accounts for"]
    return []


workdir = sys.argv[2]

repos = []
with open(sys.argv[1], encoding="utf-8") as manifest_file:
    for line in manifest_file:
        slug, idx = line.rstrip("\n").split("\t")
        with open(os.path.join(workdir, f"{idx}-prs.json"), encoding="utf-8") as f:
            prs = json.load(f)
        with open(os.path.join(workdir, f"{idx}-issues.json"), encoding="utf-8") as f:
            issues = json.load(f)
        repos.append((SHORT.get(slug, slug), prs, issues, GateReader(slug)))

with open(sys.argv[3], encoding="utf-8") as f:
    unread_roles = [line.strip() for line in f if line.strip()]

marker_age_days = None if sys.argv[4] == "none" else int(sys.argv[4])
try:
    with open(sys.argv[5], encoding="utf-8") as survey_file:
        survey_report = json.load(survey_file)
except (OSError, ValueError):
    survey_report = {}
triage_dir = sys.argv[6]


def names(item):
    return [label["name"] for label in item.get("labels", [])]


merge_queue = []   # (repo, item, has_nits, holds, notes, wip_title_mismatch)
decisions = []     # (repo, kind, item, tags)
not_starting = []  # (repo, first created_at, annotation)
coding_improvements = 0
untriaged = []
status = []        # (repo, open_prs, queued, needs_plan)

for repo, prs, issues, reader in repos:
    queued = needs_plan = 0
    approved = []  # (pr, has_nits, gate, notes, awaiting, head_not_started, smoke_debt, wip)
    for pr in prs:
        labels = names(pr)
        if "fleet:approved" in labels:
            gate, notes, awaiting, head_not_started = gate_holds(reader, pr)
            # A smoke label is smoke debt that rides onto the merged PR, not
            # a merge hold (FLEET-CROSS-HOST-SMOKE.md § "Ledger, not a gate").
            smoke_debt = [
                f"{label} rides onto the merged PR as smoke debt (not a gate)"
                for label in labels
                if label.startswith("fleet:needs-") and label.endswith("-smoke")
            ]
            wip_mismatch = bool(WIP_TITLE_RE.search(pr["title"])) and "fleet:wip" not in labels
            approved.append((pr, "fleet:has-nits" in labels, gate, notes, awaiting,
                             head_not_started, smoke_debt, wip_mismatch))
        tags = [DECISION_TAGS[label] for label in labels if label in DECISION_TAGS]
        owner_labels = [label for label in labels if label.startswith("fleet:claim-")]
        owner_verdicts = sorted(OWNER_VERDICT_LABELS & set(labels))
        if owner_labels and owner_verdicts:
            tags.append(
                f"persistent owner {owner_labels[0]} with outstanding "
                f"{', '.join(owner_verdicts)}"
            )
        if tags:
            decisions.append((repo, "PR", pr, tags))
    # Every PR's runs are read before any is filtered: whether the repo's jobs
    # start at all is a property of the repo, not of the PR read first.
    first_not_started = reader.not_starting_since()
    if first_not_started:
        not_starting.append((repo, *first_not_started))
    for pr, has_nits, gate, notes, awaiting, head_not_started, smoke_debt, wip_mismatch in approved:
        holds = (gate if first_not_started else awaiting + gate)
        # A run that never started, or one the repo cannot start, is what
        # GitHub's UNSTABLE is reporting.
        refused = head_not_started or bool(first_not_started and awaiting)
        holds += merge_box_holds(pr, holds, notes, refused)
        merge_queue.append((repo, pr, has_nits, holds, list(notes) + smoke_debt, wip_mismatch))
    for issue in issues:
        labels = names(issue)
        tags = [DECISION_TAGS[label] for label in labels if label in DECISION_TAGS]
        if tags:
            decisions.append((repo, "issue", issue, tags))
        if "fleet:coding-improvement" in labels:
            coding_improvements += 1
        if not any(label.startswith(("fleet:", "human:")) for label in labels):
            untriaged.append((repo, issue))
        queued += "fleet:queued" in labels
        needs_plan += "fleet:needs-plan" in labels
    status.append((repo, len(prs), queued, needs_plan))

closeouts = []
for repo, report in (survey_report.get("repos") or {}).items():
    queue = report.get("queue") or {}
    for row in queue.get("ghost") or []:
        number = int(str(row["id"]).lstrip("#"))
        parks = [park["pr"] for park in report.get("parks") or []
                 if number in {int(key) for key, value in (park.get("issues") or {}).items()
                               if str(value).startswith("ghost") }]
        epics = [epic["epic"] for epic in report.get("epics") or []
                 if str((epic.get("left") or {}).get(str(number),
                        (epic.get("left") or {}).get(number, ""))).startswith("ghost")]
        closeouts.append((repo, number, row, parks, epics))

# Graduated triage stamps (triage-protocol.md § Graduation), each seen once.
# The log is append-only, so a byte offset into it is a total order that
# timestamps (whole seconds, possibly out of order) are not. The seen marker
# holds one offset per repo; a digest reads the complete lines past its
# repos' offsets in file order, then moves only those offsets, so a scoped
# run leaves the other repo's stamps unread. A line still being appended has
# no newline yet and waits for the next digest. An offset past the end of
# the file, or off a line boundary, means the log was replaced: that repo
# reads it from the start. A line without a timestamp predates the
# graduation writer and never renders.
seen_marker = os.path.join(triage_dir, ".decisions-seen")
try:
    with open(seen_marker, encoding="utf-8") as f:
        seen = json.load(f)
except (OSError, ValueError):
    seen = {}
if not isinstance(seen, dict):
    seen = {}
try:
    with open(os.path.join(triage_dir, "log.jsonl"), "rb") as f:
        log_bytes = f.read()
except OSError:
    log_bytes = b""
log_end = log_bytes.rfind(b"\n") + 1
in_scope = {repo for repo, _, _, _ in repos}
starts = {}
for repo in in_scope:
    offset = seen.get(repo)
    on_boundary = (isinstance(offset, int) and 0 <= offset <= log_end
                   and (offset == 0 or log_bytes[offset - 1:offset] == b"\n"))
    starts[repo] = offset if on_boundary else 0
titles = {(repo, issue["number"]): issue["title"]
          for repo, _, issues, _ in repos for issue in issues}
stamps = []
line_end = min(starts.values(), default=log_end)
while line_end < log_end:
    line_start = line_end
    line_end = log_bytes.index(b"\n", line_start) + 1
    try:
        entry = json.loads(log_bytes[line_start:line_end])
    except ValueError:
        continue
    if not isinstance(entry, dict):
        continue
    repo = SHORT.get(entry.get("repo"), entry.get("repo"))
    ts = entry.get("ts") or ""
    if (repo in starts and line_start >= starts[repo] and ts
            and "fleet:agent-approved" in (entry.get("labels") or [])):
        stamps.append((ts, repo, entry))
advanced = {**seen, **{repo: log_end for repo in in_scope}}

# Auto-merge ledger (FLEET.md § Who merges), each merge and rollback seen in
# exactly one SUCCESSFUL digest. This digest is stateless about it: the
# cursor (a byte offset) is written by fleet-digest-tick after the digest
# lands, and the tick pins the ledger end it hands us in
# FLEET_AUTOMERGE_LEDGER_END so an event appended mid-run waits for the next
# tick. A hand-run digest reads from the cursor to the current end and moves
# nothing. An off-boundary cursor means the ledger was replaced: read it all.
automerge_ledger, automerge_cursor_path, automerge_end_arg = sys.argv[7], sys.argv[8], sys.argv[9]
try:
    with open(automerge_ledger, "rb") as f:
        am_bytes = f.read()
except OSError:
    am_bytes = b""
am_end = am_bytes.rfind(b"\n") + 1
if automerge_end_arg.isdigit() and int(automerge_end_arg) <= am_end:
    am_end = int(automerge_end_arg)
try:
    with open(automerge_cursor_path, encoding="utf-8") as f:
        am_start = int(f.read().strip() or 0)
except (OSError, ValueError):
    am_start = 0
if not (0 <= am_start <= am_end and (am_start == 0 or am_bytes[am_start - 1:am_start] == b"\n")):
    am_start = 0
automerges = []
for raw in am_bytes[am_start:am_end].split(b"\n"):
    if not raw.strip():
        continue
    try:
        entry = json.loads(raw)
    except ValueError:
        continue
    if not isinstance(entry, dict):
        continue
    repo = SHORT.get(entry.get("repo"), entry.get("repo"))
    if repo in in_scope and entry.get("event") in ("merge", "rollback", "merge-failed"):
        automerges.append((repo, entry))

total = len(merge_queue) + len(decisions) + len(closeouts)
scope = "+".join(repo for repo, _, _, _ in repos)
print(f"fleet-decisions: {total} decision(s) waiting   [{scope}]")

if not_starting:
    print()
    for repo, since, annotation in not_starting:
        print(f'actions not starting on {repo} since {since}: "{annotation}"')

if merge_queue:
    print(f"\n## Merge queue ({len(merge_queue)})")
    for repo, pr, has_nits, holds, notes, wip_mismatch in merge_queue:
        nits = "+nits" if has_nits else ""
        print(f"  {repo} PR #{pr['number']}  {pr['title']}  [approved{nits}]")
        for hold in holds:
            print(f"      hold: {hold}")
        for note in notes:
            print(f"      note: {note}")
        if wip_mismatch:
            print(
                "      warn: title still carries [WIP] with no fleet:wip label — "
                "strip before merge (squash uses the title as the commit subject)"
            )

if decisions:
    print(f"\n## Decisions ({len(decisions)})")
    for repo, kind, item, tags in decisions:
        print(f"  {repo} {kind} #{item['number']}  {item['title']}  [{'; '.join(tags)}]")

if closeouts:
    print(f"\n## Shadowed queued close-outs ({len(closeouts)})")
    for repo, number, row, parks, epics in closeouts:
        slug = "jakildev/IrredenEngine" if repo == "engine" else "jakildev/irreden"
        print(f"  {repo} issue #{number}  shadowed by PR #{row['shadow_pr']}  "
              f"declined: {row['reason']}")
        print(f"      close: gh issue close {number} --repo {slug}")
        for dependent in row.get("blocked_by_impacts") or []:
            print(f"      impact: issue #{dependent} declares Blocked by: #{number}")
        for pr in parks:
            print(f"      impact: PR #{pr} declares Parked-until: #{number}")
        for epic in epics:
            print(f"      impact: epic #{epic} has unchecked child #{number}")

if stamps:
    print(f"\n## Agent-approved since last digest ({len(stamps)})")
    for ts, repo, entry in stamps:
        number = entry.get("issue")
        title = titles.get((repo, number), "(not open)")
        print(f"  {repo} issue #{number}  {title}  "
              f"[{entry.get('class') or '?'} via {entry.get('mode') or 'apply'}, {ts}]")

if automerges:
    print(f"\n## Auto-merged since last digest ({len(automerges)})")
    for repo, entry in automerges:
        kind = entry.get("event")
        if kind == "merge":
            who = (entry.get("provenance") or {}).get("review_author") or "?"
            print(f"  {repo} PR #{entry.get('pr')}  {entry.get('title') or ''}  "
                  f"[auto-merged class={entry.get('class') or '?'}, approved by {who}, "
                  f"{entry.get('ts') or '?'}]")
        elif kind == "rollback":
            print(f"  {repo} PR #{entry.get('pr')}  ROLLED BACK by revert PR "
                  f"#{entry.get('revert_pr')}  [{entry.get('ts') or '?'}] — hold the lane's "
                  "widening until the cause is understood")
        else:
            print(f"  {repo} PR #{entry.get('pr')}  merge refused by GitHub  "
                  f"[{entry.get('ts') or '?'}] {str(entry.get('error') or '')[:80]}")

if log_end and advanced != seen:
    try:
        os.makedirs(triage_dir, exist_ok=True)
        tmp = f"{seen_marker}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(advanced, f, sort_keys=True)
            f.write("\n")
        os.replace(tmp, seen_marker)
    except OSError as e:
        if stamps:
            print(f"      warn: could not advance the seen marker ({e}); these render again")

cues = []
if coding_improvements >= CI_DRAIN_THRESHOLD:
    cues.append(
        f"fleet:coding-improvement: {coding_improvements} open — OVERDUE "
        f"(drain threshold {CI_DRAIN_THRESHOLD}): triage cost grows with "
        "batch size and filed rules sit unabsorbed while their mistakes "
        "recur; cue `triage-coding-improvements` (or an architect extended "
        "sweep, triage-protocol.md) now"
    )
elif coding_improvements:
    cues.append(
        f"fleet:coding-improvement: {coding_improvements} open — "
        "cue `triage-coding-improvements` when ready"
    )
if untriaged:
    newest = ", ".join(
        f"{repo} #{issue['number']}" for repo, issue in untriaged[:5]
    )
    if len(untriaged) >= UNTRIAGED_DRAIN_THRESHOLD:
        cues.append(
            f"untriaged (no state labels): {len(untriaged)} awaiting triage — "
            f"OVERDUE (drain threshold {UNTRIAGED_DRAIN_THRESHOLD}): {newest} — "
            "the human-cued triage sweep (docs/agents/triage-protocol.md) is the drain"
        )
    else:
        cues.append(
            f"untriaged (no state labels): {len(untriaged)} awaiting triage — {newest}"
        )
if unread_roles:
    unread = (
        f"feedback channel: {len(unread_roles)} role file(s) unread "
        f"({', '.join(sorted(unread_roles))})"
    )
    if marker_age_days is None or marker_age_days >= FEEDBACK_STALE_DAYS:
        age = (
            "never reviewed"
            if marker_age_days is None
            else f"last reviewed {marker_age_days}d ago"
        )
        cues.append(
            f"{unread} — OVERDUE ({age}, stale threshold "
            f"{FEEDBACK_STALE_DAYS}d): cue `review-fleet-feedback`"
        )
    else:
        cues.append(f"{unread} — cue `review-fleet-feedback`")
if cues:
    print("\n## Cues")
    for cue in cues:
        print(f"  {cue}")

print("\n## Status")
for repo, open_prs, queued, needs_plan in status:
    print(f"  {repo}: {open_prs} open PR(s) · {queued} queued · {needs_plan} needs-plan")

if total == 0 and not cues and not stamps:
    print("\n  nothing is waiting on you.")
PYEOF
