from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from fleet_codex_doctor import DISPLAY_PROBE  # noqa: E402

PROFILES = ("build", "fleet-tests", "render-verify")
TERMINAL = ("succeeded", "failed", "killed")
# render-verify options a detached run may pass. --build-dir selects the
# directory the demo executable is resolved from; --update-references and
# --force rewrite committed references behind a prompt the closed stdin
# cannot answer.
RENDER_VERIFY_VALUE_OPTS = {"--target": r"[A-Za-z0-9_]+", "--demo": r"[A-Za-z0-9_]+",
                            "--warmup": r"[0-9]+", "--timeout": r"[0-9]+",
                            "--demo-arg": None}
RENDER_VERIFY_FLAGS = ("--all", "--no-build")
NAME_RE = re.compile(r"[A-Za-z0-9._-]{1,40}")
JOB_ID_RE = re.compile(r"[0-9]{8}T[0-9]{6}Z-[a-z-]+-[0-9a-f]{6}")
STARTUP_TIMEOUT = 30.0
DISPLAY_PROBE_TIMEOUT = 10.0
CANCEL_GRACE = 10.0
POLL = 0.2
IS_WINDOWS = os.name == "nt"


class UsageError(Exception):
    pass


def die(message, code=2):
    print(f"fleet-jobs: {message}", file=sys.stderr)
    sys.exit(code)


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def script_repo():
    return Path(os.path.realpath(__file__)).parents[2]


def checkout_root(cwd):
    try:
        out = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    top = out.stdout.strip()
    return Path(top) if out.returncode == 0 and top else None


def pane_name(cwd):
    assigned = os.environ.get("FLEET_ASSIGNED_WORKTREE", "").rstrip("/\\")
    if assigned:
        name = re.split(r"[/\\]", assigned)[-1]
    else:
        top = checkout_root(cwd)
        parts = top.parts if top else ()
        if len(parts) < 3 or parts[-3:-1] != (".claude", "worktrees"):
            raise UsageError("no pane: FLEET_ASSIGNED_WORKTREE is unset and the cwd is not "
                             "a .claude/worktrees/<name> checkout")
        name = parts[-1]
    if not NAME_RE.fullmatch(name):
        raise UsageError(f"invalid pane name {name!r}")
    return name


def pane_dir(cwd):
    state = Path(os.environ.get("FLEET_STATE_DIR") or Path.home() / ".fleet" / "state")
    return state / "jobs" / pane_name(cwd)


def job_dir_for(job_id, cwd):
    if not JOB_ID_RE.fullmatch(job_id):
        raise UsageError(f"malformed job id {job_id!r}")
    path = pane_dir(cwd) / job_id
    if not (path / "meta.json").is_file():
        raise UsageError(f"no job {job_id} in this pane")
    return path


def write_atomic(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=1, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
    for attempt in range(50):
        try:
            os.replace(tmp, path)
            return
        except PermissionError:
            # Native Windows refuses a replace while a reader holds the target.
            if not IS_WINDOWS or attempt == 49:
                raise
            time.sleep(0.05)


def read_meta(job_dir):
    # A reader racing the replace on native Windows can see a sharing error.
    for attempt in range(50):
        try:
            return json.loads((job_dir / "meta.json").read_text(encoding="utf-8"))
        except PermissionError:
            if not IS_WINDOWS or attempt == 49:
                raise
            time.sleep(0.05)
    raise AssertionError("unreachable")


# --- profiles ---------------------------------------------------------------

def split_passthrough(args, profile):
    if "--" not in args:
        raise UsageError(f"{profile} takes its arguments after --")
    cut = args.index("--")
    return args[:cut], args[cut + 1:]


def take_name(opts, profile):
    name, rest, i = profile, [], 0
    while i < len(opts):
        opt = opts[i]
        if opt == "--name" or opt.startswith("--name="):
            value = opt[7:] if opt.startswith("--name=") else (
                opts[i + 1] if i + 1 < len(opts) else "")
            if not NAME_RE.fullmatch(value):
                raise UsageError("--name needs a value matching [A-Za-z0-9._-]{1,40}")
            name = value
            i += 1 if opt.startswith("--name=") else 2
        else:
            rest.append(opt)
            i += 1
    return name, rest


def interpreter_for(script):
    # A bash script cannot be exec'd directly by native-Windows Python.
    if IS_WINDOWS:
        bash = shutil.which("bash")
        if not bash:
            raise UsageError("bash not found on PATH")
        return [bash, str(script)]
    return [str(script)]


def validate_render_verify(passthrough):
    i = 0
    while i < len(passthrough):
        arg = passthrough[i]
        key, eq, inline = arg.partition("=")
        if key in RENDER_VERIFY_FLAGS and not eq:
            i += 1
            continue
        if key not in RENDER_VERIFY_VALUE_OPTS:
            raise UsageError(f"render-verify option {arg!r} is not supported by the job profile")
        if eq:
            value, i = inline, i + 1
        elif i + 1 < len(passthrough):
            value, i = passthrough[i + 1], i + 2
        else:
            raise UsageError(f"{key} needs a value")
        pattern = RENDER_VERIFY_VALUE_OPTS[key]
        if (pattern and not re.fullmatch(pattern, value)) or (not pattern and not value):
            raise UsageError(f"{key} value {value!r} is not allowed")


def resolve(profile, args, cwd):
    """Validated (argv, display name) for a profile; raises UsageError."""
    if profile not in PROFILES:
        raise UsageError(f"unknown profile {profile!r} (profiles: {', '.join(PROFILES)})")
    if profile == "fleet-tests":
        name, rest = take_name(args, profile)
        only = []
        i = 0
        while i < len(rest):
            opt = rest[i]
            if opt == "--only" and i + 1 < len(rest) and rest[i + 1]:
                only, i = ["--only", rest[i + 1]], i + 2
            elif opt.startswith("--only=") and len(opt) > 7:
                only, i = ["--only", opt[7:]], i + 1
            else:
                raise UsageError(f"fleet-tests option {opt!r} is not supported")
        top = checkout_root(cwd)
        script = top / "scripts/fleet/tests/run_all.sh" if top else None
        if not script or not script.is_file():
            raise UsageError("cwd is not a checkout with scripts/fleet/tests/run_all.sh")
        bash = shutil.which("bash") or "bash"
        return [bash, str(script), *only], name
    opts, passthrough = split_passthrough(args, profile)
    name, rest = take_name(opts, profile)
    if rest:
        raise UsageError(f"{profile} option {rest[0]!r} is not supported")
    if profile == "build":
        script = script_repo() / "engine/tools/bin/ir-build"
        if not script.is_file():
            raise UsageError(f"ir-build not found at {script}")
        return interpreter_for(script) + passthrough, name
    validate_render_verify(passthrough)
    top = checkout_root(cwd)
    script = top / "scripts/render-verify.py" if top else None
    if not script or not script.is_file():
        raise UsageError("cwd is not a checkout with scripts/render-verify.py")
    return [sys.executable, str(script), *passthrough], name


# --- process identity -------------------------------------------------------
# Identity is PID plus process start time. A PID alone may have been recycled
# for an unrelated process; any probe failure reports None ("cannot vouch").

class _ProcBsdInfo(ctypes.Structure):
    # struct proc_bsdinfo, the PROC_PIDTBSDINFO flavor.
    _fields_ = [("flags", ctypes.c_uint32), ("status", ctypes.c_uint32),
                ("xstatus", ctypes.c_uint32), ("pid", ctypes.c_uint32),
                ("ppid", ctypes.c_uint32), ("ids", ctypes.c_uint32 * 7),
                ("comm", ctypes.c_char * 16), ("name", ctypes.c_char * 32),
                ("nfiles", ctypes.c_uint32), ("pgid", ctypes.c_uint32),
                ("process_fields", ctypes.c_uint32 * 4),
                ("start_tvsec", ctypes.c_uint64), ("start_tvusec", ctypes.c_uint64)]


_DARWIN_SZOMB = 5
_libproc = None


def _darwin_info(pid):
    global _libproc
    if _libproc is None:
        _libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
    info = _ProcBsdInfo()
    size = _libproc.proc_pidinfo(int(pid), 3, ctypes.c_uint64(0), ctypes.byref(info),
                                 ctypes.sizeof(info))
    if size != ctypes.sizeof(info) or int(info.pid) != int(pid):
        return None
    return info


def _linux_stat(pid):
    try:
        text = Path(f"/proc/{int(pid)}/stat").read_text(encoding="utf-8")
    except OSError:
        return None
    # Fields after the parenthesized comm: state=0, ppid=1, pgrp=2, starttime=19.
    return text[text.rfind(")") + 2:].split()


class _JobAccounting(ctypes.Structure):
    # JOBOBJECT_BASIC_ACCOUNTING_INFORMATION
    _fields_ = [("times", ctypes.c_int64 * 4), ("page_faults", ctypes.c_uint32),
                ("total", ctypes.c_uint32), ("active", ctypes.c_uint32),
                ("terminated", ctypes.c_uint32)]


class _ThreadEntry(ctypes.Structure):
    # THREADENTRY32
    _fields_ = [("size", ctypes.c_uint32), ("usage", ctypes.c_uint32),
                ("thread_id", ctypes.c_uint32), ("owner_pid", ctypes.c_uint32),
                ("base_priority", ctypes.c_int32), ("delta_priority", ctypes.c_int32),
                ("flags", ctypes.c_uint32)]


_kernel32_dll = None


def _kernel32():
    global _kernel32_dll
    if _kernel32_dll is None:
        k = ctypes.WinDLL("kernel32", use_last_error=True)
        # Declared so a 64-bit HANDLE is not truncated to a C int.
        handle = ctypes.c_void_p
        k.OpenProcess.restype = handle
        k.OpenProcess.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
        k.GetExitCodeProcess.argtypes = [handle, ctypes.POINTER(ctypes.c_ulong)]
        k.GetProcessTimes.argtypes = [handle] + [ctypes.POINTER(ctypes.c_ulonglong)] * 4
        k.CloseHandle.argtypes = [handle]
        k.CreateJobObjectW.restype = handle
        k.CreateJobObjectW.argtypes = [ctypes.c_void_p, ctypes.c_wchar_p]
        k.AssignProcessToJobObject.argtypes = [handle, handle]
        k.TerminateJobObject.argtypes = [handle, ctypes.c_uint]
        k.QueryInformationJobObject.argtypes = [handle, ctypes.c_int, ctypes.c_void_p,
                                                ctypes.c_ulong, ctypes.c_void_p]
        k.CreateToolhelp32Snapshot.restype = handle
        k.CreateToolhelp32Snapshot.argtypes = [ctypes.c_ulong, ctypes.c_ulong]
        k.Thread32First.argtypes = [handle, ctypes.c_void_p]
        k.Thread32Next.argtypes = [handle, ctypes.c_void_p]
        k.OpenThread.restype = handle
        k.OpenThread.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
        k.ResumeThread.restype = ctypes.c_ulong
        k.ResumeThread.argtypes = [handle]
        _kernel32_dll = k
    return _kernel32_dll


def _windows_identity(pid):
    kernel32 = _kernel32()
    handle = kernel32.OpenProcess(0x1000, False, int(pid))  # QUERY_LIMITED_INFORMATION
    if not handle:
        return None
    try:
        code = ctypes.c_ulong()
        if not kernel32.GetExitCodeProcess(handle, ctypes.byref(code)) or code.value != 259:
            return None  # 259 = STILL_ACTIVE
        times = [ctypes.c_ulonglong() for _ in range(4)]
        if not kernel32.GetProcessTimes(handle, *(ctypes.byref(t) for t in times)):
            return None
        return f"win:{times[0].value}"
    finally:
        kernel32.CloseHandle(handle)


def identity(pid):
    """Start identity of a live, non-zombie pid, or None."""
    try:
        if sys.platform == "darwin":
            info = _darwin_info(pid)
            if info is None or info.status == _DARWIN_SZOMB:
                return None
            return f"darwin:{info.start_tvsec}.{info.start_tvusec:06d}"
        if sys.platform.startswith("linux"):
            fields = _linux_stat(pid)
            if not fields or fields[0] in ("Z", "X"):
                return None
            return f"linux:{fields[19]}"
        if IS_WINDOWS:
            return _windows_identity(pid)
    except (OSError, ValueError, IndexError, AttributeError):
        return None
    return None


def _process_table():
    """{pid: (ppid, pgid, uid)} for every process the platform probe can read."""
    table = {}
    if sys.platform.startswith("linux"):
        for entry in Path("/proc").iterdir():
            if entry.name.isdigit():
                fields = _linux_stat(entry.name)
                with contextlib.suppress(OSError):
                    if fields:
                        table[int(entry.name)] = (int(fields[1]), int(fields[2]),
                                                  entry.stat().st_uid)
    elif sys.platform == "darwin":
        _darwin_info(os.getpid())  # loads libproc
        count = _libproc.proc_listallpids(None, 0)
        pids = (ctypes.c_int * max(count * 2, 1))()
        count = _libproc.proc_listallpids(pids, ctypes.sizeof(pids))
        for pid in pids[:max(count, 0)]:
            info = _darwin_info(pid)
            if info is not None:
                table[int(info.pid)] = (int(info.ppid), int(info.pgid), int(info.ids[0]))
    return table


def _subtree(table, root):
    """Every pid below root in a _process_table, root excluded."""
    children = {}
    for child, (parent, *_) in table.items():
        children.setdefault(parent, []).append(child)
    found, pending = [], [root]
    while pending:
        below = children.get(pending.pop(), [])
        found += below
        pending += below
    return found


def descendants(root):
    """(pid, identity) of every live descendant of root, root excluded."""
    try:
        table = _process_table()
    except (OSError, AttributeError):
        return []
    return [(pid, ident) for pid in _subtree(table, root) if (ident := identity(pid))]


_libc_dll = None


def _libc():
    global _libc_dll
    if _libc_dll is None:
        _libc_dll = ctypes.CDLL(None, use_errno=True)
    return _libc_dll


_procargs = None


def _darwin_environ(pid):
    # KERN_PROCARGS2: argc, the exec path, argv, then the exec-time environment.
    global _procargs
    if _procargs is None:
        _procargs = ctypes.create_string_buffer(1 << 20)
    libc, buf = _libc(), _procargs
    mib = (ctypes.c_int * 3)(1, 49, int(pid))
    size = ctypes.c_size_t(len(buf))
    if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, ctypes.c_size_t(0)):
        return []
    return ctypes.string_at(buf, size.value).split(b"\0")


def _environ(pid):
    """Exec-time environment entries of pid (with argv on macOS); [] when unreadable."""
    try:
        if sys.platform == "darwin":
            return _darwin_environ(pid)
        return Path(f"/proc/{int(pid)}/environ").read_bytes().split(b"\0")
    except OSError:
        return []


class _ProcFdInfo(ctypes.Structure):
    _fields_ = [("fd", ctypes.c_int32), ("type", ctypes.c_uint32)]


_vnode_info = ctypes.create_string_buffer(4096)


def _file_key(st_dev, st_ino):
    # macOS reports a vnode's device as uint32 but os.stat as a signed dev_t.
    return st_dev & 0xFFFFFFFF, st_ino


def _written_files(pid):
    """_file_key of every file pid holds open for writing; empty when unreadable.
    A reader such as a wait client is not a writer."""
    found = set()
    if sys.platform == "darwin":
        need = _libproc.proc_pidinfo(int(pid), 1, ctypes.c_uint64(0), None, 0)  # LISTFDS
        if need <= 0:
            return found
        fds = (_ProcFdInfo * (need // ctypes.sizeof(_ProcFdInfo) + 32))()
        got = _libproc.proc_pidinfo(int(pid), 1, ctypes.c_uint64(0), fds, ctypes.sizeof(fds))
        for entry in fds[:max(got, 0) // ctypes.sizeof(_ProcFdInfo)]:
            # PROX_FDTYPE_VNODE; struct vnode_fdinfo starts with the uint32
            # fi_openflags (FWRITE = 2) and puts the uint32 vst_dev at byte 24
            # and the uint64 vst_ino at byte 32.
            if (entry.type == 1 and _libproc.proc_pidfdinfo(
                    int(pid), entry.fd, 1, _vnode_info, len(_vnode_info)) >= 40
                    and int.from_bytes(_vnode_info.raw[0:4], sys.byteorder) & 2):
                found.add(_file_key(int.from_bytes(_vnode_info.raw[24:28], sys.byteorder),
                                    int.from_bytes(_vnode_info.raw[32:40], sys.byteorder)))
        return found
    try:
        for fd in Path(f"/proc/{int(pid)}/fd").iterdir():
            with contextlib.suppress(OSError, ValueError, AttributeError):
                info = Path(f"/proc/{int(pid)}/fdinfo/{fd.name}").read_text(encoding="utf-8")
                flags = int(re.search(r"^flags:\s*([0-7]+)", info, re.M).group(1), 8)
                if flags & (os.O_WRONLY | os.O_RDWR):
                    st = fd.stat()
                    found.add(_file_key(st.st_dev, st.st_ino))
    except OSError:
        pass
    return found


def job_marks(job_id, log_path):
    """(environment cookie, log file key) that identify the job's processes.

    Every process the child starts inherits the cookie and, unless it closes
    it, the writable log descriptor; both survive a descendant leaving the
    child's process group (setsid). macOS hides a platform binary's
    environment, so the log key is what finds a /bin tool still writing it.
    """
    st = os.stat(log_path)
    cookie = f"FLEET_JOB_{re.sub(r'[^A-Za-z0-9]', '_', job_id)}=1"
    return cookie, _file_key(st.st_dev, st.st_ino)


def _responsible(pid):
    """macOS: the pid TCC holds responsible for pid, or None. Every process a
    disclaimed process starts names it, through fork, exec, setsid and
    reparenting, while it lives."""
    if sys.platform != "darwin":
        return None
    return _libc().responsibility_get_pid_responsible_for_pid(int(pid))


def spawn_disclaimed(argv, cwd, stdin_fd, stdout_fd):
    """macOS: posix_spawn argv in a new session as its own responsible
    process, stdin from stdin_fd, stdout and stderr to stdout_fd, no other
    descriptor inherited. Returns the pid; raises OSError."""
    libc = _libc()
    attr, actions = ctypes.c_void_p(), ctypes.c_void_p()
    libc.posix_spawnattr_init(ctypes.byref(attr))
    libc.posix_spawn_file_actions_init(ctypes.byref(actions))
    try:
        setsid_cloexec = 0x0400 | 0x4000  # POSIX_SPAWN_SETSID | POSIX_SPAWN_CLOEXEC_DEFAULT
        steps = (
            lambda: libc.posix_spawnattr_setflags(ctypes.byref(attr),
                                                  ctypes.c_short(setsid_cloexec)),
            lambda: libc.responsibility_spawnattrs_setdisclaim(ctypes.byref(attr), 1),
            lambda: libc.posix_spawn_file_actions_adddup2(ctypes.byref(actions), stdin_fd, 0),
            lambda: libc.posix_spawn_file_actions_adddup2(ctypes.byref(actions), stdout_fd, 1),
            lambda: libc.posix_spawn_file_actions_adddup2(ctypes.byref(actions), stdout_fd, 2),
            lambda: libc.posix_spawn_file_actions_addchdir_np(ctypes.byref(actions),
                                                              os.fsencode(cwd)),
        )
        for step in steps:
            if rc := step():
                raise OSError(rc, os.strerror(rc))
        args = [os.fsencode(a) for a in argv]
        env = [f"{k}={v}".encode() for k, v in os.environ.items()]
        pid = ctypes.c_int()
        rc = libc.posix_spawn(ctypes.byref(pid), args[0], ctypes.byref(actions),
                              ctypes.byref(attr), (ctypes.c_char_p * (len(args) + 1))(*args),
                              (ctypes.c_char_p * (len(env) + 1))(*env))
        if rc:
            raise OSError(rc, os.strerror(rc))
        return pid.value
    except AttributeError as exc:
        raise OSError(f"posix_spawn responsibility attributes unavailable: {exc}") from exc
    finally:
        libc.posix_spawn_file_actions_destroy(ctypes.byref(actions))
        libc.posix_spawnattr_destroy(ctypes.byref(attr))


class DisclaimedSupervisor:
    """The Popen surface cmd_start uses, over spawn_disclaimed."""

    def __init__(self, argv, cwd, stdout):
        read, write = os.pipe()
        try:
            self.pid = spawn_disclaimed(argv, cwd, read, stdout.fileno())
        except OSError:
            os.close(write)
            raise
        finally:
            os.close(read)
        self.stdin = os.fdopen(write, "wb")

    def poll(self):
        try:
            done, _ = os.waitpid(self.pid, os.WNOHANG)
        except ChildProcessError:
            return 0
        return 0 if done else None


def anchor_tree():
    """Make this supervisor a point every process the job starts can be
    found from, however it detaches; None on success, else why not.

    Linux: a child subreaper adopts every orphan of its own tree, so the
    job is exactly this process's descendants. macOS: cmd_start spawned
    this process disclaimed, so the job is every process naming it as
    responsible; a process already naming this pid (left by a dead
    process the pid was recycled from) would be indistinguishable.
    """
    if sys.platform.startswith("linux"):
        if _libc().prctl(36, 1, 0, 0, 0):  # PR_SET_CHILD_SUBREAPER
            return f"PR_SET_CHILD_SUBREAPER failed: {os.strerror(ctypes.get_errno())}"
        return None
    if sys.platform == "darwin":
        me = os.getpid()
        if _responsible(me) != me:
            return "the supervisor was not spawned as its own responsible process"
        if any(_responsible(pid) == me for pid in _process_table() if pid != me):
            return f"another process already names pid {me} as responsible"
        return None
    return f"no process-tree anchor on {sys.platform}"


def job_members(pgid, marks):
    """(pid, identity) of every live process but pgid's leader and this
    supervisor that the job started: anything anchor_tree reaches, plus
    (defence in depth) process group pgid and this user's processes that
    carry the job cookie or hold the job log open for writing."""
    try:
        table = _process_table()
    except (OSError, AttributeError):
        return []
    cookie, log_key = marks
    me, entry, uid, found = os.getpid(), cookie.encode(), os.getuid(), []
    subtree = set(_subtree(table, me)) if sys.platform.startswith("linux") else set()
    for pid, (_, group, owner) in table.items():
        if pid in (pgid, me):
            continue
        # Identity first: the kill re-checks it, so a pid recycled after the
        # environment or descriptor read is never signalled.
        ident = identity(pid)
        if ident and (group == pgid or pid in subtree or (owner == uid and (
                _responsible(pid) == me or entry in _environ(pid)
                or log_key in _written_files(pid)))):
            found.append((pid, ident))
    return found


def _reap_adopted(child):
    """Reap exited orphans a Linux subreaper adopted. Never the child: its
    unreaped zombie keeps its pid and process-group id from being recycled."""
    while True:
        try:
            info = os.waitid(os.P_ALL, 0, os.WEXITED | os.WNOHANG | os.WNOWAIT)
        except ChildProcessError:
            return
        if info is None or info.si_pid == child.pid:
            return
        with contextlib.suppress(ChildProcessError):
            os.waitpid(info.si_pid, 0)


def windows_job_for(pid):
    """A job object holding pid and every process it starts from now on, or None."""
    kernel32 = _kernel32()
    job = kernel32.CreateJobObjectW(None, None)
    if not job:
        return None
    process = kernel32.OpenProcess(0x0101, False, int(pid))  # SET_QUOTA | TERMINATE
    assigned = bool(process) and kernel32.AssignProcessToJobObject(job, process)
    if process:
        kernel32.CloseHandle(process)
    if not assigned:
        kernel32.CloseHandle(job)
        return None
    return job


def _windows_resume(pid):
    """Resume the threads of a process created suspended; True if one resumed."""
    kernel32 = _kernel32()
    snapshot = kernel32.CreateToolhelp32Snapshot(0x4, 0)  # TH32CS_SNAPTHREAD
    if snapshot in (None, ctypes.c_void_p(-1).value):  # INVALID_HANDLE_VALUE
        return False
    resumed = False
    try:
        entry = _ThreadEntry(size=ctypes.sizeof(_ThreadEntry))
        more = kernel32.Thread32First(snapshot, ctypes.byref(entry))
        while more:
            if entry.owner_pid == pid:
                thread = kernel32.OpenThread(0x0002, False, entry.thread_id)  # SUSPEND_RESUME
                if thread:
                    if kernel32.ResumeThread(thread) != 0xFFFFFFFF:
                        resumed = True
                    kernel32.CloseHandle(thread)
            more = kernel32.Thread32Next(snapshot, ctypes.byref(entry))
    finally:
        kernel32.CloseHandle(snapshot)
    return resumed


def spawn_suspended(argv, **kwargs):
    """Popen a native-Windows child that cannot run until contain() resumes it."""
    flags = subprocess.CREATE_NEW_PROCESS_GROUP | 0x00000004  # CREATE_SUSPENDED
    return subprocess.Popen(argv, creationflags=flags, **kwargs)


def contain(child):
    """Put a suspended child in a new job object, then let it run.

    The child starts nothing before it runs, so its whole tree is in the job.
    Raises OSError, with the child killed, when it cannot be contained.
    """
    job = windows_job_for(child.pid)
    if job is not None and _windows_resume(child.pid):
        return job
    child.kill()
    child.wait()
    if job is not None:
        _kernel32().CloseHandle(job)
    raise OSError("could not hold the child in a job object")


def launch(argv, **kwargs):
    """The job's child, plus its job object on native Windows (else None)."""
    if not IS_WINDOWS:
        return subprocess.Popen(argv, start_new_session=True, **kwargs), None
    child = spawn_suspended(argv, **kwargs)
    return child, contain(child)


def _windows_job_active(job):
    info = _JobAccounting()
    if not _kernel32().QueryInformationJobObject(job, 1, ctypes.byref(info),
                                                 ctypes.sizeof(info), None):
        return 0
    return info.active


# --- supervisor -------------------------------------------------------------

def _signal_verified(members, sig):
    for pid, ident in members:
        if identity(pid) == ident:
            try:
                os.kill(pid, sig)
            except OSError:
                pass


def _killpg(pgid, sig):
    try:
        os.killpg(pgid, sig)
    except OSError:
        pass


def _exited_unreaped(child):
    """True once the child has exited; it stays an unreaped zombie, so its pid
    (and process-group id) cannot be recycled until child.wait() reaps it."""
    if IS_WINDOWS:
        return child.poll() is not None
    try:
        info = os.waitid(os.P_PID, child.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)
    except ChildProcessError:
        return True
    return info is not None


def _drain_tree(child, job, members, marks):
    """Stop the child and everything it left running, then reap the child.

    True once nothing from the tree is left running, so terminal status
    published afterwards is final; False when something outlived SIGKILL's
    grace. members are descendants sampled while the child was alive; on
    POSIX every pass also sweeps job_members, which reaches what an exited
    child orphaned, however it detached (anchor_tree), and signals each
    process the first pass that finds it, so one started mid-drain is
    stopped too. Native Windows terminates the child's job object, which has
    held the child since before it first ran.
    """
    if IS_WINDOWS:
        _kernel32().TerminateJobObject(job, 1)
        deadline = time.monotonic() + CANCEL_GRACE
        while (active := _windows_job_active(job)) and time.monotonic() < deadline:
            time.sleep(POLL)
        child.wait()
        return not active
    for sig in (signal.SIGTERM, signal.SIGKILL):
        _killpg(child.pid, sig)
        signalled, empty_scans = set(), 0
        deadline = time.monotonic() + CANCEL_GRACE
        while time.monotonic() < deadline:
            found = {m for m in members if identity(m[0]) == m[1]}
            found.update(job_members(child.pid, marks))
            _signal_verified(found - signalled, sig)
            signalled |= found
            if found or not _exited_unreaped(child):
                empty_scans = 0
                time.sleep(POLL)
            # A process that forks and then exits during a scan can leave
            # its new child out of that scan; the next one finds it.
            elif (empty_scans := empty_scans + 1) == 2:
                child.wait()
                return True
    child.wait()
    return False


def display_discovery():
    """One line naming the displays this supervisor's session can reach."""
    if sys.platform == "darwin":
        try:
            probe = subprocess.run([sys.executable, "-c", DISPLAY_PROBE], capture_output=True,
                                   text=True, timeout=DISPLAY_PROBE_TIMEOUT)
            count = int(probe.stdout.strip())
        except (OSError, subprocess.SubprocessError, ValueError) as exc:
            return f"none (CoreGraphics probe failed: {exc})"
        if count < 1:
            return f"none (CoreGraphics online displays: {count})"
        return f"{count} online CoreGraphics display(s)"
    if IS_WINDOWS:
        return "native Windows desktop session (not probed)"
    found = [f"{k}={os.environ[k]}" for k in ("DISPLAY", "WAYLAND_DISPLAY") if os.environ.get(k)]
    return ", ".join(found) or "none (DISPLAY and WAYLAND_DISPLAY unset)"


def _exit_code(returncode):
    return 128 - returncode if returncode < 0 else returncode


def supervise():
    spec = json.loads(sys.stdin.read())
    cwd = Path(spec["cwd"])
    job_dir = job_dir_for(spec["id"], cwd)
    meta = read_meta(job_dir)
    if meta.get("status") != "starting":
        raise UsageError(f"job {spec['id']} is not awaiting a supervisor")
    # Re-validate: the spec arrives on stdin, so this verb is no wider than start.
    argv, _ = resolve(meta["profile"], spec["args"], cwd)
    cancelled = []
    signal.signal(signal.SIGTERM, lambda *_: cancelled.append("supervisor signalled"))
    if not IS_WINDOWS:
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
    log_path = job_dir / "job.log"
    with open(log_path, "ab", buffering=0) as log:
        marks = job_marks(spec["id"], log_path)
        # Unanchored, a descendant that detaches from every other mark could
        # outlive the terminal status, so the job never runs.
        if not IS_WINDOWS and (unanchored := anchor_tree()):
            meta.update(status="failed", reason=f"cannot contain the job: {unanchored}",
                        exit_code=127, finished_at=now_iso())
            write_atomic(job_dir / "meta.json", meta)
            return 127
        if meta["profile"] == "render-verify":
            log.write(f"[fleet-jobs] display: {display_discovery()}\n".encode())
        name, _, value = marks[0].partition("=")
        try:
            child, job = launch(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=log,
                                stderr=subprocess.STDOUT, env={**os.environ, name: value})
        except OSError as exc:
            meta.update(status="failed", reason=f"launch failed: {exc}", exit_code=127,
                        finished_at=now_iso())
            write_atomic(job_dir / "meta.json", meta)
            return 127
        meta.update(status="running", started_at=now_iso(),
                    supervisor={"pid": os.getpid(), "identity": identity(os.getpid())},
                    child={"pid": child.pid, "identity": identity(child.pid)})
        write_atomic(job_dir / "meta.json", meta)
        cancel_marker = job_dir / "cancel"
        while not _exited_unreaped(child):
            if cancelled or cancel_marker.exists():
                drained = _drain_tree(child, job, descendants(child.pid), marks)
                reason = cancelled[0] if cancelled else "cancelled by fleet-jobs kill"
                meta.update(status="killed", reason=reason)
                break
            if not IS_WINDOWS:
                _reap_adopted(child)
            time.sleep(POLL)
        else:
            # Whatever the child left running is still part of the job.
            drained = _drain_tree(child, job, [], marks)
            meta.update(status="succeeded" if child.returncode == 0 else "failed",
                        reason="exited")
        exit_code = _exit_code(child.returncode)
        if not drained:
            # The child's result is not the job's while part of the job runs on.
            meta.update(status="failed",
                        reason=f"{meta['reason']}; a process of the job outlived SIGKILL")
            exit_code = 125
        os.fsync(log.fileno())
    meta.update(exit_code=exit_code, finished_at=now_iso())
    write_atomic(job_dir / "meta.json", meta)
    return 0


# --- client verbs -----------------------------------------------------------

def effective(meta):
    """(status, reason) as a reader must report it."""
    status = meta.get("status")
    if status in TERMINAL:
        return status, meta.get("reason", "")
    sup = meta.get("supervisor")
    if not sup:
        age = time.time() - meta.get("created_epoch", 0)
        if status == "starting" and age < STARTUP_TIMEOUT:
            return "starting", ""
        return "lost", "supervisor never reported"
    if not sup.get("identity") or identity(sup["pid"]) != sup["identity"]:
        return "lost", "supervisor gone or unverifiable"
    return status, ""


def describe(job_dir, meta):
    status, reason = effective(meta)
    code = meta.get("exit_code")
    parts = [meta["id"], status, f"exit={'-' if code is None else code}",
             f"profile={meta['profile']}", f"name={meta['name']}",
             f"created={meta['created_at']}"]
    if reason and status != "succeeded":
        parts.append(f"reason={reason!r}")
    parts.append(f"log={job_dir / 'job.log'}")
    return "  ".join(parts)


@contextlib.contextmanager
def admission_lock(root):
    """Hold this pane's exclusive admission lock; the OS drops it if the holder dies."""
    root.mkdir(parents=True, exist_ok=True)
    with open(root / ".admission.lock", "a+b") as handle:
        handle.seek(0)
        if IS_WINDOWS:
            import msvcrt
            while True:
                try:
                    msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)
                    break
                except OSError:  # LK_LOCK gives up after ten one-second retries
                    pass
            try:
                yield
            finally:
                handle.seek(0)
                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
        else:
            import fcntl
            fcntl.flock(handle, fcntl.LOCK_EX)
            yield


def live_render_verify(root):
    """Id of this pane's starting or running render-verify job, or None."""
    if not root.is_dir():
        return None
    for job_dir in root.iterdir():
        if (job_dir / "meta.json").is_file():
            meta = read_meta(job_dir)
            if (meta.get("profile") == "render-verify"
                    and effective(meta)[0] in ("starting", "running")):
                return meta["id"]
    return None


def cmd_start(rest, cwd):
    if not rest:
        raise UsageError(f"start needs a profile ({', '.join(PROFILES)})")
    profile, args = rest[0], rest[1:]
    _, name = resolve(profile, args, cwd)
    root = pane_dir(cwd)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    job_id = f"{stamp}-{profile}-{secrets.token_hex(3)}"
    job_dir = root / job_id
    # render-verify clears and captures into the build's shared screenshot
    # directory, so a concurrent run in the same checkout can grade the other
    # run's frames and report PASS for a demo that never rendered. The scan
    # and the "starting" record it must see are one step under the lock.
    with admission_lock(root):
        if profile == "render-verify" and (busy := live_render_verify(root)):
            die(f"render-verify job {busy} is still running in this pane; "
                "wait for or kill it before starting another", 1)
        job_dir.mkdir()
        (job_dir / "job.log").touch()
        meta = {"id": job_id, "pane": root.name, "profile": profile, "name": name,
                "cwd": str(cwd), "created_at": now_iso(), "created_epoch": time.time(),
                "status": "starting", "exit_code": None}
        write_atomic(job_dir / "meta.json", meta)
    with open(job_dir / "supervisor.log", "ab") as sup_log:
        spawn = [sys.executable, os.path.realpath(__file__), "_supervise"]
        try:
            if IS_WINDOWS:
                flags = (subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
                         | 0x01000000)  # CREATE_BREAKAWAY_FROM_JOB
                proc = subprocess.Popen(spawn, cwd=cwd, stdin=subprocess.PIPE, stdout=sup_log,
                                        stderr=subprocess.STDOUT, creationflags=flags)
            elif sys.platform == "darwin":
                proc = DisclaimedSupervisor(spawn, cwd, sup_log)
            else:
                proc = subprocess.Popen(spawn, cwd=cwd, stdin=subprocess.PIPE, stdout=sup_log,
                                        stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as exc:
            # Never retry without breakaway: a supervisor left in an enclosing
            # job dies when that job is terminated, so the start would claim
            # a durability it cannot deliver.
            reason = f"supervisor launch failed: {exc}"
            if IS_WINDOWS and getattr(exc, "winerror", None) == 5:  # ERROR_ACCESS_DENIED
                reason = ("the enclosing job object forbids breakaway, so no supervisor "
                          "can outlive this invocation")
            meta.update(status="failed", reason=reason, exit_code=127, finished_at=now_iso())
            write_atomic(job_dir / "meta.json", meta)
            die(f"{job_id} not started: {reason}", 1)
    proc.stdin.write(json.dumps({"id": job_id, "cwd": str(cwd), "args": args}).encode())
    proc.stdin.close()
    deadline = time.monotonic() + STARTUP_TIMEOUT
    while time.monotonic() < deadline:
        meta = read_meta(job_dir)
        if meta.get("status") != "starting":
            break
        if proc.poll() is not None:
            die(f"supervisor for {job_id} exited before starting; see "
                f"{job_dir / 'supervisor.log'}", 1)
        time.sleep(0.05)
    else:
        die(f"supervisor for {job_id} did not report within {STARTUP_TIMEOUT:.0f}s", 1)
    # Only a launched child gets started_at; a terminal record without it is
    # the supervisor refusing to run the job (anchor or launch failure).
    if "started_at" not in meta:
        die(f"{job_id} not started: {meta.get('reason') or meta['status']}", 1)
    print(f"started {job_id} ({meta['status']})")
    print(f"log: {job_dir / 'job.log'}")
    print(f"next: fleet-jobs wait {job_id}")
    return 0


def take_flags(rest, flags, valued=()):
    found, positional, i = {}, [], 0
    while i < len(rest):
        arg = rest[i]
        if arg in flags:
            found[arg] = True
            i += 1
        elif arg in valued:
            if i + 1 >= len(rest):
                raise UsageError(f"{arg} needs a value")
            found[arg] = rest[i + 1]
            i += 2
        elif arg.startswith("-"):
            raise UsageError(f"unknown option {arg!r}")
        else:
            positional.append(arg)
            i += 1
    return found, positional


def one_job(positional, verb):
    if len(positional) != 1:
        raise UsageError(f"{verb} takes exactly one job id")
    return positional[0]


def cmd_status(rest, cwd):
    flags, positional = take_flags(rest, ("--json",))
    job_dir = job_dir_for(one_job(positional, "status"), cwd)
    meta = read_meta(job_dir)
    if flags.get("--json"):
        status, reason = effective(meta)
        view = {k: meta.get(k) for k in ("id", "profile", "name", "cwd", "created_at",
                                          "started_at", "finished_at", "exit_code")}
        view.update(status=status, reason=reason or meta.get("reason", ""),
                    log=str(job_dir / "job.log"))
        print(json.dumps(view, sort_keys=True))
    else:
        print(describe(job_dir, meta))
    return 0


def cmd_list(rest, cwd):
    flags, positional = take_flags(rest, ("--json",))
    if positional:
        raise UsageError("list takes no job id")
    root = pane_dir(cwd)
    jobs = sorted((p for p in root.iterdir() if (p / "meta.json").is_file()),
                  reverse=True) if root.is_dir() else []
    for job_dir in jobs:
        meta = read_meta(job_dir)
        if flags.get("--json"):
            status, _ = effective(meta)
            print(json.dumps({"id": meta["id"], "status": status, "profile": meta["profile"],
                              "exit_code": meta.get("exit_code")}, sort_keys=True))
        else:
            print(describe(job_dir, meta))
    return 0


def cmd_wait(rest, cwd):
    flags, positional = take_flags(rest, ("--quiet",), ("--timeout",))
    job_dir = job_dir_for(one_job(positional, "wait"), cwd)
    timeout = flags.get("--timeout")
    if timeout is not None and not re.fullmatch(r"[0-9]+", timeout):
        raise UsageError("--timeout takes whole seconds")
    deadline = None if timeout is None else time.monotonic() + int(timeout)
    out = sys.stdout.buffer
    with open(job_dir / "job.log", "rb") as log:
        while True:
            # Read the status before draining: terminal status is published
            # only after the final log bytes, so a drain after a terminal
            # read cannot miss output.
            meta = read_meta(job_dir)
            status, reason = effective(meta)
            chunk = log.read()
            if chunk and not flags.get("--quiet"):
                out.write(chunk)
                out.flush()
            if status in TERMINAL or status == "lost":
                break
            if deadline is not None and time.monotonic() >= deadline:
                print(f"fleet-jobs: {meta['id']} still {status} after {timeout}s "
                      f"(wait timed out)", file=sys.stderr)
                return 124
            if not chunk:
                time.sleep(POLL)
    if status == "lost":
        print(f"fleet-jobs: {meta['id']} lost ({reason})", file=sys.stderr)
        return 1
    print(f"fleet-jobs: {meta['id']} {status} exit={meta['exit_code']}", file=sys.stderr)
    return int(meta["exit_code"])


def cmd_kill(rest, cwd):
    _, positional = take_flags(rest, ())
    job_dir = job_dir_for(one_job(positional, "kill"), cwd)
    meta = read_meta(job_dir)
    status, reason = effective(meta)
    if status == "lost":
        # Never signal a stored pid: with the supervisor gone nothing vouches
        # that the child pid still names this job's process.
        print(f"fleet-jobs: {meta['id']} lost ({reason}); nothing signalled", file=sys.stderr)
        return 1
    if status not in TERMINAL:
        (job_dir / "cancel").touch()
        deadline = time.monotonic() + CANCEL_GRACE + 20
        while time.monotonic() < deadline:
            meta = read_meta(job_dir)
            status, reason = effective(meta)
            if status in TERMINAL or status == "lost":
                break
            time.sleep(POLL)
        else:
            print(f"fleet-jobs: {meta['id']} still {status} after cancel request",
                  file=sys.stderr)
            return 1
    print(describe(job_dir, meta))
    return 0 if status in TERMINAL else 1


VERBS = {"start": cmd_start, "status": cmd_status, "wait": cmd_wait, "kill": cmd_kill,
         "list": cmd_list}


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    verb, rest = argv[0], argv[1:]
    cwd = Path.cwd()
    try:
        if verb == "_supervise":
            return supervise()
        if verb not in VERBS:
            raise UsageError(f"unknown verb {verb!r} (verbs: {', '.join(VERBS)})")
        return VERBS[verb](rest, cwd)
    except UsageError as exc:
        die(str(exc))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
