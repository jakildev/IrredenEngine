#!/usr/bin/env bash
#
# solo-architect — run just the Irreden architect as an interactive
# design / build partner, WITHOUT bringing up the fleet.
#
# This is the architect pane fleet-up would launch (same model, effort,
# worktree, and persisted-session-id resume behaviour as
# `fleet-babysit ... opus-architect` -> launch_architect_first), minus the
# worker / reviewer / merger / scout panes and the babysit relaunch loop.
#
# You get the full architect role — planning, epic filing, and especially
# sub-agent direction (the Agent/Workflow tools work in any session) — as a
# one-off interactive conversation you drive yourself.
#
# The only thing the architect's startup protocol needs from the fleet is the
# scout cache (~/.fleet/state/state.json); if it's stale/missing the role
# prints "run fleet-up" and exits. We neutralize that two ways: an optional
# single scout tick (fleet-state-scout --once) to populate the cache, and an
# appended system prompt telling the role to proceed in solo mode instead of
# bailing.
#
# Usage:
#   solo-architect [engine|game] [--campaign <slug>] [--fresh] [--no-scout] [--dry-run] [-- <claude args...>]
#
#     engine (default)  /role-opus-architect   (jakildev/IrredenEngine)
#     game              /role-game-architect    (jakildev/irreden, under creations/game)
#     --campaign <slug> /role-campaign <slug>   (docs/agents/campaign-protocol.md) in
#                       the engine worktree .claude/worktrees/campaign-<slug>,
#                       created off origin/master on first use; its own
#                       session sidecar, so campaigns and the architect resume
#                       independently
#
#     --fresh     ignore the saved session and start a new conversation
#                 (default resumes the last solo conversation for this role)
#     --no-scout  skip the one-off scout tick (rely only on the solo-mode prompt)
#     --dry-run   pass mode=dry-run to the role (startup + stand by, don't work)
#     -- ...      everything after `--` is forwarded verbatim to `claude`
#
set -euo pipefail

ENGINE="${FLEET_ENGINE_ROOT:-$HOME/src/IrredenEngine}"
GAME="$ENGINE/creations/game"
# Architects run the fable class. The default comes from fleet-common.sh
# (a version-free tier alias the CLI resolves to the newest Fable at
# launch — no per-release edit needed here; the inline backstop fires
# only if fleet-common.sh is missing). FLEET_MODEL_FABLE (env or
# ~/.fleet/fleet-up.conf) pins the model, same knob fleet-up honors. No
# availability probe here — this is an interactive launch, so an
# unavailable model fails loudly on the first turn; pin
# FLEET_MODEL_FABLE="opus[1m]" once the plan loses Fable.
_FLEET_COMMON_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fleet-common.sh"
if [[ -f "$_FLEET_COMMON_SH" ]]; then
  # shellcheck source=/dev/null
  source "$_FLEET_COMMON_SH"
fi
unset _FLEET_COMMON_SH
if [[ -z "${FLEET_MODEL_FABLE:-}" && -f "$HOME/.fleet/fleet-up.conf" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.fleet/fleet-up.conf"
fi
MODEL="${FLEET_MODEL_FABLE:-${FLEET_FABLE_CANDIDATES_DEFAULT[0]:-fable[1m]}}"
# Global FLEET_EFFORT (env or conf) lowers solo sessions too; default
# stays xhigh — heavy design work is where that budget earns its keep.
EFFORT="${FLEET_EFFORT:-xhigh}"

ROLE="opus-architect"
WORKTREE="$ENGINE/.claude/worktrees/opus-architect"
MODE="live"
FRESH=0
RUN_SCOUT=1
CAMPAIGN=""
PASSTHRU=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    engine|opus|opus-architect)
      ROLE="opus-architect"; WORKTREE="$ENGINE/.claude/worktrees/opus-architect"; shift ;;
    game|game-architect)
      ROLE="game-architect";  WORKTREE="$GAME/.claude/worktrees/game-architect";  shift ;;
    --campaign)
      CAMPAIGN="${2:?solo-architect: --campaign needs a slug}"
      case "$CAMPAIGN" in
        *[!a-z0-9-]*|'') echo "solo-architect: campaign slug must be [a-z0-9-]: '$CAMPAIGN'" >&2; exit 2 ;;
      esac
      ROLE="campaign"; WORKTREE="$ENGINE/.claude/worktrees/campaign-$CAMPAIGN"; shift 2 ;;
    --fresh)    FRESH=1; shift ;;
    --no-scout) RUN_SCOUT=0; shift ;;
    --dry-run)  MODE="dry-run"; shift ;;
    --)         shift; PASSTHRU+=("$@"); break ;;
    -h|--help)  awk 'NR<=2 {next} /^#/ {print; next} {exit}' "$0"; exit 0 ;;
    *) echo "solo-architect: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

# A campaign worktree is created on first use: a persistent branch off
# origin/master under .claude/worktrees/ (fleet-assert-worktree's invariant),
# with the architect worktree's settings.local.json copied over so the
# edit guard and the session-track hook are wired the same way fleet-up
# wires them (FLEET_ASSIGNED_WORKTREE re-pointed at this worktree).
if [[ -n "$CAMPAIGN" && ! -d "$WORKTREE" ]]; then
  echo "solo-architect: creating campaign worktree $WORKTREE" >&2
  git -C "$ENGINE" fetch origin --quiet || true
  git -C "$ENGINE" worktree add "$WORKTREE" -b "fleet/campaign-$CAMPAIGN" origin/master
  _arch_settings="$ENGINE/.claude/worktrees/opus-architect/.claude/settings.local.json"
  if [[ -f "$_arch_settings" ]]; then
    mkdir -p "$WORKTREE/.claude"
    python3 - "$_arch_settings" "$WORKTREE/.claude/settings.local.json" "$WORKTREE" <<'PY'
import json, sys
src, dst, wt = sys.argv[1:4]
d = json.load(open(src))
d.setdefault("env", {})["FLEET_ASSIGNED_WORKTREE"] = wt
json.dump(d, open(dst, "w"), indent=2)
PY
  fi
  unset _arch_settings
fi

# cwd must be the role's worktree so its startup sync + the repo-local
# /role-* slash command and CLAUDE.md set resolve correctly.
if [[ ! -d "$WORKTREE" ]]; then
  echo "solo-architect: worktree not found: $WORKTREE" >&2
  echo "  (run 'fleet-up' once to create it, or point this at an existing checkout)" >&2
  exit 1
fi
cd "$WORKTREE"

# Optional single scout tick so the architect's startup cache step sees a
# fresh ~/.fleet/state/state.json. Writes the cache only; this is NOT
# "starting the fleet" — no panes, no workers, no babysit loop.
if [[ "$RUN_SCOUT" -eq 1 ]] && command -v fleet-state-scout >/dev/null 2>&1; then
  echo "solo-architect: priming scout cache (one tick)..." >&2
  fleet-state-scout --once || echo "solo-architect: scout tick failed — continuing in solo mode" >&2
fi

# Always append a solo-mode override so the role never exits on a
# stale/missing scout cache when the fleet is down.
SOLO_PROMPT="You are running as a SOLO architect, outside the fleet — no workers, \
reviewers, merger, or scout daemon are running. If your startup protocol's \
scout-cache step finds ~/.fleet/state/state.json missing or stale, do NOT print \
'run fleet-up' and exit; instead skip the queue-surfacing startup steps and \
continue as an interactive design/build partner. You may still spawn sub-agents \
and do heavy core work directly in this session. Any fleet:task/epic you file \
will simply wait in the queue until I bring the fleet up."

# A campaign has no standby posture: it works its objective from its
# campaign doc, so the solo prompt tells it only that the fleet may be down.
if [[ -n "$CAMPAIGN" ]]; then
  SOLO_PROMPT="You are running as a campaign driver, possibly outside the fleet — \
workers, reviewers, merger and scout may not be running. A stale or missing \
~/.fleet/state/state.json is not an exit condition for this role; continue \
from the campaign doc and the open PR list per docs/agents/campaign-protocol.md."
fi

SESSION_DIR="$HOME/.fleet/solo"
mkdir -p "$SESSION_DIR"
SESSION_FILE="$SESSION_DIR/$ROLE${CAMPAIGN:+-$CAMPAIGN}.session"
ROLE_ARGS="${CAMPAIGN:+$CAMPAIGN }$MODE"

# Gate vars for the fleet-session-track SessionStart hook (wired into the
# worktree's settings by fleet-up): it rewrites SESSION_FILE with the live
# session id on every session start, so an interactive /clear repoints the
# sidecar and the next solo-architect run resumes the post-/clear
# conversation instead of the one this launch started. Same contract as
# fleet-babysit's architect path — but with the solo sidecar, so solo and
# fleet resumes never clobber each other's file.
export FLEET_SESSION_FILE="$SESSION_FILE"
export FLEET_SESSION_ROLE="$ROLE"
export FLEET_SESSION_MODE="$ROLE_ARGS"

if [[ -s "$SESSION_FILE" && "$FRESH" -eq 0 ]]; then
  SID="$(cat "$SESSION_FILE")"
  echo "solo-architect: resuming $ROLE session $SID (cwd $WORKTREE)" >&2
  echo "  (if the session can't be resumed, re-run with --fresh)" >&2
  # Resume with NO trailing prompt — load the conversation and wait for input,
  # generating no model turn. The old "tell me what we were last working on"
  # nudge bought nothing (the transcript is right there) and cost a full turn
  # on every relaunch; same reasoning as fleet-babysit's launch_architect_first.
  exec claude --model "$MODEL" --effort "$EFFORT" \
    --append-system-prompt "$SOLO_PROMPT" \
    --resume "$SID" "${PASSTHRU[@]+"${PASSTHRU[@]}"}"
else
  SID="$(uuidgen | tr 'A-Z' 'a-z')"
  echo "$SID" > "$SESSION_FILE"
  echo "solo-architect: starting $ROLE session $SID (cwd $WORKTREE)" >&2
  exec claude --model "$MODEL" --effort "$EFFORT" \
    --append-system-prompt "$SOLO_PROMPT" \
    --session-id "$SID" "${PASSTHRU[@]+"${PASSTHRU[@]}"}" \
    "/role-$ROLE $ROLE_ARGS"
fi
