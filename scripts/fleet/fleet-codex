#!/usr/bin/env bash
# Codex transport; run from an assigned pool or architect worktree.
set -euo pipefail
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
    dir="$(cd "$(dirname "$self")" && pwd)"
    self="$(readlink "$self")"
    [[ "$self" = /* ]] || self="$dir/$self"
done
exec python3 "$(dirname "$self")/fleet_codex.py" "$@"
