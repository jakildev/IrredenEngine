#!/usr/bin/env bash
# ir-acquire — engine-level resource coordinator.
#
# Acquires CPU slots, GPU exclusivity, and/or perf-measurement exclusivity,
# then exec()s the wrapped command with those resources held. Locks are
# released automatically on exit (normal, signal, or process death).
#
# Usage:
#   ir-acquire cpu N -- <cmd...>          # take N CPU slots, run cmd, release
#   ir-acquire gpu -- <cmd...>            # take the GPU lock, run cmd, release
#   ir-acquire perf -- <cmd...>           # take the perf lock, run cmd, release
#   ir-acquire benchmark -- <cmd...>      # take (budget-1) CPU + GPU + perf
#   ir-acquire --info                     # show what's currently held
#   ir-acquire --quiet-status [--json]    # show benchmark quiet-window state
#   ir-acquire --quiet-disable [reason]   # run benchmarks without the window
#   ir-acquire --quiet-enable             # restore guarded benchmarks
#   ir-acquire --lease-release TOKEN      # lend the gpu lock (see below)
#   ir-acquire --lease-reacquire TOKEN    # take a lent gpu lock back
#
# Flags (before the resource verb):
#   --nonblock        fail fast if any required lock is contended
#   --timeout SECS    wait at most SECS for each lock (default 600)
#
# Reservation semantics — "acquire-late, release-early":
#   Hold a lock for the operation that needs it and nothing more. The script
#   wraps a single command. Don't keep a perf lock open while drafting the
#   next PR comment; reclaim per measurement. The trap on EXIT makes this
#   automatic for normal use.
#
# GPU lease: gpu and benchmark export IR_RUN_LOCK_TOKEN and IR_ACQUIRE_TOOL
# to the command, so an engine that hands off to a child run can lend the gpu
# lock and take it back (IREngine.handOff). The lease verbs run in their own
# process; the lock stays the ir-acquire shell's, and its EXIT trap drops the
# lease. Only the gpu lock is lent. --timeout bounds the reacquire wait.

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"; done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
HELPERS="$SCRIPT_DIR/../lib/concurrency_helpers.sh"

if [[ ! -f "$HELPERS" ]]; then
    echo "ir-acquire: missing $HELPERS" >&2
    exit 1
fi
# shellcheck source=../lib/concurrency_helpers.sh
source "$HELPERS"

quiet_record=""
quiet_parker_pid=""

lease_token=""
hold_sleeper_pid=""

cleanup() {
    [[ -z "$hold_sleeper_pid" ]] || kill "$hold_sleeper_pid" 2>/dev/null || true
    [[ -z "$lease_token" ]] || ir_gpu_lease_drop "$lease_token"
    if [[ -n "$quiet_parker_pid" ]]; then
        kill "$quiet_parker_pid" 2>/dev/null || true
        wait "$quiet_parker_pid" 2>/dev/null || true
        # On Windows the kill skips the parker's own cleanup, leaving its row behind.
        python3 "$IR_QUIET_HELPER" park-drop "$IR_QUIET_OWNER" \
            --launcher-token "$quiet_record" || true
    fi
    ir_release_all
}

# The EXIT trap releases; a signal arm only ends the script. A handler that
# returned would resume the queue loop or the hold, and run the command later.
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

usage() {
    sed -n '2,/^$/p' "$0"
}

nonblock=false
timeout_secs=""

# Pre-verb flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        --nonblock) nonblock=true; shift ;;
        --timeout)  timeout_secs="$2"; shift 2 ;;
        --info)
            ir_print_lock_state
            exit 0
            ;;
        --quiet-status)
            shift
            ir_quiet_status "$@"
            exit $?
            ;;
        --quiet-lease)
            shift
            tag="${1:-}"
            action="${2:-}"
            shift 2 || true
            case "$action" in
                create) ir_quiet_lease_create "$tag" "${1:-$$}" ;;
                drop) ir_quiet_lease_drop "$tag" ;;
                *) echo "ir-acquire --quiet-lease: expected create|drop" >&2; exit 2 ;;
            esac
            exit 0
            ;;
        --quiet-park)
            shift
            tag="${1:-${IR_QUIET_OWNER:-}}"
            [[ -n "$tag" ]] || exit 0
            shift || true
            ir_quiet_park "$tag" "$@"
            exit 0
            ;;
        --quiet-disable)
            shift
            python3 "$IR_QUIET_HELPER" disable "${1:-operator}"
            exit 0
            ;;
        --quiet-enable)
            python3 "$IR_QUIET_HELPER" enable
            exit 0
            ;;
        --lease-release|--lease-reacquire)
            op="${1#--lease-}"
            shift
            lease_args=()
            [[ -n "$timeout_secs" ]] && lease_args+=(--timeout "$timeout_secs")
            set +e
            _ir_lease_transition "$op" "${1:-}" ${lease_args[@]+"${lease_args[@]}"}
            exit $?
            ;;
        -h|--help) usage; exit 0 ;;
        *) break ;;
    esac
done

if [[ $# -lt 1 ]]; then
    usage
    exit 2
fi

verb="$1"
shift
export IR_QUIET_ACQUIRE_VERB="$verb"

acquire_args=()
$nonblock && acquire_args+=(--nonblock)
[[ -n "$timeout_secs" ]] && acquire_args+=(--timeout "$timeout_secs")

case "$verb" in
    cpu)
        if [[ $# -lt 1 || "$1" == "--" ]]; then
            echo "ir-acquire cpu: need a slot count (e.g. ir-acquire cpu 4 -- make)" >&2
            exit 2
        fi
        count="$1"
        shift
        ir_acquire_cpu "$count" ${acquire_args[@]+"${acquire_args[@]}"}
        ;;
    gpu)
        ir_acquire_exclusive lock gpu ${acquire_args[@]+"${acquire_args[@]}"}
        ;;
    perf)
        ir_acquire_exclusive lock perf ${acquire_args[@]+"${acquire_args[@]}"}
        ;;
    benchmark)
        quiet_record="$(python3 "$IR_QUIET_HELPER" record-create \
            --pid "$$" --owner "${IR_QUIET_OWNER:-}" \
            --owner-token "$(ir_self_owner_token)" \
            --linger "$(ir_quiet_linger)" --maximum "$(ir_quiet_max)" \
            --drain "$(ir_quiet_drain)" --settle-cpu "$(ir_quiet_settle_cpu)" \
            --settle-sample "$(ir_quiet_settle_sample)")"
        if [[ "$quiet_record" == "disabled" ]]; then
            echo "ir-acquire: QUIET-UNGUARDED (quiet window disabled)" >&2
            [[ -n "${IR_QUIET_REPORT_FILE:-}" ]] && printf 'UNGUARDED\n' > "$IR_QUIET_REPORT_FILE"
        elif [[ -z "${IR_QUIET_TEST_NO_QUEUE_PARK:-}" && -n "${IR_QUIET_OWNER:-}" && -d "$IR_LOCK_ROOT/quiet/leases/$IR_QUIET_OWNER" ]]; then
            measurement_root="${IR_QUIET_MEASURE_ROOT:-$$}"
            ir_quiet_park "$IR_QUIET_OWNER" --measurement-root "$measurement_root" \
                --measurement-root-token "$(ir_owner_token_for_pid "$measurement_root")" \
                --launcher-token "$quiet_record" &
            quiet_parker_pid=$!
        fi
        # The canonical heavy-measurement lock. cpu = budget-1 leaves one
        # core for the OS / shell / responsiveness so a runaway worker
        # doesn't lock up the whole box. The order matters: take cpu first
        # (most contended), then gpu, then perf — releases happen in
        # reverse via the trap.
        budget="$(ir_cpu_budget)"
        cpu_take=$(( budget - 1 ))
        (( cpu_take < 1 )) && cpu_take=1
        ir_acquire_cpu "$cpu_take" ${acquire_args[@]+"${acquire_args[@]}"}
        ir_acquire_exclusive lock gpu ${acquire_args[@]+"${acquire_args[@]}"}
        ir_acquire_exclusive lock perf ${acquire_args[@]+"${acquire_args[@]}"}
        if [[ -n "$quiet_record" && "$quiet_record" != "disabled" ]]; then
            set +e
            python3 "$IR_QUIET_HELPER" barrier "$quiet_record"
            barrier_status=$?
            set -e
            if (( barrier_status == 75 )); then
                refuse_args=("$quiet_record")
                [[ -n "${IR_QUIET_REPORT_FILE:-}" ]] && refuse_args+=(--report "$IR_QUIET_REPORT_FILE")
                python3 "$IR_QUIET_HELPER" refuse "${refuse_args[@]}"
                exit 75
            fi
            if (( barrier_status == 77 )); then
                python3 "$IR_QUIET_HELPER" refuse "$quiet_record"
                quiet_record="disabled"
                echo "ir-acquire: QUIET-UNGUARDED (quiet window disabled while waiting)" >&2
                [[ -n "${IR_QUIET_REPORT_FILE:-}" ]] && printf 'UNGUARDED\n' > "$IR_QUIET_REPORT_FILE"
            fi
        fi
        ;;
    *)
        echo "ir-acquire: unknown verb '$verb' (cpu|gpu|perf|benchmark|--info)" >&2
        exit 2
        ;;
esac

# Skip the optional '--' separator if present.
if [[ $# -gt 0 && "$1" == "--" ]]; then
    shift
fi

if [[ $# -lt 1 ]]; then
    # No command — sleep until SIGINT/SIGTERM. Useful for manual experiments
    # ("hold the gpu lock for 30s while I run X by hand"). `wait` returns to a
    # trapped signal at once; a foreground `sleep` would defer it a minute.
    echo "ir-acquire: held; ctrl-c or kill -TERM $$ to release" >&2
    while true; do
        sleep 60 &
        hold_sleeper_pid=$!
        wait "$hold_sleeper_pid"
    done
fi

# Run the command with the locks held; trap releases on exit. The exports let
# a nested ir-run see that its ancestor already holds what it would queue on
# (ir_inherited_lock_covers).
export IR_ACQUIRE_HOLDER_PID="$$" IR_ACQUIRE_HELD_VERB="$verb"
IR_ACQUIRE_HOLDER_WINPID="$(ir_self_owner_token)"
export IR_ACQUIRE_HOLDER_WINPID
if [[ "$verb" == "gpu" || "$verb" == "benchmark" ]]; then
    lease_token="$(ir_gpu_lease_create)"
    IR_ACQUIRE_TOOL="$SCRIPT_DIR/ir-acquire"
    [[ -z "$_IR_SELF_WINPID" ]] || IR_ACQUIRE_TOOL="$(cygpath -m "$IR_ACQUIRE_TOOL")"
    export IR_RUN_LOCK_TOKEN="$lease_token" IR_ACQUIRE_TOOL
fi
set +e
"$@"
command_status=$?
set -e

if [[ "$verb" == "benchmark" && -n "$quiet_record" && "$quiet_record" != "disabled" ]]; then
    finish_args=("$quiet_record" "$command_status")
    [[ -n "${IR_QUIET_REPORT_FILE:-}" ]] && finish_args+=(--report "$IR_QUIET_REPORT_FILE")
    set +e
    python3 "$IR_QUIET_HELPER" finish "${finish_args[@]}"
    command_status=$?
    set -e
fi

exit "$command_status"
