#!/usr/bin/env bash
# ir-run — find and run a built executable, with verb-conditional
# ir-acquire wrapping.
#
# Avoids the `cd <dir> && ./<exe>` pattern that triggers Claude Code's
# compound-command security gate, and runs the executable from its
# own directory so sibling data/, shaders/, and scripts/ are on its
# CWD.
#
# The run is wrapped with ir-acquire when the program's args indicate
# exclusive resource use:
#   --auto-screenshot N  → ir-acquire gpu
#   --auto-record N      → ir-acquire gpu
#   --auto-profile N     → ir-acquire benchmark (cpu(budget-1) + gpu + perf)
#   interactive (none)   → no acquire (human-supervised); on native Windows
#                          every run takes the gpu lock (IR_RUN_GL_EXCLUSIVE=0
#                          opts out) — see the note at the verb detection.
# Two parallel screenshot-capture runs on macOS serialize automatically,
# and a perf measurement does not share cores with a concurrent build.
#
# Usage:
#   ir-run IrredenEngineTest --gtest_brief=1
#   ir-run IRShapeDebug
#   ir-run --timeout 5 IRShapeDebug          # auto-kill after 5 seconds
#   ir-run --timeout 0 IRShapeDebug          # explicit opt-out of any default
#   ir-run --build-dir /path/to/build IrredenEngineTest
#   ir-run --targets [--plain|--plan|--built] [--build-dir DIR]
#
# --timeout budgets the executable's run time only. When the run is
# wrapped with ir-acquire, time spent queued on the resource lock does
# not count: the watchdog starts once the lock is granted. The wait is
# bounded separately by ir-acquire's own queue timeout
# (IR_QUEUE_TIMEOUT, default 600 s), and a run that never gets its lock
# reports RESULT=LOCK-FAILED, not a watchdog verdict.
#
# Fleet agents should always use --timeout for interactive (non-
# auto-screenshot) GUI executables to avoid leaving windows open and
# stealing focus from the human.
#
# Default timeout (safety net): if --timeout is not passed, the env
# var FLEET_RUN_DEFAULT_TIMEOUT (seconds) is honored. Unset or 0 means
# "no watchdog" (exec the binary as before). Per-invocation `--timeout
# 0` opts out for that call when you want to run interactively under
# a set default.
#
# Source of truth: engine/tools/bin/ir-run in the engine repo.
# Installed to ~/bin/ir-run (as a symlink) by scripts/fleet/install.sh.

set -euo pipefail

# Walk through symlinks to the real script location so we can locate
# the helpers library + ir-acquire sibling regardless of how ir-run
# was invoked (direct, ~/bin symlink, or via the fleet-run shim).
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"; done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
HELPERS="$SCRIPT_DIR/../lib/concurrency_helpers.sh"
IR_ACQUIRE="$SCRIPT_DIR/ir-acquire"

if [[ ! -f "$HELPERS" ]]; then
    echo "ir-run: missing $HELPERS" >&2
    exit 1
fi
if [[ ! -x "$IR_ACQUIRE" ]]; then
    echo "ir-run: missing or non-executable $IR_ACQUIRE" >&2
    exit 1
fi
# shellcheck source=../lib/concurrency_helpers.sh
source "$HELPERS"

# On native Windows (MSYS2/Git-Bash) the built artifact carries a `.exe`
# suffix and needs the MinGW + GLFW + FFmpeg runtime DLLs from MSYS2's
# mingw64 on PATH (see docs/agents/BUILD.md "Runtime DLL drama"). Prepend it
# so the exe resolves its own runtime DLLs ahead of any Git-for-Windows ones.
# IR_MSYS2_MINGW (Windows-form path, shared with ir-build) overrides the dir.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        IR_IS_WINDOWS=1
        IR_MSYS2_MINGW="${IR_MSYS2_MINGW:-C:\\msys64\\mingw64\\bin}"
        _ir_mingw_posix="$(cygpath -u "$IR_MSYS2_MINGW" 2>/dev/null || echo /c/msys64/mingw64/bin)"
        export PATH="$_ir_mingw_posix:$PATH"
        ;;
    *) IR_IS_WINDOWS=0 ;;
esac

BUILD_DIR=""
TIMEOUT=""
TIMEOUT_EXPLICIT=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --build-dir)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "ir-run: --build-dir requires a directory path" >&2
                exit 2
            fi
            BUILD_DIR="$2"
            shift 2
            ;;
        --timeout|-t)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "ir-run: --timeout|-t requires a non-negative integer (seconds); 0 disables" >&2
                exit 2
            fi
            TIMEOUT="$2"
            TIMEOUT_EXPLICIT=1
            shift 2
            ;;
        --targets)
            shift
            # fleet-run-targets still lives under scripts/fleet/. It uses
            # the same worktree-root build-dir detection ir-run does, so
            # we hand off cleanly. Resolve from the invoker's worktree
            # (IR_ENGINE_ROOT is the script's source clone, which may be
            # a different worktree when invoked via ~/bin symlink). A
            # downstream-creation worktree has no scripts/fleet/ — use the
            # enclosing engine root's copy and point it at the creation's
            # dedicated build dir.
            WORKTREE_ROOT="$(ir_worktree_root)"
            HELPER_ROOT="$WORKTREE_ROOT"
            if [[ ! -x "$HELPER_ROOT/scripts/fleet/fleet-run-targets" ]]; then
                if _eng_root="$(ir_creation_worktree_engine_root "$WORKTREE_ROOT")"; then
                    HELPER_ROOT="$_eng_root"
                fi
            fi
            HELPER="$HELPER_ROOT/scripts/fleet/fleet-run-targets"
            if [[ -z "$HELPER_ROOT" || ! -x "$HELPER" ]]; then
                echo "ir-run: missing $WORKTREE_ROOT/scripts/fleet/fleet-run-targets (fleet-run-targets is currently engine-tooling-adjacent; expected under scripts/fleet/)" >&2
                exit 1
            fi
            if [[ -z "$BUILD_DIR" ]]; then
                BUILD_DIR="${IRREDEN_BUILD_DIR:-$(ir_default_build_dir "$WORKTREE_ROOT")}"
            fi
            exec "$HELPER" --build-dir "$BUILD_DIR" "$@"
            ;;
        --help|-h)
            cat <<'USAGE'
usage: ir-run [options] <executable-name> [args...]
   or: ir-run [options] --targets [list-options...]

Run mode
  Finds <executable-name> anywhere under the build tree, cd's to that
  executable's directory, and runs it so sibling data/, shaders/, and
  scripts/ are on the process cwd.

  Arguments after <executable-name> are passed through to the program.

  Verb-conditional ir-acquire wrapping:
    --auto-screenshot N  → wrapped in ir-acquire gpu
    --auto-record N      → wrapped in ir-acquire gpu
    --auto-profile N     → wrapped in ir-acquire benchmark (cpu+gpu+perf)
    no exclusive verb    → no acquire (interactive / unit-test mode);
                           on native Windows every run takes the gpu lock
                           (IR_RUN_GL_EXCLUSIVE=0 opts out)

  Options (run mode):
    --build-dir <dir>   CMake build directory (must contain the built binary).
                        Default: see "Build directory" below.
    --timeout N | -t N  Run under a watchdog: kill after N whole seconds.
                        Exit 0 if still running at timeout (treat as healthy
                        for smoke tests). Exit 1 if the process died early
                        with non-zero status. `--timeout 0` is the explicit
                        opt-out (exec the binary, no watchdog). Omit for the
                        FLEET_RUN_DEFAULT_TIMEOUT default if set, else exec.
                        N covers the executable's run time only: time queued
                        on an ir-acquire lock is not counted (the lock wait
                        has its own bound, IR_QUEUE_TIMEOUT, default 600 s).

  Env vars:
    FLEET_RUN_DEFAULT_TIMEOUT   Default for --timeout when not passed.
                                Unset or 0 = no watchdog (historic behavior).
                                Set in ~/.fleet/fleet-up.conf or shell init
                                to catch fleet agents that forgot --timeout.
    IR_QUEUE_TIMEOUT            Seconds a wrapped run may wait for its
                                ir-acquire lock (default 600).
    IR_RUN_HOST_CLOSE_*         Test seams for the HOST-CLOSED check (see
                                the comment above ir_host_closed_event).

  Result reporting (self-terminating runs — auto verbs and --timeout):
    ir-run: RESULT=CLEAN exe=<name> exit=0
        The program ran to completion and exited 0, teardown included.
    ir-run: RESULT=CRASH exe=<name> exit=<rc> signal=<SIGNAME|none>
        FAILED run, exit code propagated. Saved outputs (screenshots,
        profiles) do not make a crashed run green — see
        docs/agents/FLEET.md "Clean-exit policy".
    ir-run: RESULT=HOST-CLOSED exe=<name> exit=<rc> event=Application-Hang/1002 at=<time>
        Native Windows only: the host's hang handling closed a Not
        Responding window (Task Manager "End task", the not-responding
        dialog), proven by an Application-log event naming this exact
        process — path, pid, and creation time. Not a demo failure and
        not green: re-run it. Exit code propagated as for CRASH.
    ir-run: RESULT=ALIVE-TIMEOUT exe=<name> ...
        Watchdog killed a still-healthy process at --timeout. Says
        nothing about shutdown-path health (teardown never ran).
    ir-run: RESULT=LOCK-FAILED exe=<name> exit=<rc> ...
        ir-acquire never granted the lock (queue timeout), so the
        program did not run. Exit code propagated as 1.

  Build directory (when not using --build-dir):
    1. $IRREDEN_BUILD_DIR if set
    2. <git-worktree-root>/build from git rev-parse
       (downstream-creation worktrees — creations/<name>/.claude/
       worktrees/<agent>/ — resolve to the dedicated
       <engine>/build-<creation>-<agent>/ tree instead)
    3. $IR_ENGINE_ROOT/build if not in a git worktree

Target listing mode
  ir-run --targets [list-options...]

  Delegates to scripts/fleet/fleet-run-targets (same as running that
  script). Full option reference is printed below.

Compat
  scripts/fleet/fleet-run is a one-line shim that execs ir-run; old
  fleet-run invocations continue to work unchanged.

Other fleet tools (build, tmux fleet, claims, …): fleet-help

USAGE
            WORKTREE_ROOT="$(ir_worktree_root)"
            HELPER="$WORKTREE_ROOT/scripts/fleet/fleet-run-targets"
            if [[ -f "$HELPER" ]]; then
                echo "---------- ir-run --targets (full options) ----------"
                bash "$HELPER" --help
            else
                echo "ir-run: warning: $HELPER not found; target-listing help omitted." >&2
            fi
            exit 0
            ;;
        --) shift; break ;;
        -*) echo "ir-run: unknown option '$1' (try ir-run --help)" >&2; exit 2 ;;
        *) break ;;
    esac
done

if [[ $# -eq 0 ]]; then
    echo "usage: ir-run [--build-dir <dir>] [--timeout <secs>] <executable-name> [args...]" >&2
    echo "       ir-run --targets [--plain | --plan | --built] [--build-dir <dir>]" >&2
    echo "       ir-run --help" >&2
    exit 2
fi

# Apply FLEET_RUN_DEFAULT_TIMEOUT when --timeout was not passed. 0 (or
# unset) means "no watchdog" — preserves the historic behavior of
# `ir-run <exe>` exec'ing the binary in the current shell.
if (( ! TIMEOUT_EXPLICIT )) && [[ -n "${FLEET_RUN_DEFAULT_TIMEOUT:-}" ]]; then
    TIMEOUT="$FLEET_RUN_DEFAULT_TIMEOUT"
fi

if [[ -n "$TIMEOUT" ]]; then
    if ! [[ "$TIMEOUT" =~ ^(0|[1-9][0-9]*)$ ]]; then
        echo "ir-run: timeout must be a non-negative integer (seconds), got '$TIMEOUT'" >&2
        exit 2
    fi
    if [[ "$TIMEOUT" == "0" ]]; then
        TIMEOUT=""
    fi
fi

EXE_NAME="$1"
shift

# Remaining "$@" is the program's args. Detect --auto-screenshot,
# --auto-record, or --auto-profile so we know which ir-acquire verb to
# wrap with.
acquire_verb=""
for arg in "$@"; do
    case "$arg" in
        --auto-screenshot) acquire_verb="gpu" ;;
        --auto-record)     acquire_verb="gpu" ;;
        --auto-profile)    acquire_verb="benchmark" ;;
    esac
done

# Native Windows: the NVIDIA GL driver parks a process inside glLinkProgram
# for minutes while another engine process holds a live GL context on the
# same GPU (two identical demos launched together: one links in 2 s, the
# other waits ~150 s per contended program, its main thread parked on a
# driver worker). Every engine executable therefore takes the gpu lock
# here, exclusive verb or not, so a test suite or a scratch launch never
# overlaps a smoke run; IR_RUN_GL_EXCLUSIVE=0 opts a call out.
if [[ -z "$acquire_verb" && "$IR_IS_WINDOWS" == "1"       && "${IR_RUN_GL_EXCLUSIVE:-1}" == "1" ]]; then
    acquire_verb="gpu"
fi

# Default build dir: invoker's worktree, not the script-source clone.
# Downstream-creation worktrees resolve to the dedicated
# <engine>/build-<creation>-<agent>/ tree ir-build configures for them.
if [[ -z "$BUILD_DIR" ]]; then
    WORKTREE_ROOT="$(ir_worktree_root)"
    BUILD_DIR="${IRREDEN_BUILD_DIR:-$(ir_default_build_dir "$WORKTREE_ROOT")}"
fi

if [[ ! -d "$BUILD_DIR" ]]; then
    echo "ir-run: build directory $BUILD_DIR does not exist." >&2
    echo "        run 'ir-build --target $EXE_NAME' first." >&2
    exit 1
fi

# Find the executable in the build tree.
EXE_PATH=$(find "$BUILD_DIR" -maxdepth 8 -name "$EXE_NAME" -type f -perm -u=x 2>/dev/null | head -1)

# Windows build artifacts carry a `.exe` suffix the caller usually omits.
if [[ -z "$EXE_PATH" && "$IR_IS_WINDOWS" == "1" ]]; then
    EXE_PATH=$(find "$BUILD_DIR" -maxdepth 8 -name "$EXE_NAME.exe" -type f 2>/dev/null | head -1)
fi

if [[ -z "$EXE_PATH" ]]; then
    echo "ir-run: could not find executable '$EXE_NAME' in $BUILD_DIR" >&2
    echo "        build it first: ir-build --target $EXE_NAME" >&2
    exit 1
fi

EXE_DIR=$(dirname "$EXE_PATH")
# Run by the actual on-disk basename so the `.exe` suffix (Windows) is
# preserved; on Linux/macOS this is identical to $EXE_NAME.
EXE_RUN=$(basename "$EXE_PATH")

# Pre-compose the ir-acquire prefix (empty when no exclusive verb).
# Using an array preserves quoting around exe args containing spaces.
# gpu and benchmark are the only verbs ir-run dispatches; both take no
# args other than the wrapped command.
acquire_prefix=()
if [[ -n "$acquire_verb" ]]; then
    acquire_prefix=("$IR_ACQUIRE" "$acquire_verb" "--")
fi

# Decode an exit code into a signal name for the RESULT line (128+N =
# died on signal N; e.g. 139 = SIGSEGV, 134 = SIGABRT). Prints "none"
# for plain non-zero exits.
#
# Upper bound 193: 128+64=192 is the highest signal-death code any host
# emits — standard signals are ≤31 (rc ≤159), Linux realtime signals run
# 34–64 (rc ≤192). rc ≥193 can only be a plain exit status, so it reports
# signal=none rather than mis-decoding a large exit code as a signal.
# kill -l falls back to the raw number when the host can't name N (macOS
# has no realtime signals).
ir_exit_signal_name() {
    local rc="$1"
    if (( rc > 128 && rc < 193 )); then
        local name
        name="$(kill -l $((rc - 128)) 2>/dev/null || true)"
        echo "SIG${name:-$((rc - 128))}"
    else
        echo "none"
    fi
}

ir_lower() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Wall-clock epoch seconds, sub-second where the host can say so.
# EPOCHREALTIME is bash >= 5 and uses the locale's radix character.
ir_epoch_now() {
    if [[ -n "${IR_RUN_HOST_CLOSE_CLOCK:-}" ]]; then
        "$IR_RUN_HOST_CLOSE_CLOCK"
        return
    fi
    local t="${EPOCHREALTIME:-}"
    [[ -n "$t" ]] || t="$(date -u +%s.%N 2>/dev/null || true)"
    t="${t/,/.}"
    [[ "$t" =~ ^[0-9]+(\.[0-9]+)?$ ]] || t="$(date -u +%s)"
    echo "$t"
}

# --- HOST-CLOSED classification -------------------------------------------
# On native Windows, a Not Responding window closed by the host's hang
# handling (Task Manager "End task", the not-responding dialog) exits with a
# status bash cannot tell from a crash (Git Bash and MSYS2 bash both report
# 127). Windows records the closure in the Application log as provider
# "Application Hang", event 1002, whose EventData carries the process id
# (hex), the process creation FILETIME (hex), and the full image path. A
# non-zero exit is HOST-CLOSED only when such an event names this exact
# process instance — path, pid, and creation FILETIME captured while the
# child was alive — and its TimeCreated lies in
# [max(child start, exit - PRE_EXIT_SLACK), exit + POST_EXIT_SLACK]. The pid
# alone is not enough: the lock is released before the query runs, so a
# later launch may reuse it. Anything less (no event, no identity, a failed
# query) stays CRASH.
#
# Measured on the Windows fleet host (Git Bash and MSYS2 bash, post-lock
# launch): the event is written 0.12-0.15 s before the parent observes the
# exit, never after it, and is query-visible within 0.05 s of it. Timeout
# mode's liveness poll observes the exit up to 1 s late. The slacks and query
# budget below are those readings plus margin; the query budget only decides
# how long to look, never which event times are accepted.
IR_HOST_CLOSE_PRE_EXIT_SLACK=3
IR_HOST_CLOSE_POST_EXIT_SLACK=1
IR_HOST_CLOSE_QUERY_BUDGET=3
#
# Test seams (each replaces one live dependency; setting
# IR_RUN_HOST_CLOSE_QUERY also enables the check off Windows):
#   IR_RUN_HOST_CLOSE_QUERY     command run instead of wevtutil with
#                               <attempt> <native-path> <pid> <creation-filetime>
#                               <lo-epoch> <hi-epoch>; prints event XML
#   IR_RUN_HOST_CLOSE_IDENTITY  command run instead of the live lookup with the
#                               launch's MSYS pid; prints
#                               "<native-pid> <creation-filetime>" (decimal)
#   IR_RUN_HOST_CLOSE_CLOCK     command printing epoch seconds for the child's
#                               start and exit stamps
#   IR_RUN_HOST_CLOSE_ATTEMPTS  query attempts (default QUERY_BUDGET + 1)
#   IR_RUN_HOST_CLOSE_INTERVAL  seconds between attempts (default 1)
HOST_CLOSE=0
if [[ "$IR_IS_WINDOWS" == "1" || -n "${IR_RUN_HOST_CLOSE_QUERY:-}" ]]; then
    HOST_CLOSE=1
fi
# Per-launch record written by the launch shim and the identity capturer:
# start, pid, identity, end, done.
LAUNCH_DIR=""
CAPTURE_PID=""

# Stamps the child start (when classifying) and publishes the pid once any
# ir-acquire lock is granted, then execs the exe so the published pid IS the
# exe's. The pid file is written last and atomically, so its presence implies
# the start stamp.
IR_LAUNCH_SHIM="$(declare -f ir_epoch_now)"'
d="$1"; stamp="$2"; shift 2
if [[ "$stamp" == 1 ]]; then ir_epoch_now > "$d/start"; fi
echo "$$" > "$d/pid.tmp" && mv "$d/pid.tmp" "$d/pid"
exec "$@"'

# Runs in the background for the life of the launch: records the native pid
# and creation FILETIME of the exe while it is still alive (after exit the
# mapping is gone). Gives up silently — the verdict then fails closed to
# CRASH — if the exe exits first or any lookup fails.
ir_capture_launch_identity() {
    local d="$1" msys native="" ft="" out
    until [[ -s "$d/pid" ]]; do
        [[ -e "$d/done" ]] && return 0
        sleep 0.1
    done
    msys="$(<"$d/pid")"
    if [[ -n "${IR_RUN_HOST_CLOSE_IDENTITY:-}" ]]; then
        out="$("$IR_RUN_HOST_CLOSE_IDENTITY" "$msys" 2>/dev/null | tr -d '\r')" || return 0
        read -r native ft <<<"$out" || true
    else
        # The shim's MSYS pid names bash.exe until exec has replaced it
        # with the exe; only then does winpid map to the exe.
        local want exe=""
        want="$(ir_lower "$EXE_RUN")"
        while [[ -r "/proc/$msys/winexename" ]]; do
            exe="$(ir_lower "$(tr -d '\0' < "/proc/$msys/winexename" 2>/dev/null || true)")"
            [[ "${exe##*\\}" == "$want" ]] && break
            [[ -e "$d/done" ]] && return 0
            sleep 0.1
        done
        [[ "${exe##*\\}" == "$want" ]] || return 0
        native="$(<"/proc/$msys/winpid")" 2>/dev/null || return 0
        [[ "$native" =~ ^[0-9]+$ ]] || return 0
        ft="$(timeout 30 powershell.exe -NoProfile -NonInteractive -Command \
            "(Get-Process -Id $native).StartTime.ToFileTimeUtc()" 2>/dev/null \
            | tr -d '\r')" || return 0
    fi
    [[ "$native" =~ ^[0-9]+$ && "$ft" =~ ^[0-9]+$ ]] || return 0
    echo "$native $ft" > "$d/identity.tmp" && mv "$d/identity.tmp" "$d/identity"
}

# Creates the per-launch record and starts the identity capturer. Sets
# LAUNCH_DIR; a no-op unless the HOST-CLOSED check is enabled.
ir_launch_begin() {
    (( HOST_CLOSE )) || return 0
    LAUNCH_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ir-run-launch.XXXXXX")"
    ir_capture_launch_identity "$LAUNCH_DIR" &
    CAPTURE_PID=$!
}

# Records the observed exit and lets the capturer finish (it returns at once
# when the exe is already gone).
ir_launch_end() {
    [[ -n "$LAUNCH_DIR" ]] || return 0
    ir_epoch_now > "$LAUNCH_DIR/end" 2>/dev/null || true
    : > "$LAUNCH_DIR/done"
    if [[ -n "$CAPTURE_PID" ]]; then
        wait "$CAPTURE_PID" 2>/dev/null || true
        CAPTURE_PID=""
    fi
}

ir_launch_cleanup() {
    if [[ -n "$CAPTURE_PID" ]]; then
        kill "$CAPTURE_PID" 2>/dev/null || true
    fi
    if [[ -n "$LAUNCH_DIR" ]]; then
        rm -rf "$LAUNCH_DIR"
    fi
}
trap ir_launch_cleanup EXIT

# Newest Application Hang/1002 events as XML, one per line. Never fails:
# a missing wevtutil or a query error yields no candidates. Git Bash rewrites
# the /q: and /f: switches as paths unless told not to, and wevtutil emits
# CRLF.
ir_host_close_query() {
    if [[ -n "${IR_RUN_HOST_CLOSE_QUERY:-}" ]]; then
        "$IR_RUN_HOST_CLOSE_QUERY" "$@" 2>/dev/null | tr -d '\r' || true
        return 0
    fi
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' wevtutil qe Application /c:32 /rd:true /f:xml \
        "/q:*[System[Provider[@Name='Application Hang'] and (EventID=1002)]]" \
        2>/dev/null | tr -d '\r' || true
}

# Reads event XML on stdin; prints the TimeCreated of the first event that
# names this process instance inside [lo, hi], else nothing. Pid and FILETIME
# compare as hex strings: a FILETIME exceeds awk's exact-integer range. The
# path travels through the environment because `awk -v` would read the
# backslashes of a Windows path as escape sequences.
ir_host_close_match() {
    IR_HC_WANT_PATH="$1" awk -v want_pid="$2" -v want_ft="$3" -v lo="$4" -v hi="$5" '
        BEGIN { want_path = ENVIRON["IR_HC_WANT_PATH"] }
        function strip0(s) { s = tolower(s); sub(/^0+/, "", s); return s == "" ? "0" : s }
        function unxml(s) {
            gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&quot;/, "\"", s)
            gsub(/&apos;/, "\047", s); gsub(/&amp;/, "\\&", s); return s
        }
        function days_from_civil(y, m, d,   era, yoe, doy, doe) {
            y -= (m <= 2); era = int(y / 400); yoe = y - era * 400
            doy = int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
            doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
            return era * 146097 + doe - 719468
        }
        function iso_epoch(s,   f) {
            if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/) return -1
            f = substr(s, 20); sub(/Z$/, "", f)
            return days_from_civil(substr(s, 1, 4) + 0, substr(s, 6, 2) + 0, substr(s, 9, 2) + 0) * 86400 \
                + substr(s, 12, 2) * 3600 + substr(s, 15, 2) * 60 + substr(s, 18, 2) + (f ~ /^\.[0-9]+$/ ? f + 0 : 0)
        }
        function check(ev,   t, n, i, j, rest, data, st, when) {
            if (ev !~ /Provider Name=.Application Hang./) return
            if (ev !~ /<EventID[^>]*>1002<\/EventID>/) return
            if (!match(ev, /SystemTime=.[^\047"]+/)) return
            st = substr(ev, RSTART + 12, RLENGTH - 12)
            i = index(ev, "<EventData>"); if (!i) return
            rest = substr(ev, i + 11); n = 0
            while ((i = index(rest, "<Data")) > 0) {
                rest = substr(rest, i + 5)
                j = index(rest, ">"); if (!j) return
                if (substr(rest, j - 1, 1) == "/") { data[++n] = ""; rest = substr(rest, j + 1); continue }
                rest = substr(rest, j + 1)
                j = index(rest, "</Data>"); if (!j) return
                data[++n] = substr(rest, 1, j - 1); rest = substr(rest, j + 7)
            }
            if (n < 6) return
            if (tolower(unxml(data[6])) != tolower(want_path)) return
            if (strip0(data[3]) != strip0(want_pid)) return
            if (strip0(data[4]) != strip0(want_ft)) return
            when = iso_epoch(st)
            if (when < lo || when > hi) return
            print st; found = 1; exit
        }
        { buf = buf $0 }
        END {
            if (found) exit
            while ((k = index(buf, "</Event>")) > 0) {
                check(substr(buf, 1, k - 1)); if (found) exit
                buf = substr(buf, k + 8)
            }
        }'
}

# Prints the TimeCreated of the Application Hang/1002 event that proves the
# host closed this launch, or nothing. Never fails.
ir_host_closed_event() {
    (( HOST_CLOSE )) || return 0
    local d="$LAUNCH_DIR"
    [[ -n "$d" && -s "$d/start" && -s "$d/end" && -s "$d/identity" ]] || return 0
    local start end native ft path lo hi attempts interval attempt at
    start="$(<"$d/start")"; end="$(<"$d/end")"
    read -r native ft < "$d/identity" || return 0
    [[ "$start" =~ ^[0-9]+(\.[0-9]+)?$ && "$end" =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
    # Every launch path runs from the exe's directory, so PWD is absolute
    # where EXE_DIR (from a relative --build-dir) may not be.
    path="$(cygpath -w "$PWD/$EXE_RUN" 2>/dev/null || echo "$PWD/$EXE_RUN")"
    lo="$(awk -v s="$start" -v e="$end" -v p="$IR_HOST_CLOSE_PRE_EXIT_SLACK" \
        'BEGIN { b = e - p; printf "%.6f", (s > b ? s : b) }')"
    hi="$(awk -v e="$end" -v p="$IR_HOST_CLOSE_POST_EXIT_SLACK" 'BEGIN { printf "%.6f", e + p }')"
    attempts="${IR_RUN_HOST_CLOSE_ATTEMPTS:-$((IR_HOST_CLOSE_QUERY_BUDGET + 1))}"
    interval="${IR_RUN_HOST_CLOSE_INTERVAL:-1}"
    for (( attempt = 1; attempt <= attempts; attempt++ )); do
        at="$(ir_host_close_query "$attempt" "$path" "$native" "$ft" "$lo" "$hi" \
            | ir_host_close_match "$path" "$(printf '%x' "$native")" "$(printf '%x' "$ft")" "$lo" "$hi")" || at=""
        if [[ -n "$at" ]]; then
            echo "$at"
            return 0
        fi
        (( attempt < attempts )) && sleep "$interval"
    done
    return 0
}

# One-line, machine-greppable verdict + the clean-exit directive. Every
# self-terminating run (auto-screenshot, auto-profile, timeout mode)
# reports through this so harnesses and agents key off a single stable
# token instead of re-deriving "did it really pass" from log prose.
# Policy: docs/agents/FLEET.md §"Clean-exit policy" — a signal exit is a
# FAILED run even when outputs (screenshots, profiles) were saved before
# the crash, teardown included. HOST-CLOSED is neither a pass nor a demo
# failure; it asks for a re-run.
ir_report_result() {
    local rc="$1"
    if [[ $rc -eq 0 ]]; then
        echo "ir-run: RESULT=CLEAN exe=$EXE_NAME exit=0"
        return
    fi
    local at
    at="$(ir_host_closed_event)"
    if [[ -n "$at" ]]; then
        echo "ir-run: RESULT=HOST-CLOSED exe=$EXE_NAME exit=$rc event=Application-Hang/1002 at=$at" >&2
        echo "ir-run: Windows hang handling closed this Not Responding window" \
             "— host interference, not a demo failure and not a green run." \
             "Re-run it (docs/agents/FLEET.md §\"Clean-exit policy\")." >&2
        return
    fi
    local sig
    sig="$(ir_exit_signal_name "$rc")"
    echo "ir-run: RESULT=CRASH exe=$EXE_NAME exit=$rc signal=$sig" >&2
    echo "ir-run: this run FAILED the clean-exit policy — outputs saved" \
         "before the crash do not make it green. Fix the crash before" \
         "shipping, whoever introduced it (docs/agents/FLEET.md" \
         "§\"Clean-exit policy\")." >&2
}

# --- No timeout: interactive mode, exec replaces this process --------------
# Exception: `--auto-screenshot` / `--auto-record` / `--auto-profile` are
# self-terminating verbs. The program is expected to close its window and
# exit 0 after its last shot / clip / profile dump — any non-zero return is a crash (teardown
# crashes included). Swap exec for a run-and-validate path for those verbs
# so the verdict is surfaced and the exit code propagates. Interactive
# mode (no verb, no timeout) keeps the exec path so signals and stdin
# pass straight through to the human-supervised process.
if [[ -z "$TIMEOUT" ]]; then
    if [[ -n "$acquire_verb" ]]; then
        echo "ir-run: ${acquire_prefix[*]} $EXE_PATH $*"
        cd "$EXE_DIR"
        launch=("./$EXE_RUN" "$@")
        ir_launch_begin
        if [[ -n "$LAUNCH_DIR" ]]; then
            launch=(bash -c "$IR_LAUNCH_SHIM" ir-run-launch "$LAUNCH_DIR" 1 "./$EXE_RUN" "$@")
        fi
        # Disarm `set -e` around the run so we can inspect the exit code
        # ourselves rather than letting bash bail out on the first non-
        # zero (which is exactly the signal we want to surface).
        set +e
        "${acquire_prefix[@]}" "${launch[@]}"
        rc=$?
        set -e
        ir_launch_end
        ir_report_result "$rc"
        exit "$rc"
    fi
    echo "ir-run: $EXE_PATH $*"
    cd "$EXE_DIR"
    exec "./$EXE_RUN" "$@"
fi

# --- Timeout mode: launch, wait, kill, report ------------------------------
if (( ${#acquire_prefix[@]} > 0 )); then
    echo "ir-run: ${acquire_prefix[*]} $EXE_PATH $* (timeout: ${TIMEOUT}s)"
else
    echo "ir-run: $EXE_PATH $* (timeout: ${TIMEOUT}s)"
fi
cd "$EXE_DIR"

# The watchdog budget is the executable's run time, not the time queued on
# the resource lock. A wrapped run launches the exe through the launch shim,
# whose pid file (READY_FILE) appears once ir-acquire has granted the lock.
# The loop below holds the clock until that file appears.
READY_FILE=""
ir_launch_begin
if (( ${#acquire_prefix[@]} > 0 )); then
    [[ -n "$LAUNCH_DIR" ]] || LAUNCH_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ir-run-launch.XXXXXX")"
    READY_FILE="$LAUNCH_DIR/pid"
    "${acquire_prefix[@]}" bash -c "$IR_LAUNCH_SHIM" \
        ir-run-launch "$LAUNCH_DIR" "$HOST_CLOSE" "./$EXE_RUN" "$@" &
elif [[ -n "$LAUNCH_DIR" ]]; then
    bash -c "$IR_LAUNCH_SHIM" ir-run-launch "$LAUNCH_DIR" 1 "./$EXE_RUN" "$@" &
else
    "./$EXE_RUN" "$@" &
fi
PID=$!

# Wait for either the timeout or the process to exit early (crash).
elapsed=0
while true; do
    if ! kill -0 "$PID" 2>/dev/null; then
        # Process exited before timeout — check if it crashed.
        exit_code=0
        wait "$PID" 2>/dev/null || exit_code=$?
        ir_launch_end
        if [[ -n "$READY_FILE" && ! -s "$READY_FILE" ]]; then
            # ir-acquire gave up on the lock; the exe never started.
            echo "ir-run: RESULT=LOCK-FAILED exe=$EXE_NAME exit=$exit_code" \
                 "— ir-acquire ${acquire_verb} did not grant its lock" \
                 "(see its message above); the exe never ran" >&2
            exit 1
        fi
        if [[ $exit_code -eq 0 ]]; then
            echo "ir-run: $EXE_NAME exited cleanly after ${elapsed}s"
        else
            echo "ir-run: $EXE_NAME crashed after ${elapsed}s"
        fi
        ir_report_result "$exit_code"
        [[ $exit_code -eq 0 ]] && exit 0 || exit 1
    fi
    if [[ -n "$READY_FILE" && ! -s "$READY_FILE" ]]; then
        sleep 0.2   # still queued on the lock: the run clock has not started
        continue
    fi
    (( elapsed >= TIMEOUT )) && break
    sleep 1
    elapsed=$((elapsed + 1))
done

# Process survived the timeout — it's healthy for smoke purposes. Kill it.
# Kill the exe itself when wrapped: TERM to ir-acquire alone is deferred by
# bash until its foreground child exits, which would leave the run going.
# RESULT=ALIVE-TIMEOUT is deliberately distinct from CLEAN: the run never
# reached teardown, so it says nothing about shutdown-path health.
KILL_PID="$PID"
[[ -n "$READY_FILE" ]] && KILL_PID="$(<"$READY_FILE")"
kill "$KILL_PID" 2>/dev/null
wait "$PID" 2>/dev/null || true
echo "ir-run: RESULT=ALIVE-TIMEOUT exe=$EXE_NAME — ran for ${TIMEOUT}s without crashing, killed by watchdog"
exit 0
