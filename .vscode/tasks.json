{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "irTarget",
      "type": "promptString",
      "description": "CMake target / runnable name (fleet-run --targets lists them)",
      "default": "IRMidiPolyrhythm"
    },
    {
      "id": "irRunArgs",
      "type": "promptString",
      "description": "Extra run flags (e.g. --midi-out \"Microsoft GS\", --auto-screenshot 10, --no-hud --record-seconds 120 --take t1)",
      "default": ""
    }
  ],
  "tasks": [
    {
      "label": "fleet-build <target>",
      "detail": "ir-build: CPU-budgeted cmake --build into this worktree's build/ (MSYS2 PATH fix included)",
      "type": "process",
      "command": "bash",
      "windows": {
        "command": "C:\\Program Files\\Git\\bin\\bash.exe"
      },
      "args": [
        "-lc",
        "fleet-build --target ${input:irTarget}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "fleet-run <target>",
      "detail": "ir-run: launches from the exe's own dir, holds the host gpu lock, prints RESULT=",
      "type": "process",
      "command": "bash",
      "windows": {
        "command": "C:\\Program Files\\Git\\bin\\bash.exe"
      },
      "args": [
        "-lc",
        "fleet-run ${input:irTarget} ${input:irRunArgs}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "fleet-build + fleet-run <target>",
      "detail": "Build the target, then run it (Lua-only edits still go through this: the *Assets step re-syncs scripts/)",
      "type": "process",
      "command": "bash",
      "windows": {
        "command": "C:\\Program Files\\Git\\bin\\bash.exe"
      },
      "args": [
        "-lc",
        "fleet-build --target ${input:irTarget} && fleet-run ${input:irTarget} ${input:irRunArgs}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "fleet-run --targets",
      "detail": "List every runnable / buildable target in this tree",
      "type": "process",
      "command": "bash",
      "windows": {
        "command": "C:\\Program Files\\Git\\bin\\bash.exe"
      },
      "args": [
        "-lc",
        "fleet-run --targets --all --plan"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Configure IRGame (from root)",
      "type": "shell",
      "command": "cmake",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "args": [
          "--preset",
          "macos-debug"
        ]
      },
      "windows": {
        "args": [
          "--preset",
          "windows-debug"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Build IRGame (from root)",
      "type": "shell",
      "command": "cmake",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "args": [
          "--build",
          "build",
          "--target",
          "IRGame"
        ]
      },
      "windows": {
        "args": [
          "--build",
          "build",
          "--target",
          "IRGame"
        ]
      },
      "dependsOn": [
        "Configure IRGame (from root)"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run IRGame (from root)",
      "type": "shell",
      "command": "cmake",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "args": [
          "--build",
          "build",
          "--target",
          "IRGameRun"
        ]
      },
      "windows": {
        "args": [
          "--build",
          "build",
          "--target",
          "IRGameRun"
        ]
      },
      "dependsOn": [
        "Configure IRGame (from root)"
      ],
      "problemMatcher": []
    }
  ]
}
